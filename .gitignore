# sibling repos (separate git repos: haiku fork, buildtools fork)
/sources/
# read-only reference clones (FreeBSD, raspberrypi/userland: docs/design/vchiq.md)
/external/
# build outputs, images, captures
/artifacts/
/generated/
*.log
*.image
*.img
*.efi
# this machine's settings (local.conf.example)
/local.conf
# haikuports-fetch.sh puts the sources of the recipes in tools/recipes/ here
/tools/recipes/**/download/
