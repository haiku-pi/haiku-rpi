SUMMARY="Libs for the efficient manipulation of volumetric data"
DESCRIPTION="The OpenVDB library comprises a hierarchical data structure and \
a suite of tools for the efficient manipulation of sparse, possibly \
time-varying, volumetric data discretized on a three-dimensional grid. \
NanoVDB, its compact read-only form for rendering, is header-only and \
comes with the development package."
HOMEPAGE="https://www.openvdb.org/"
COPYRIGHT="2012-2023 Contributors to the OpenVDB Project"
LICENSE="MPL v2.0"
REVISION="1"
SOURCE_URI="https://github.com/AcademySoftwareFoundation/openvdb/archive/v$portVersion.tar.gz"
CHECKSUM_SHA256="2746236e29659a0d35ab90d832f7c7987dd2537587a1a2f9237d9c98afcd5817"
SOURCE_FILENAME="openvdb-$portVersion.tar.gz"
SOURCE_DIR="openvdb-$portVersion"

ARCHITECTURES="arm64"

# Cross-built by scripts/build-blender.sh (haiku-pi) for Blender 3.6 (voxel remesh, .vdb import,
# volume nodes, Cycles volumes through NanoVDB, the OpenVDB fluid cache). Blender 3.6 pins 10.0.0;
# 10.1.0 is the newest release of the same ABI 10 (HaikuPorts has 7.1 and 13.0). Against oneTBB 2022,
# Boost 1.83 (iostreams for delayed loading), c-blosc 1.21 and zlib; OpenVDB's own half type (no
# Imath), no Python module, vdb_print only.
PROVIDES="
	openvdb = $portVersion
	lib:libopenvdb = $portVersion compat >= 10.1
	cmd:vdb_print
	"
REQUIRES="
	haiku
	lib:libblosc
	lib:libboost_iostreams
	lib:libtbb
	lib:libz
	"

PROVIDES_devel="
	openvdb_devel = $portVersion
	devel:libopenvdb = $portVersion compat >= 10.1
	"
REQUIRES_devel="
	openvdb == $portVersion base
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libblosc
	devel:libboost_iostreams
	devel:libtbb
	devel:libz
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:g++
	cmd:make
	"

BUILD()
{
	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release \
		$cmakeDirArgs \
		-DOPENVDB_BUILD_PYTHON_MODULE=OFF \
		-DOPENVDB_CORE_STATIC=OFF \
		-DUSE_BLOSC=ON -DUSE_ZLIB=ON -DUSE_IMATH_HALF=OFF -DUSE_NANOVDB=ON \
		-DOPENVDB_ENABLE_RPATH=OFF \
		-Wno-dev
	make -C build $jobArgs
}

INSTALL()
{
	make -C build install
	prepareInstalledDevelLib libopenvdb
	packageEntries devel \
		$developDir \
		$libDir/cmake
}
