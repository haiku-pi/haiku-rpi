From 82ba1a6fc2a865459528d830902db60312e638c5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 10:23:23 +0100
Subject: [PATCH 1/8] vcos: initialise the pthread_once_t controls with
 VCOS_ONCE_INIT

current_thread_key_once and cmd_globals.initialized relied on a zeroed
pthread_once_t being PTHREAD_ONCE_INIT, which is true for glibc only.
On Haiku PTHREAD_ONCE_INIT is { -1 }: the thread key was never created
and vcos_init() aborted.
---
 interface/vcos/generic/vcos_cmd.c       | 2 +-
 interface/vcos/pthreads/vcos_pthreads.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/interface/vcos/generic/vcos_cmd.c b/interface/vcos/generic/vcos_cmd.c
index 953923a..f054a5d 100644
--- a/interface/vcos/generic/vcos_cmd.c
+++ b/interface/vcos/generic/vcos_cmd.c
@@ -63,7 +63,7 @@ static struct VCOS_CMD_GLOBALS_T
     VCOS_CMD_T     *cmd_entry;
 
     VCOS_LOG_CAT_T *log_category;
-} cmd_globals;
+} cmd_globals = { .initialized = VCOS_ONCE_INIT };
 
 #ifdef HAVE_VCOS_VERSION
 /* Keep the static strings in the image from being dropped by
diff --git a/interface/vcos/pthreads/vcos_pthreads.c b/interface/vcos/pthreads/vcos_pthreads.c
index 77ce58c..02030e7 100644
--- a/interface/vcos/pthreads/vcos_pthreads.c
+++ b/interface/vcos/pthreads/vcos_pthreads.c
@@ -81,7 +81,7 @@ static VCOS_MUTEX_T printf_lock;
 pthread_key_t _vcos_thread_current_key;
 
 static VCOS_UNSIGNED _vcos_thread_current_key_created = 0;
-static VCOS_ONCE_T current_thread_key_once;  /* init just once */
+static VCOS_ONCE_T current_thread_key_once = VCOS_ONCE_INIT;  /* init just once */
 
 static void vcos_thread_cleanup(VCOS_THREAD_T *thread)
 {
-- 
2.53.0


From fa5e55c1f7c763c9efa09ee605eefbc5b9d58851 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 10:23:23 +0100
Subject: [PATCH 2/8] vchiq_arm: don't shadow the global vchiq_lib_mutex

vchiq_lib_init() created a function-local static vchiq_lib_mutex, so the
file-scope one that vchiq_close_service(), alloc_msgbuf() etc. lock was
never created. A zeroed pthread_mutex_t happens to be a valid unlocked
mutex with glibc; Haiku's libroot asserts on it.
---
 interface/vchiq_arm/vchiq_lib.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/interface/vchiq_arm/vchiq_lib.c b/interface/vchiq_arm/vchiq_lib.c
index 133d5ca..40adab9 100755
--- a/interface/vchiq_arm/vchiq_lib.c
+++ b/interface/vchiq_arm/vchiq_lib.c
@@ -1420,7 +1420,6 @@ static VCHIQ_INSTANCE_T
 vchiq_lib_init(const int dev_vchiq_fd)
 {
    static int mutex_initialised = 0;
-   static VCOS_MUTEX_T vchiq_lib_mutex;
    VCHIQ_INSTANCE_T instance = &vchiq_instance;
 
    vcos_global_lock();
-- 
2.53.0


From fc0d32cb61c7e089f9014c3278e7ed04ec03bf0b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 10:23:32 +0100
Subject: [PATCH 3/8] Haiku support for VCOS, libvchiq and the MMAL VideoCore
 client

- the ioctl numbers from <sys/ioccom.h> (Haiku's /dev/vchiq uses the BSD
  encoding), HZ from <sys/param.h>;
- VCOS threads get their names with rename_thread();
- the component-create message carries the pid, as on Linux.
---
 interface/mmal/vc/mmal_vc_api.c         |  2 +-
 interface/vchiq_arm/vchiq_ioctl.h       |  5 +++++
 interface/vcos/pthreads/vcos_pthreads.c | 10 ++++++++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/interface/mmal/vc/mmal_vc_api.c b/interface/mmal/vc/mmal_vc_api.c
index 4c74bda..d171152 100644
--- a/interface/mmal/vc/mmal_vc_api.c
+++ b/interface/mmal/vc/mmal_vc_api.c
@@ -1331,7 +1331,7 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
    msg.client_component = component;
    /* coverity[secure_coding] Length tested above */
    strcpy(msg.name, basename);
-#ifdef __linux__
+#if defined(__linux__) || defined(__HAIKU__)
    msg.pid = getpid();
 #endif
 
diff --git a/interface/vchiq_arm/vchiq_ioctl.h b/interface/vchiq_arm/vchiq_ioctl.h
index dab4a8b..281d657 100755
--- a/interface/vchiq_arm/vchiq_ioctl.h
+++ b/interface/vchiq_arm/vchiq_ioctl.h
@@ -28,7 +28,12 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #ifndef VCHIQ_IOCTLS_H
 #define VCHIQ_IOCTLS_H
 
+#ifdef __HAIKU__
+/* Haiku's VCHIQ driver uses the BSD encoding of the ioctl numbers (as FreeBSD's) */
+#include <sys/ioccom.h>
+#else
 #include <linux/ioctl.h>
+#endif
 #include "vchiq_if.h"
 
 #define VCHIQ_IOC_MAGIC 0xc4
diff --git a/interface/vcos/pthreads/vcos_pthreads.c b/interface/vcos/pthreads/vcos_pthreads.c
index 02030e7..e664c95 100644
--- a/interface/vcos/pthreads/vcos_pthreads.c
+++ b/interface/vcos/pthreads/vcos_pthreads.c
@@ -33,7 +33,15 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #include <stdlib.h>
 #include <stdio.h>
 #include <sys/time.h>
+#ifdef __HAIKU__
+#include <OS.h>
+#include <sys/param.h>
+#ifndef HZ
+#define HZ 100
+#endif
+#else
 #include <linux/param.h>
+#endif
 
 /* Cygwin doesn't always have prctl.h and it doesn't have PR_SET_NAME */
 #if defined( __linux__ )
@@ -132,6 +140,8 @@ static void *vcos_thread_entry(void *arg)
 #if defined( HAVE_PRCTL ) && defined( PR_SET_NAME )
    /* cygwin doesn't have PR_SET_NAME */
    prctl( PR_SET_NAME, (unsigned long)thread->name, 0, 0, 0 );
+#elif defined( __HAIKU__ )
+   rename_thread( find_thread(NULL), thread->name );
 #endif
    if (thread->legacy)
    {
-- 
2.53.0


From 9538a4dacab170189bc5d5473b922c7f72733f32 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 10:34:46 +0100
Subject: [PATCH 4/8] vchiq_arm: 64-bit clean

vchiq_dump_phys_mem() took the service handle for a pointer, which it is
not (find_service_by_handle() maps it, as everywhere else); the trace
messages printed pointers truncated to 32 bits.
---
 interface/vchiq_arm/vchiq_lib.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/interface/vchiq_arm/vchiq_lib.c b/interface/vchiq_arm/vchiq_lib.c
index 40adab9..098667f 100755
--- a/interface/vchiq_arm/vchiq_lib.c
+++ b/interface/vchiq_arm/vchiq_lib.c
@@ -398,7 +398,7 @@ void
 vchiq_release_message(VCHIQ_SERVICE_HANDLE_T handle,
    VCHIQ_HEADER_T *header)
 {
-   vcos_log_trace( "%s handle=%08x, header=%x", __func__, (uint32_t)handle, (uint32_t)header );
+   vcos_log_trace( "%s handle=%08x, header=%p", __func__, (uint32_t)handle, header );
 
    free_msgbuf(header);
 }
@@ -1396,7 +1396,7 @@ VCHIQ_STATUS_T vchiq_dump_phys_mem( VCHIQ_SERVICE_HANDLE_T handle,
                              void *ptr,
                              size_t num_bytes )
 {
-   VCHIQ_SERVICE_T *service = (VCHIQ_SERVICE_T *)handle;
+   VCHIQ_SERVICE_T *service = find_service_by_handle(handle);
    VCHIQ_DUMP_MEM_T  dump_mem;
    int ret;
 
@@ -1547,9 +1547,9 @@ completion_thread(void *arg)
          VCHIQ_SERVICE_T *service = (VCHIQ_SERVICE_T *)completion->service_userdata;
          if (service->base.callback)
          {
-            vcos_log_trace( "callback(%x, %x, %x(%x,%x), %x)",
-               completion->reason, (uint32_t)completion->header,
-               (uint32_t)&service->base, (uint32_t)service->lib_handle, (uint32_t)service->base.userdata, (uint32_t)completion->bulk_userdata );
+            vcos_log_trace( "callback(%x, %p, %p(%x,%p), %p)",
+               completion->reason, completion->header,
+               &service->base, (uint32_t)service->lib_handle, service->base.userdata, completion->bulk_userdata );
             service->base.callback(completion->reason, completion->header,
                service->lib_handle, completion->bulk_userdata);
          }
-- 
2.53.0


From 60ddfe3847fe6ad132b6b8b5353b97caa8e8daf8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 10:29:45 +0100
Subject: [PATCH 5/8] mmal: the VideoCore's message layout on 64-bit hosts

The MMAL service on the VideoCore parses its messages with the layout they
have on a 32-bit ARM host, which is why the CMake build leaves MMAL out on
ARM64. Give the messages that layout on every host:

- where a message had a pointer to a host object that the VideoCore passes
  back (the waiter of a reply, the client component of an event, the context
  of a buffer, the buffer of a delayed event), it has a 32-bit handle:
  mmal_vc_handle_alloc()/_get()/_free() map handles to objects, a waiter's
  handle is its index in the wait pool;
- where a message embedded an MMAL structure with pointers (MMAL_PORT_T,
  MMAL_ES_FORMAT_T, MMAL_BUFFER_HEADER_T, the buffer's driver data), it has
  an mmal_worker_* copy with 32-bit fields in their place; the VideoCore does
  not use those fields;
- a format-changed event arrives in the VideoCore's layout and is converted
  to MMAL_EVENT_FORMAT_CHANGED_T + MMAL_ES_FORMAT_T, which are larger on a
  64-bit host (the event buffers get room for that);
- MMAL_VC_COMP_STATS_T.comp, a VideoCore address, is a uint32_t.

Static assertions pin the sizes; on a 32-bit host the messages are as
before. When the allocation of the component's module fails, the destroy message
sent to the VideoCore now names the component (it was uninitialised).
---
 interface/mmal/vc/mmal_vc_api.c         |  70 ++++---
 interface/mmal/vc/mmal_vc_api.h         |   2 +-
 interface/mmal/vc/mmal_vc_client.c      | 243 ++++++++++++++++++++----
 interface/mmal/vc/mmal_vc_client_priv.h |   7 +
 interface/mmal/vc/mmal_vc_diag.c        |   2 +-
 interface/mmal/vc/mmal_vc_msgs.h        | 164 ++++++++++++++--
 6 files changed, 410 insertions(+), 78 deletions(-)

diff --git a/interface/mmal/vc/mmal_vc_api.c b/interface/mmal/vc/mmal_vc_api.c
index d171152..03080e3 100644
--- a/interface/mmal/vc/mmal_vc_api.c
+++ b/interface/mmal/vc/mmal_vc_api.c
@@ -77,6 +77,7 @@ typedef struct MMAL_PORT_MODULE_T
 typedef struct MMAL_COMPONENT_MODULE_T
 {
    uint32_t component_handle;
+   uint32_t client_handle;         /**< Our handle for the component, in the VideoCore's messages */
 
    MMAL_PORT_MODULE_T **ports;
    uint32_t ports_num;
@@ -148,7 +149,7 @@ static MMAL_STATUS_T mmal_vc_port_requirements_set(MMAL_PORT_T *port)
    msg.component_handle = module->component_handle;
    msg.action = MMAL_WORKER_PORT_ACTION_SET_REQUIREMENTS;
    msg.port_handle = module->port_handle;
-   msg.param.enable.port = *port;
+   mmal_vc_port_to_msg(&msg.param.enable.port, port);
 
    status = mmal_vc_sendwait_message(mmal_vc_get_client(), &msg.header, sizeof(msg),
                                      MMAL_WORKER_PORT_ACTION, &reply, &replylen, MMAL_FALSE);
@@ -255,7 +256,7 @@ static MMAL_STATUS_T mmal_vc_port_enable(MMAL_PORT_T *port, MMAL_PORT_BH_CB_T cb
    msg.component_handle = module->component_handle;
    msg.action = MMAL_WORKER_PORT_ACTION_ENABLE;
    msg.port_handle = module->port_handle;
-   msg.param.enable.port = *port;
+   mmal_vc_port_to_msg(&msg.param.enable.port, port);
 
    status = mmal_vc_sendwait_message(mmal_vc_get_client(), &msg.header, sizeof(msg),
                                      MMAL_WORKER_PORT_ACTION, &reply, &replylen, MMAL_FALSE);
@@ -368,7 +369,9 @@ static MMAL_STATUS_T mmal_vc_port_flush_sync(MMAL_PORT_T *port)
    client_context.magic = MMAL_MAGIC;
    client_context.port = port;
 
-   msg->drvbuf.client_context = &client_context;
+   msg->drvbuf.client_context = mmal_vc_handle_alloc(&client_context);
+   if (!msg->drvbuf.client_context)
+      return MMAL_ENOSPC;
    msg->drvbuf.component_handle = module->component_handle;
    msg->drvbuf.port_handle = module->port_handle;
    msg->drvbuf.magic = MMAL_MAGIC;
@@ -376,6 +379,7 @@ static MMAL_STATUS_T mmal_vc_port_flush_sync(MMAL_PORT_T *port)
 
    status = mmal_vc_sendwait_message(mmal_vc_get_client(), &msg->header, sizeof(*msg),
                                      MMAL_WORKER_PORT_FLUSH, &reply, &replylen, MMAL_TRUE);
+   mmal_vc_handle_free(msg->drvbuf.client_context);
    if (status == MMAL_SUCCESS)
    {
       vcos_assert(replylen == sizeof(reply));
@@ -528,14 +532,15 @@ static void mmal_vc_port_send_callback(mmal_worker_buffer_from_host *msg)
 {
    MMAL_BUFFER_HEADER_T *buffer;
    MMAL_PORT_T *port;
-   MMAL_VC_CLIENT_BUFFER_CONTEXT_T *client_context = msg->drvbuf.client_context;
+   MMAL_VC_CLIENT_BUFFER_CONTEXT_T *client_context = mmal_vc_handle_get(msg->drvbuf.client_context);
 
    vcos_assert(client_context);
    vcos_assert(client_context->magic == MMAL_MAGIC);
 
    buffer = client_context->buffer;
    port = client_context->port;
-   vcos_blockpool_free(msg->drvbuf.client_context);
+   mmal_vc_handle_free(msg->drvbuf.client_context);
+   vcos_blockpool_free(client_context);
 
    vcos_assert(port->priv->module->magic == MMAL_MAGIC);
    mmal_vc_msg_to_buffer_header(buffer, msg);
@@ -614,7 +619,12 @@ static MMAL_STATUS_T mmal_vc_port_send(MMAL_PORT_T *port, MMAL_BUFFER_HEADER_T *
    client_context->callback_event = NULL;
    client_context->port = port;
 
-   msg->drvbuf.client_context = client_context;
+   msg->drvbuf.client_context = mmal_vc_handle_alloc(client_context);
+   if (!msg->drvbuf.client_context)
+   {
+      vcos_blockpool_free(client_context);
+      return MMAL_ENOSPC;
+   }
    msg->drvbuf.component_handle = module->component_handle;
    msg->drvbuf.port_handle = module->port_handle;
    msg->drvbuf.magic = MMAL_MAGIC;
@@ -693,7 +703,8 @@ static MMAL_STATUS_T mmal_vc_port_send(MMAL_PORT_T *port, MMAL_BUFFER_HEADER_T *
    if (status != MMAL_SUCCESS)
    {
       LOG_INFO("failed %d", status);
-      vcos_blockpool_free(msg->drvbuf.client_context);
+      mmal_vc_handle_free(msg->drvbuf.client_context);
+      vcos_blockpool_free(client_context);
       buffer->data = mmal_vc_shm_lock(buffer->data, port->priv->module->zero_copy_workaround);
    }
 
@@ -796,6 +807,7 @@ static MMAL_STATUS_T mmal_vc_component_destroy(MMAL_COMPONENT_T *component)
 
    mmal_queue_destroy(component->priv->module->callback_queue);
 
+   mmal_vc_handle_free(component->priv->module->client_handle);
    vcos_free(component->priv->module);
    component->priv->module = NULL;
 
@@ -969,9 +981,7 @@ static MMAL_STATUS_T mmal_vc_port_info_get(MMAL_PORT_T *port)
    port->buffer_alignment_min = reply.port.buffer_alignment_min;
    port->is_enabled = reply.port.is_enabled;
    port->capabilities = reply.port.capabilities;
-   reply.format.extradata = port->format->extradata;
-   reply.format.es = port->format->es;
-   *port->format = reply.format;
+   mmal_vc_msg_to_format(port->format, &reply.format);
    *port->format->es = reply.es;
    if(port->format->extradata_size)
    {
@@ -1001,15 +1011,15 @@ static MMAL_STATUS_T mmal_vc_port_info_set(MMAL_PORT_T *port)
    msg.component_handle = module->component_handle;
    msg.port_type = port->type;
    msg.index = port->index;
-   msg.port = *port;
-   msg.format = *port->format;
+   mmal_vc_port_to_msg(&msg.port, port);
+   mmal_vc_format_to_msg(&msg.format, port->format);
    msg.es = *port->format->es;
    if(msg.format.extradata_size > MMAL_FORMAT_EXTRADATA_MAX_SIZE)
    {
       vcos_assert(0);
       msg.format.extradata_size = MMAL_FORMAT_EXTRADATA_MAX_SIZE;
    }
-   memcpy(msg.extradata, msg.format.extradata, msg.format.extradata_size);
+   memcpy(msg.extradata, port->format->extradata, msg.format.extradata_size);
 
    LOG_TRACE("set port info (%i:%i)", port->type, port->index);
 
@@ -1037,9 +1047,7 @@ static MMAL_STATUS_T mmal_vc_port_info_set(MMAL_PORT_T *port)
    port->buffer_alignment_min = reply.port.buffer_alignment_min;
    port->is_enabled = reply.port.is_enabled;
    port->capabilities = reply.port.capabilities;
-   reply.format.extradata = port->format->extradata;
-   reply.format.es = port->format->es;
-   *port->format = reply.format;
+   mmal_vc_msg_to_format(port->format, &reply.format);
    *port->format->es = reply.es;
    if(port->format->extradata_size)
    {
@@ -1328,7 +1336,6 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
       return MMAL_EINVAL;
    }
 
-   msg.client_component = component;
    /* coverity[secure_coding] Length tested above */
    strcpy(msg.name, basename);
 #if defined(__linux__) || defined(__HAIKU__)
@@ -1351,6 +1358,14 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
       return status;
    }
 
+   msg.client_component = mmal_vc_handle_alloc(component);
+   if (!msg.client_component)
+   {
+      mmal_vc_shm_exit();
+      mmal_vc_deinit();
+      return MMAL_ENOSPC;
+   }
+
    // claim VC for entire duration of component.
    status = mmal_vc_use();
 
@@ -1370,6 +1385,7 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
    {
       LOG_ERROR("failed to create component '%s' (%i:%s)", name, status,
                 mmal_status_to_string(status));
+      mmal_vc_handle_free(msg.client_component);
       mmal_vc_release();
       mmal_vc_shm_exit();
       mmal_vc_deinit();
@@ -1382,14 +1398,17 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
    module = vcos_calloc(1, sizeof(*module) + ports_num * sizeof(*module->ports), "mmal_vc_module");
    if (!module)
    {
-      mmal_worker_component_destroy msg;
-      mmal_worker_reply reply;
-      size_t replylen = sizeof(reply);
+      mmal_worker_component_destroy destroy_msg;
+      mmal_worker_reply destroy_reply;
+      size_t destroy_replylen = sizeof(destroy_reply);
       MMAL_STATUS_T destroy_status;
 
-      destroy_status = mmal_vc_sendwait_message(mmal_vc_get_client(), &msg.header, sizeof(msg),
-                               MMAL_WORKER_COMPONENT_DESTROY, &reply, &replylen, MMAL_FALSE);
+      destroy_msg.component_handle = reply.component_handle;
+      destroy_status = mmal_vc_sendwait_message(mmal_vc_get_client(), &destroy_msg.header,
+                               sizeof(destroy_msg), MMAL_WORKER_COMPONENT_DESTROY, &destroy_reply,
+                               &destroy_replylen, MMAL_FALSE);
       vcos_assert(destroy_status == MMAL_SUCCESS);
+      mmal_vc_handle_free(msg.client_component);
       mmal_vc_release();
       mmal_vc_shm_exit();
       mmal_vc_deinit();
@@ -1397,6 +1416,7 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
    }
    module->ports = (MMAL_PORT_MODULE_T **)&module[1];
    module->component_handle = reply.component_handle;
+   module->client_handle = msg.client_component;
    component->priv->module = module;
 
    /* Allocate our local ports. Control port reallocated to set module size. */
@@ -1492,6 +1512,12 @@ static MMAL_STATUS_T mmal_vc_component_create(const char *name, MMAL_COMPONENT_T
          goto fail;
    }
 
+   /* The event buffers receive the VideoCore's events, which mmal_vc_client.c converts to the
+    * host's layout: a format change grows on a 64-bit host */
+   component->control->buffer_size_min +=
+      sizeof(MMAL_EVENT_FORMAT_CHANGED_T) + sizeof(MMAL_ES_FORMAT_T) -
+      sizeof(mmal_worker_event_format_changed) - sizeof(mmal_worker_es_format);
+
    /* Initialise the vc client context which will be used for our event buffers */
    module->event_ctx_initialised = MMAL_FALSE;
    module->event_ctx.magic = MMAL_MAGIC;
diff --git a/interface/mmal/vc/mmal_vc_api.h b/interface/mmal/vc/mmal_vc_api.h
index 3ba7ce9..cd426f2 100644
--- a/interface/mmal/vc/mmal_vc_api.h
+++ b/interface/mmal/vc/mmal_vc_api.h
@@ -56,7 +56,7 @@ typedef enum {
 /** Per-component statistics collected by the VC adaptation layer.
  */
 struct MMAL_VC_COMP_STATS_T {
-   struct MMAL_DRIVER_COMPONENT_T *comp;
+   uint32_t comp;                /**< The component's address on the VideoCore */
    MMAL_STATS_COMP_STATE_T state;
    uint32_t pid;
    uint32_t pool_mem_alloc_size;
diff --git a/interface/mmal/vc/mmal_vc_client.c b/interface/mmal/vc/mmal_vc_client.c
index 4935a27..3a61a3b 100644
--- a/interface/mmal/vc/mmal_vc_client.c
+++ b/interface/mmal/vc/mmal_vc_client.c
@@ -87,9 +87,112 @@ struct MMAL_CLIENT_T
  */
 static MMAL_CLIENT_T client;
 
+/** Host objects the VideoCore refers to by a handle (mmal_vc_msgs.h): handle = index + 1.
+  * Entries are handed out in order, freed ones are reused first. */
+#define MAX_HANDLES 1024
+static struct
+{
+   VCOS_MUTEX_T lock;
+   void *objects[MAX_HANDLES];
+   uint32_t next_free[MAX_HANDLES]; /**< Handle of the next free entry, 0 at the end */
+   uint32_t first_free;             /**< First free handle, 0 if none */
+   uint32_t used;                   /**< Entries handed out so far */
+} handles;
+
 static void init_once(void)
 {
    vcos_mutex_create(&client.lock, VCOS_FUNCTION);
+   vcos_mutex_create(&handles.lock, "mmal vc handles");
+}
+
+uint32_t mmal_vc_handle_alloc(void *object)
+{
+   uint32_t index;
+
+   vcos_assert(object);
+   vcos_once(&once, init_once);
+   vcos_mutex_lock(&handles.lock);
+   if (handles.first_free)
+   {
+      index = handles.first_free - 1;
+      handles.first_free = handles.next_free[index];
+   }
+   else if (handles.used < MAX_HANDLES)
+      index = handles.used++;
+   else
+   {
+      vcos_mutex_unlock(&handles.lock);
+      LOG_ERROR("all %d handles in use", MAX_HANDLES);
+      return 0;
+   }
+   handles.objects[index] = object;
+   vcos_mutex_unlock(&handles.lock);
+   return index + 1;
+}
+
+void *mmal_vc_handle_get(uint32_t handle)
+{
+   void *object;
+
+   if (handle == 0 || handle > MAX_HANDLES)
+      return NULL;
+   vcos_mutex_lock(&handles.lock);
+   object = handles.objects[handle - 1];
+   vcos_mutex_unlock(&handles.lock);
+   return object;
+}
+
+void mmal_vc_handle_free(uint32_t handle)
+{
+   if (handle == 0 || handle > MAX_HANDLES)
+      return;
+   vcos_mutex_lock(&handles.lock);
+   if (handles.objects[handle - 1])
+   {
+      handles.objects[handle - 1] = NULL;
+      handles.next_free[handle - 1] = handles.first_free;
+      handles.first_free = handle;
+   }
+   vcos_mutex_unlock(&handles.lock);
+}
+
+/** An event's data from the VideoCore's layout to the host's: MMAL_EVENT_FORMAT_CHANGED_T and
+  * MMAL_ES_FORMAT_T have pointers (mmal_vc_msgs.h). Returns false if it does not fit the buffer. */
+static MMAL_BOOL_T mmal_vc_event_from_msg(MMAL_BUFFER_HEADER_T *buffer)
+{
+   const uint32_t msg_size = sizeof(mmal_worker_event_format_changed) +
+      sizeof(mmal_worker_es_format) + sizeof(MMAL_ES_SPECIFIC_FORMAT_T);
+   const uint32_t host_size = sizeof(MMAL_EVENT_FORMAT_CHANGED_T) +
+      sizeof(MMAL_ES_FORMAT_T) + sizeof(MMAL_ES_SPECIFIC_FORMAT_T);
+   mmal_worker_event_format_changed event;
+   mmal_worker_es_format format;
+   MMAL_EVENT_FORMAT_CHANGED_T *host_event;
+   uint32_t extradata_size;
+
+   /* (a shorter one is refused by mmal_event_format_changed_get()) */
+   if (buffer->cmd != MMAL_EVENT_FORMAT_CHANGED || msg_size == host_size ||
+       buffer->length < msg_size)
+      return MMAL_TRUE;
+
+   extradata_size = buffer->length - msg_size;
+   if (buffer->offset + host_size + extradata_size > buffer->alloc_size)
+      return MMAL_FALSE;
+
+   memcpy(&event, buffer->data + buffer->offset, sizeof(event));
+   memcpy(&format, buffer->data + buffer->offset + sizeof(event), sizeof(format));
+   /* the format-specific part and the extradata move to their place */
+   memmove(buffer->data + buffer->offset + host_size - sizeof(MMAL_ES_SPECIFIC_FORMAT_T),
+           buffer->data + buffer->offset + msg_size - sizeof(MMAL_ES_SPECIFIC_FORMAT_T),
+           sizeof(MMAL_ES_SPECIFIC_FORMAT_T) + extradata_size);
+   host_event = (MMAL_EVENT_FORMAT_CHANGED_T *)(buffer->data + buffer->offset);
+   memset(host_event, 0, sizeof(MMAL_EVENT_FORMAT_CHANGED_T) + sizeof(MMAL_ES_FORMAT_T));
+   host_event->buffer_size_min = event.buffer_size_min;
+   host_event->buffer_num_min = event.buffer_num_min;
+   host_event->buffer_size_recommended = event.buffer_size_recommended;
+   host_event->buffer_num_recommended = event.buffer_num_recommended;
+   mmal_vc_msg_to_format((MMAL_ES_FORMAT_T *)&host_event[1], &format);
+   buffer->length = host_size + extradata_size;
+   return MMAL_TRUE;
 }
 
