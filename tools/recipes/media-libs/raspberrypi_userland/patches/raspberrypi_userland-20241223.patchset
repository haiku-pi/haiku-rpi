From a24b73e2c26ea27dea26fcd2e4eef92b1f53e732 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 10:29:45 +0100
Subject: [PATCH 6/8] Haiku: a Makefile for VCOS, libvchiq and MMAL's VideoCore
 client

makefiles/haiku/Makefile builds libvcos, libvchiq_arm, libmmal_core,
libmmal_util, libmmal_vc_client and libmmal (the names and sonames of the
CMake build) and installs them with their headers and an mmal.pc. The CMake
build also builds the Linux host applications, and no MMAL on 64-bit hosts.
---
 makefiles/haiku/Makefile   | 79 ++++++++++++++++++++++++++++++++++++++
 makefiles/haiku/mmal.pc.in |  9 +++++
 2 files changed, 88 insertions(+)
 create mode 100644 makefiles/haiku/Makefile
 create mode 100644 makefiles/haiku/mmal.pc.in

diff --git a/makefiles/haiku/Makefile b/makefiles/haiku/Makefile
new file mode 100644
index 0000000..b0ee8cd
--- /dev/null
+++ b/makefiles/haiku/Makefile
@@ -0,0 +1,79 @@
+# Haiku build of VCOS (pthreads), libvchiq and MMAL's VideoCore client:
+#
+#   make -f makefiles/haiku/Makefile [CC=...] [AR=...]
+#   make -f makefiles/haiku/Makefile install DESTDIR=... prefix=/boot/system
+#
+# The CMake build (CMakeLists.txt) builds the Linux host applications as well and leaves MMAL out on 64-bit
+# hosts; this builds only the libraries an MMAL client needs, with the names and sonames of the CMake build:
+#   libvcos.so libvchiq_arm.so libmmal_core.so libmmal_util.so libmmal_vc_client.so libmmal.so
+# Not built: the ARM-side MMAL components (mmal_components), the OpenMAX IL layer, the containers, vcsm
+# (zero-copy buffers need the vc-sm kernel driver) and bcm_host.
+
+CC ?= gcc
+prefix ?= /boot/system
+libdir ?= $(prefix)/lib
+headersdir ?= $(prefix)/develop/headers
+includedir ?= $(headersdir)/raspberrypi_userland
+pkgconfigdir ?= $(prefix)/develop/lib/pkgconfig
+B ?= build-haiku
+
+CPPFLAGS += -D_REENTRANT -D_GNU_SOURCE -DUSE_VCHIQ_ARM -DVCHI_BULK_ALIGN=1 -DVCHI_BULK_GRANULARITY=1 \
+	-D__VIDEOCORE4__ -DOMX_SKIP64BIT -I. -Iinterface/vcos -Iinterface/vcos/pthreads -Iinterface/vchiq_arm -Iinterface/mmal
+CFLAGS ?= -O2
+CFLAGS += -std=gnu11 -fPIC -Wall -Wno-multichar -Wno-unused-but-set-variable
+
+vcos_SRCS := $(addprefix interface/vcos/, pthreads/vcos_pthreads.c pthreads/vcos_dlfcn.c glibc/vcos_backtrace.c \
+	$(addprefix generic/vcos_, generic_event_flags.c mem_from_malloc.c generic_named_sem.c \
+		generic_safe_string.c generic_reentrant_mtx.c abort.c cmd.c init.c msgqueue.c logcat.c \
+		generic_blockpool.c))
+vchiq_arm_SRCS := interface/vchiq_arm/vchiq_lib.c interface/vchiq_arm/vchiq_util.c
+mmal_core_SRCS := $(addprefix interface/mmal/core/mmal_, format.c port.c port_clock.c component.c buffer.c \
+	queue.c pool.c events.c logging.c clock.c)
+mmal_util_SRCS := $(addprefix interface/mmal/util/mmal_, il.c util.c connection.c graph.c list.c \
+	param_convert.c util_params.c component_wrapper.c util_rational.c)
+mmal_vc_client_SRCS := $(addprefix interface/mmal/vc/mmal_vc_, client.c shm.c api.c opaque_alloc.c msgnames.c \
+	api_drm.c)
+mmal_SRCS := interface/mmal/util/mmal_util.c
+
+# library: its sources, the libraries it links
+vcos_LIBS :=
+vchiq_arm_LIBS := -lvcos
+mmal_vc_client_LIBS := -lvchiq_arm -lvcos
+mmal_core_LIBS := -lmmal_vc_client -lvcos
+mmal_util_LIBS := -lmmal_core -lvcos
+mmal_LIBS := -lmmal_core -lmmal_util -lmmal_vc_client -lvcos
+
+LIBS := vcos vchiq_arm mmal_vc_client mmal_core mmal_util mmal
+all: $(foreach l,$(LIBS),$(B)/lib$(l).so)
+
+$(B)/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+define library
+$(B)/lib$(1).so: $$(patsubst %.c,$(B)/%.o,$$($(1)_SRCS)) $$(patsubst -l%,$(B)/lib%.so,$$($(1)_LIBS))
+	$$(CC) -shared -Wl,-soname,lib$(1).so $$(LDFLAGS) -o $$@ $$(patsubst %.c,$(B)/%.o,$$($(1)_SRCS)) \
+		-L$(B) $$($(1)_LIBS)
+endef
+# mmal_core and mmal_vc_client use each other; mmal_vc_client is linked first, with mmal_core's symbols
+# left to the runtime loader (as in the CMake build)
+$(foreach l,$(LIBS),$(eval $(call library,$(l))))
+
+# (interface/vmcs_host/khronos/IL: the OpenMAX IL headers mmal_il.h includes, Khronos's MIT licence)
+HEADER_DIRS := interface/vcos interface/vcos/pthreads interface/vcos/generic interface/vchiq_arm interface/vchi \
+	interface/vmcs_host/khronos/IL interface/mmal interface/mmal/core interface/mmal/util interface/mmal/vc
+install: all
+	install -d $(DESTDIR)$(libdir) $(DESTDIR)$(pkgconfigdir)
+	install -m 755 $(foreach l,$(LIBS),$(B)/lib$(l).so) $(DESTDIR)$(libdir)
+	for d in $(HEADER_DIRS); do \
+		install -d $(DESTDIR)$(includedir)/$$d; \
+		install -m 644 $$d/*.h $(DESTDIR)$(includedir)/$$d; \
+	done
+	install -m 644 LICENCE $(DESTDIR)$(includedir)
+	sed -e 's|@prefix@|$(prefix)|; s|@libdir@|$(libdir)|; s|@headersdir@|$(headersdir)|' \
+		makefiles/haiku/mmal.pc.in > $(DESTDIR)$(pkgconfigdir)/mmal.pc
+
+clean:
+	rm -rf $(B)
+
+.PHONY: all install clean
diff --git a/makefiles/haiku/mmal.pc.in b/makefiles/haiku/mmal.pc.in
new file mode 100644
index 0000000..61a4ffc
--- /dev/null
+++ b/makefiles/haiku/mmal.pc.in
@@ -0,0 +1,9 @@
+prefix=@prefix@
+libdir=@libdir@
+includedir=@headersdir@
+
+Name: MMAL
+Description: Multi-Media Abstraction Layer library for the Raspberry Pi's VideoCore
+Version: 1
+Libs: -L${libdir} -lmmal -lmmal_core -lmmal_util -lmmal_vc_client -lvchiq_arm -lvcos
+Cflags: -I${includedir}/raspberrypi_userland -I${includedir}/raspberrypi_userland/interface/vcos/pthreads -I${includedir}/raspberrypi_userland/interface/mmal
-- 
2.53.0


From 9fced5f4dfcf9baf8dbfd88fb72b33e87ae81872 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 19:24:03 +0100
Subject: [PATCH 7/8] mmal: take refcount_lock in mmal_vc_shm_exit()

mmal_vc_shm_exit() unlocked refcount_lock without having locked it,
so two components destroyed at once could race on the count and the
payload list, and an error-checking mutex (Haiku's libroot) refuses
the unlock.
---
 interface/mmal/vc/mmal_vc_shm.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/interface/mmal/vc/mmal_vc_shm.c b/interface/mmal/vc/mmal_vc_shm.c
index aa81309..407d0f7 100644
--- a/interface/mmal/vc/mmal_vc_shm.c
+++ b/interface/mmal/vc/mmal_vc_shm.c
@@ -167,6 +167,9 @@ unlock:
 
 void mmal_vc_shm_exit(void)
 {
+   vcos_once(&once, mmal_vc_shm_init_once);
+
+   vcos_mutex_lock(&refcount_lock);
    if (mmal_vc_shm_initialised <= 0)
       goto unlock;
 
-- 
2.53.0


From 89ccab8f9240d6739883a619678dc33753f865f2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Thu, 5 Nov 2026 20:46:29 +0100
Subject: [PATCH 8/8] mmal: wait for the VideoCore's replies for 5 s at most

mmal_vc_sendwait_message() waited for a reply for good (its FIXME), so a
VideoCore that stopped answering (seen after its decoder failed with ENOSPC)
hung its client, also while the client closed its components. After 5 s the
call now fails with MMAL_EIO and abandons its waiter; the reply handler drops
a reply that comes later (the sender's destination is gone) and releases the
waiter. The two sides decide under the client's lock.
---
 interface/mmal/vc/mmal_vc_client.c | 41 +++++++++++++++++++++++++-----
 1 file changed, 35 insertions(+), 6 deletions(-)

diff --git a/interface/mmal/vc/mmal_vc_client.c b/interface/mmal/vc/mmal_vc_client.c
index 3a61a3b..09ee1b3 100644
--- a/interface/mmal/vc/mmal_vc_client.c
+++ b/interface/mmal/vc/mmal_vc_client.c
@@ -55,6 +55,7 @@ typedef struct MMAL_WAITER_T
 {
    VCOS_SEMAPHORE_T sem;
    unsigned inuse;
+   unsigned abandoned;           /**< Its sender stopped waiting: the reply handler releases it */
    void *dest;                   /**< Where to write reply */
    size_t destlen;               /**< Max length for reply */
 } MMAL_WAITER_T;
@@ -210,6 +211,7 @@ static MMAL_STATUS_T create_waitpool(MMAL_WAITPOOL_T *waitpool)
    for (i=0; i<MAX_WAITERS; i++)
    {
       waitpool->waiters[i].inuse = 0;
+      waitpool->waiters[i].abandoned = 0;
       status = vcos_semaphore_create(&waitpool->waiters[i].sem,
                                      "mmal waiter", 0);
       if (status != VCOS_SUCCESS)
@@ -239,6 +241,9 @@ static void destroy_waitpool(MMAL_WAITPOOL_T *waitpool)
    vcos_semaphore_delete(&waitpool->sem);
 }
 
+/** How long mmal_vc_sendwait_message() waits for the VideoCore's reply */
+#define MMAL_VC_REPLY_TIMEOUT_MS 5000
+
 /** Grab a waiter from the pool. Return immediately if one already
   * available, or wait for one to become available.
   */
@@ -562,12 +567,24 @@ static VCHIQ_STATUS_T mmal_vc_vchiq_callback(VCHIQ_REASON_T reason,
                vchiq_release_message(service, vchiq_header);
                break;
             }
+            /* under the client's lock: mmal_vc_sendwait_message() gives up on a waiter under it */
+            vcos_mutex_lock(&client.lock);
+            if (waiter->abandoned)
+            {
+               waiter->abandoned = 0;
+               vcos_mutex_unlock(&client.lock);
+               LOG_ERROR("reply %u came after its sender stopped waiting: dropped", msg->msgid);
+               vchiq_release_message(service, vchiq_header);
+               release_waiter(&client, waiter);
+               break;
+            }
             int len = vcos_min(waiter->destlen, vchiq_header->size);
             waiter->destlen = len;
             LOG_TRACE("copying payload @%p to %p len %d", waiter->dest, msg, len);
             memcpy(waiter->dest, msg, len);
             vchiq_release_message(service, vchiq_header);
             vcos_semaphore_post(&waiter->sem);
+            vcos_mutex_unlock(&client.lock);
          }
       }
       break;
@@ -749,13 +766,25 @@ MMAL_STATUS_T mmal_vc_sendwait_message(struct MMAL_CLIENT_T *client,
       }
    }
 
-   /* now wait for the reply...
-    *
-    * FIXME: we could do with a timeout here. Need to be careful to cancel
-    * the semaphore on a timeout.
-    */
+   /* now wait for the reply, for a while: a VideoCore that does not answer must not hang its client (an
+    * application closing its decoder) for good. The waiter is then abandoned: the reply handler drops a late
+    * reply and releases it. */
    /* coverity[lock] This semaphore isn't being used as a mutex */
-   vcos_semaphore_wait(&waiter->sem);
+   if (vcos_semaphore_wait_timeout(&waiter->sem, MMAL_VC_REPLY_TIMEOUT_MS) != VCOS_SUCCESS)
+   {
+      MMAL_BOOL_T replied;
+      vcos_mutex_lock(&client->lock);
+      replied = vcos_semaphore_trywait(&waiter->sem) == VCOS_SUCCESS;
+      if (!replied)
+         waiter->abandoned = 1;
+      vcos_mutex_unlock(&client->lock);
+      if (!replied)
+      {
+         LOG_ERROR("no reply to message %u in %d ms", msgid, MMAL_VC_REPLY_TIMEOUT_MS);
+         mmal_vc_release_internal(client);
+         return MMAL_EIO;
+      }
+   }
 
    mmal_vc_release_internal(client);
    LOG_TRACE("got reply (len %i/%i)", (int)*destlen, (int)waiter->destlen);
-- 
2.53.0

