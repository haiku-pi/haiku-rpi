+/* The messages have the layout they have on a 32-bit host, on every host: the VideoCore only knows that
+ * one. Where the structures had a pointer to a host object the VideoCore passes back (a waiter, a
+ * component, a buffer's context), they have a 32-bit handle (mmal_vc_handle_alloc()); where they embed
+ * an MMAL structure with pointers (MMAL_PORT_T, MMAL_ES_FORMAT_T, MMAL_BUFFER_HEADER_T,
+ * MMAL_EVENT_FORMAT_CHANGED_T), they have a copy of it with 32-bit fields in place of the pointers,
+ * which the VideoCore does not use. The sizes are checked below. */
+
 /** Every message has one of these at the start.
   */
 typedef struct
 {
    uint32_t magic;
    uint32_t msgid;
-   struct MMAL_CONTROL_SERVICE_T *control_service;       /** Handle to the control service */
+   uint32_t control_service;           /** Handle to the control service */
 
    union {
-      struct MMAL_WAITER_T *waiter;    /** User-land wait structure, passed back */
+      uint32_t waiter;                 /** User-land wait structure (its handle), passed back */
    } u;
 
    MMAL_STATUS_T status;            /** Result code, passed back */
@@ -125,6 +132,79 @@ typedef struct
 
 /* Make sure mmal_worker_msg_header will preserve 64 bits alignment */
 vcos_static_assert(!(sizeof(mmal_worker_msg_header) & 0x7));
+vcos_static_assert(sizeof(mmal_worker_msg_header) == 24);
+
+/** MMAL_PORT_T as the VideoCore sees it (32-bit pointers, not used by the VideoCore) */
+typedef struct
+{
+   uint32_t priv;
+   uint32_t name;
+   MMAL_PORT_TYPE_T type;
+   uint16_t index;
+   uint16_t index_all;
+   uint32_t is_enabled;
+   uint32_t format;
+   uint32_t buffer_num_min;
+   uint32_t buffer_size_min;
+   uint32_t buffer_alignment_min;
+   uint32_t buffer_num_recommended;
+   uint32_t buffer_size_recommended;
+   uint32_t buffer_num;
+   uint32_t buffer_size;
+   uint32_t component;
+   uint32_t userdata;
+   uint32_t capabilities;
+} mmal_worker_port;
+vcos_static_assert(sizeof(mmal_worker_port) == 64);
+
+/** MMAL_ES_FORMAT_T as the VideoCore sees it; the elementary stream format and the extradata
+  * follow it in the messages */
+typedef struct
+{
+   MMAL_ES_TYPE_T type;
+   MMAL_FOURCC_T encoding;
+   MMAL_FOURCC_T encoding_variant;
+   uint32_t es;
+   uint32_t bitrate;
+   uint32_t flags;
+   uint32_t extradata_size;
+   uint32_t extradata;
+} mmal_worker_es_format;
+vcos_static_assert(sizeof(mmal_worker_es_format) == 32);
+
+/** MMAL_BUFFER_HEADER_T as the VideoCore sees it. data is the payload's address on a 32-bit host
+  * (its low 32 bits otherwise); only zero-copy buffers use it (a VideoCore handle then). */
+typedef struct
+{
+   uint32_t next;
+   uint32_t priv;
+   uint32_t cmd;
+   uint32_t data;
+   uint32_t alloc_size;
+   uint32_t length;
+   uint32_t offset;
+   uint32_t flags;
+   int64_t  pts;
+   int64_t  dts;
+   uint32_t type;
+   uint32_t user_data;
+} mmal_worker_buffer_header;
+vcos_static_assert(sizeof(mmal_worker_buffer_header) == 56);
+
+/** MMAL_EVENT_FORMAT_CHANGED_T as the VideoCore sends it: followed by an mmal_worker_es_format,
+  * an MMAL_ES_SPECIFIC_FORMAT_T and the extradata */
+typedef struct
+{
+   uint32_t buffer_size_min;
+   uint32_t buffer_num_min;
+   uint32_t buffer_size_recommended;
+   uint32_t buffer_num_recommended;
+   uint32_t format;
+} mmal_worker_event_format_changed;
+vcos_static_assert(sizeof(mmal_worker_event_format_changed) == 20);
+vcos_static_assert(sizeof(MMAL_ES_SPECIFIC_FORMAT_T) == 44);
+vcos_static_assert(sizeof(MMAL_BUFFER_HEADER_TYPE_SPECIFIC_T) == 40);
+vcos_static_assert(sizeof(MMAL_VC_STATS_T) == 408);
 
 /* Message structures sent to worker thread.
  */
@@ -152,10 +232,11 @@ typedef struct
 typedef struct
 {
    mmal_worker_msg_header header;
-   void *client_component;             /** Client component */
+   uint32_t client_component;          /** Client component (its handle) */
    char name[128];
    uint32_t pid;                       /**< For debug */
 } mmal_worker_component_create;
+vcos_static_assert(sizeof(mmal_worker_component_create) == 160);
 
 /** Reply to component-creation message. Reports back
   * the number of ports.
@@ -214,12 +295,13 @@ typedef struct
    uint32_t component_handle;          /**< Which component */
    MMAL_PORT_TYPE_T port_type;         /**< Type of port */
    uint32_t index;                     /**< Which port of given type to get */
-   MMAL_PORT_T port;
-   MMAL_ES_FORMAT_T format;
+   mmal_worker_port port;
