     * input port. */
-   struct MMAL_DRIVER_BUFFER_T drvbuf_ref;
+   mmal_worker_driver_buffer drvbuf_ref;
 
    /** the buffer header itself */
-   MMAL_BUFFER_HEADER_T buffer_header;
+   mmal_worker_buffer_header buffer_header;
    MMAL_BUFFER_HEADER_TYPE_SPECIFIC_T buffer_header_type_specific;
 
    MMAL_BOOL_T is_zero_copy;
@@ -396,6 +491,7 @@ typedef struct mmal_worker_buffer_from_host
 
 } mmal_worker_buffer_from_host;
 vcos_static_assert(sizeof(mmal_worker_buffer_from_host) <= MMAL_WORKER_MAX_MSG_LEN);
+vcos_static_assert(sizeof(mmal_worker_buffer_from_host) == 296);
 
 /** Maximum number of event data bytes that can be passed in the message.
  * More than this and the data is passed in a bulk message.
@@ -411,16 +507,17 @@ typedef struct mmal_worker_event_to_host
 {
    mmal_worker_msg_header header;
 
-   struct MMAL_COMPONENT_T *client_component;
+   uint32_t client_component;          /**< Client component (its handle) */
    uint32_t port_type;
    uint32_t port_num;
 
    uint32_t cmd;
    uint32_t length;
    uint8_t data[MMAL_WORKER_EVENT_SPACE];
-   MMAL_BUFFER_HEADER_T *delayed_buffer;  /* Only used to remember buffer for bulk rx */
+   uint32_t delayed_buffer;  /* Only used to remember buffer for bulk rx (its handle) */
 } mmal_worker_event_to_host;
 vcos_static_assert(sizeof(mmal_worker_event_to_host) <= MMAL_WORKER_MAX_MSG_LEN);
+vcos_static_assert(sizeof(mmal_worker_event_to_host) == 304);
 
 typedef struct
 {
@@ -515,7 +612,7 @@ static inline void mmal_vc_buffer_header_to_msg(mmal_worker_buffer_from_host *ms
    msg->buffer_header.pts           = header->pts;
    msg->buffer_header.dts           = header->dts;
    msg->buffer_header.alloc_size    = header->alloc_size;
-   msg->buffer_header.data          = header->data;
+   msg->buffer_header.data          = (uint32_t)(uintptr_t)header->data;
    msg->buffer_header_type_specific = *header->type;
 }
 
@@ -531,5 +628,44 @@ static inline void mmal_vc_msg_to_buffer_header(MMAL_BUFFER_HEADER_T *header,
    *header->type  = msg->buffer_header_type_specific;
 }
 
+static inline void mmal_vc_port_to_msg(mmal_worker_port *msg, const MMAL_PORT_T *port)
+{
+   memset(msg, 0, sizeof(*msg));
+   msg->type                    = port->type;
+   msg->index                   = port->index;
+   msg->index_all               = port->index_all;
+   msg->is_enabled              = port->is_enabled;
+   msg->buffer_num_min          = port->buffer_num_min;
+   msg->buffer_size_min         = port->buffer_size_min;
+   msg->buffer_alignment_min    = port->buffer_alignment_min;
+   msg->buffer_num_recommended  = port->buffer_num_recommended;
+   msg->buffer_size_recommended = port->buffer_size_recommended;
+   msg->buffer_num              = port->buffer_num;
+   msg->buffer_size             = port->buffer_size;
+   msg->capabilities            = port->capabilities;
+}
+
+static inline void mmal_vc_format_to_msg(mmal_worker_es_format *msg, const MMAL_ES_FORMAT_T *format)
+{
+   memset(msg, 0, sizeof(*msg));
+   msg->type             = format->type;
+   msg->encoding         = format->encoding;
+   msg->encoding_variant = format->encoding_variant;
+   msg->bitrate          = format->bitrate;
+   msg->flags            = format->flags;
+   msg->extradata_size   = format->extradata_size;
+}
+
+/** The fields of a message's format, into a format (its es and extradata stay) */
+static inline void mmal_vc_msg_to_format(MMAL_ES_FORMAT_T *format, const mmal_worker_es_format *msg)
+{
+   format->type             = msg->type;
+   format->encoding         = msg->encoding;
+   format->encoding_variant = msg->encoding_variant;
+   format->bitrate          = msg->bitrate;
+   format->flags            = msg->flags;
+   format->extradata_size   = msg->extradata_size;
+}
+
 #endif
 
