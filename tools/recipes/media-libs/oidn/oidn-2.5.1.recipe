SUMMARY="Intel Open Image Denoise, a denoising library for ray-traced images"
DESCRIPTION="Intel Open Image Denoise is a collection of high-performance, high-quality denoising \
filters for images rendered with ray tracing, based on deep learning. Blender's Cycles uses it for \
its Denoise option (final renders and the viewport) and the compositor's Denoise node. On arm64 the \
CPU device runs ISPC-generated NEON kernels."
HOMEPAGE="https://www.openimagedenoise.org/"
COPYRIGHT="2018-2025 Intel Corporation"
LICENSE="Apache v2"
REVISION="1"
SOURCE_URI="https://github.com/RenderKit/oidn/releases/download/v$portVersion/oidn-$portVersion.src.tar.gz"
CHECKSUM_SHA256="e71fd043a70f1cc80e301d1b90df6c1f536098c4dd94baa612742f6db3369c36"
SOURCE_FILENAME="oidn-$portVersion.src.tar.gz"
SOURCE_DIR="oidn-$portVersion"
PATCHES="oidn-$portVersion.patchset"

ARCHITECTURES="arm64"

# Cross-built by scripts/build-blender.sh (haiku-pi): the CPU device only (TBB), its NEON kernels
# compiled by the host's ISPC for aarch64 (ISPC's linux object format, plain ELF); the device module
# libOpenImageDenoise_device_cpu.so.<version> is dlopen()ed by the core library from its own
# directory. HaikuPorts has no recipe. Blender 3.6 pins OIDN 1.4 (x86 only, oneDNN); its use of the
# API builds against 2.x unchanged.
PROVIDES="
	oidn = $portVersion
	lib:libOpenImageDenoise = 2.5.1 compat >= 2
	lib:libOpenImageDenoise_core = 2.5.1 compat >= 2.5.1
	cmd:oidnBenchmark
	cmd:oidnDenoise
	"
REQUIRES="
	haiku
	lib:libtbb
	lib:libstdc++
	"
