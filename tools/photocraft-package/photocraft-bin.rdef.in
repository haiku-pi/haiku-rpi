/*
 * The resources of PhotoCraft's program (apps/PhotoCraft/bin/PhotoCraft, the Rust executable): its own
 * signature, so that the BApplication the Wayland server makes in it registers as PhotoCraft (the Deskbar
 * shows its name and icon), but no file types — documents go through the launcher (PhotoCraft.rdef.in).
 * B_ARGV_ONLY: it takes its documents as arguments.
 */

resource app_signature "application/x-vnd.storyteller-photocraft-app";

resource app_flags B_MULTIPLE_LAUNCH | B_ARGV_ONLY;

resource app_version {
	major  = @MAJOR@,
	middle = @MIDDLE@,
	minor  = @MINOR@,

	variety = B_APPV_FINAL,
	internal = @REVISION@,

	short_info = "PhotoCraft",
	long_info = "PhotoCraft @VERSION@ — photo editor (layers, PSD, raw), on Haiku's Wayland server and Vulkan"
};

// tools/haiku-icon/png2hvif.py from assets/app-icon/hicolor/256x256 (the Linux icon)
resource vector_icon import "@ICON@";
