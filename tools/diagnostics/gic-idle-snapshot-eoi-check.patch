+// DIAGNOSTIC (GIC stall): the interrupt controller's per-CPU snapshot
+extern void (*gArm64BeforeIdle)(void);
+
 static inline void arch_cpu_idle(void)
 {
+	if (gArm64BeforeIdle != NULL)
+		gArm64BeforeIdle();
 	// Complete the outstanding writes first (as Linux's cpu_do_idle): the
 	// end-of-interrupt write to the GIC can otherwise wait in a buffer while
 	// the CPU sleeps, and the GIC delivers it nothing else until then
diff --git a/src/system/kernel/arch/arm/arch_int_gicv2.cpp b/src/system/kernel/arch/arm/arch_int_gicv2.cpp
index 73b346ade8..903057a528 100644
