#version 450
// vktest: values[i] = i * i + salt + the number of workgroups (which an indirect dispatch takes from
// the GPU's uniforms, patched by the kernel driver's indirect dispatch CPU job)
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Data {
	uint values[];
};

layout(push_constant) uniform Push {
	uint salt;
} push;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	values[i] = i * i + push.salt + gl_NumWorkGroups.x;
}
