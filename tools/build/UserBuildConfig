# UserBuildConfig for the Raspberry Pi 4 port (linked into sources/haiku/build/jam by
# scripts/build.sh). Plain builds are unchanged; options are jam variables:
#
#   jam -sHAIKU_PI_DEV=1 @minimum-mmc
#       a development image: the arm64 build packages that Haiku's servers carry (cross-built gcc,
#       binutils, make, python3.10, haikuporter, ...) and haiku_devel, on a larger volume — the
#       first step of the package farm (docs/design/package-farm-plan.md, stage 1)
#
#   jam -sHAIKU_PI_GL=1 @minimum-mmc
#       the OpenGL stack as packages (mesa, glu: scripts/package-gl-stack.sh, staged in
#       generated.arm64/download and listed in repositories/HaikuPorts/arm64) and what jam builds once
#       their mesa and glu build features are on: GLTeapot, GLInfo, libglut and the GL screen savers,
#       plus libmedia and libgame for SDL2 (in non-packaged/, as the minimum image's haiku package
#       does not list them)
#
#   jam @pi-mmc
#       the regular image (the regular build type: media kit and servers, MediaPlayer, the full set of
#       applications and preferences) without the nightly profile's extra packages that arm64 does not
#       have yet (the Development and Git bundles, nano, openssh, ...), as haiku-mmc.image (the
#       profile type ignores the name). Combine with
#       HAIKU_PI_GL (and HAIKU_PI_DEV).
#
# build.sh always adds -sHAIKU_NO_DOWNLOADS=1: our arm64 repository definition lists packages Haiku's
# servers do not have, so jam builds the repository from the download directory.

DefineBuildProfile pi-mmc : haiku-mmc-image : "haiku-pi.mmc" ;
if $(HAIKU_BUILD_PROFILE) = pi-mmc {
	Echo "Raspberry Pi regular image (pi-mmc)" ;
	HAIKU_ROOT_USER_NAME ?= user ;
	HAIKU_ROOT_USER_REAL_NAME ?= "Yourself" ;
	HAIKU_IMAGE_HOST_NAME ?= shredder ;
	HAIKU_IMAGE_SIZE ?= 1000 ;
	# libmidi (Media preferences, MIDI) links libvorbisfile, which the haiku package does not require
	AddHaikuImageSystemPackages libogg libvorbis ;
	# the games' SDL2 (scripts/build-packages.sh)
	AddHaikuImageSystemPackages libsdl2 ;
	# ffmpeg: the media kit's ffmpeg plugin (MediaPlayer's decoders)
	AddHaikuImageSystemPackages ffmpeg6 ;
	# default locale settings: no first-boot prompt (it would hold the desktop back until someone
	# picks a language)
	# (tools/build/make-locale-settings.py wrote it: language "en")
	AddFilesToHaikuImage home config settings
		: $(HAIKU_TOP)/../../tools/build/data/Locale\ settings ;
}

if $(HAIKU_PI_DEV) = 1 {
	Echo "Raspberry Pi development image (HAIKU_PI_DEV)" ;
	HAIKU_IMAGE_SIZE = 1800 ;
	AddHaikuImageSystemPackages
		bash binutils bison coreutils findutils flex gawk gcc gcc_syslibs_devel grep
		haikuporter less m4 make ncurses6 ncurses6_devel python3.10 sed texinfo
		zlib_devel curl curl_devel expat_devel libffi_devel
		;
	# our own haiku_devel (headers, libraries), active, as the bootstrap image does
	AddPackageFilesToHaikuImage system packages : haiku_devel.hpkg : nameFromMetaInfo ;
}

if $(HAIKU_PI_GL) = 1 {
	Echo "Raspberry Pi OpenGL packages and applications (HAIKU_PI_GL)" ;
	AddHaikuImageSystemPackages mesa glu ;
	AddFilesToHaikuImage system non-packaged apps : GLTeapot GLInfo ;
	# libmedia and libgame (not in the minimum image's haiku package): SDL2 links them
	AddLibrariesToHaikuImage system non-packaged lib : libglut.so libmedia.so libgame.so ;
	AddFilesToHaikuImage system non-packaged add-ons Screen\ Savers : Flurry GLife Gravity ;
}
