 }
 
+/* The color textures are attached with glFramebufferTexture2D (OpenGL 3.0 / ARB_framebuffer_object), not
+ * glFramebufferTexture (OpenGL 3.2), which OpenGL 2.1 drivers such as Mesa's V3D (Raspberry Pi 4) do not have. */
 static GLuint create_framebuffer( struct opengl_drawable *drawable, const struct wgl_pixel_format *desc, SIZE size )
 {
     GLuint count = framebuffer_image_count( drawable ), fbo, name;
@@ -876,7 +878,7 @@
