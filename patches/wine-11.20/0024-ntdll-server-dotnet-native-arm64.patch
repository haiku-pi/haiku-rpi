  *
@@ -3134,6 +3136,9 @@
             req->size    = size;
             req->entry   = pe_mapping->image.entry_point;
             req->machine = pe_mapping->image.machine;
+            /* an IL-only main image runs as the machine ntdll chose for it (il_only_machine()) */
+            if (mapping_main_module && (pe_mapping->image.image_flags & IMAGE_FLAGS_ComPlusNativeReady))
+                req->machine = il_only_machine();
             req->offset  = offset;
             status = wine_server_call( req );
         }
@@ -3494,8 +3499,10 @@
     status = load_builtin( pe_mapping, machine, &main_image_info, &main_module, &size, 0, limit_high, 0 );
     if (status == STATUS_IMAGE_ALREADY_LOADED)
     {
+        mapping_main_module = TRUE;
         status = virtual_map_image( mapping, &main_module, &size, 0, limit_high, 0,
                                     pe_mapping, machine, FALSE, 0 );
+        mapping_main_module = FALSE;
         virtual_fill_image_information( &pe_mapping->image, &main_image_info );
     }
     free_pe_mapping_info( pe_mapping );
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1680,8 +1680,10 @@
         {
             current->entry_point = view->base + req->entry;
             if (view->image.image_flags & IMAGE_FLAGS_ComPlusNativeReady)
-                current->process->machine = is_machine_64bit( native_machine )
-                    ? IMAGE_FILE_MACHINE_AMD64 : native_machine;
+                /* x86-64 on a 64-bit host, or the host's own machine when the client maps the image as
+                 * that (WINE_DOTNET_NATIVE on an ARM64 host: ntdll's choice, see exec_wineloader) */
+                current->process->machine = !is_machine_64bit( native_machine ) ? native_machine
+                    : req->machine == native_machine ? native_machine : IMAGE_FILE_MACHINE_AMD64;
             else
                 current->process->machine = req->machine;
         }
