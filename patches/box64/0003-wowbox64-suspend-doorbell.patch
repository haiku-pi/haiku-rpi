+/* Wine's cooperative suspend, as with FEX's WoW64 back end. While x86 code runs (InSimulation), Wine does not
+ * suspend the thread where its SIGUSR1 finds it (somewhere in translated code: the WoW64 context in the CPU area
+ * would be the one of the thread's last system call), but sets *SuspendDoorbell. The translated code checks it
+ * at every block entry and loop head (doorbell_check in the dynarec), the interpreter between instructions, and
+ * wow64_suspend_point() writes the exact x86 state to the WoW64 context, leaves simulation and calls NtContinue():
+ * ntdll takes the pending suspend there, with that context. The CPU area, Wine's CHPE_V2_CPU_AREA_INFO
+ * (winternl.h; not in mingw's headers), is the 64-bit TEB's ChpeV2CpuAreaInfo, which Wine frees with the TEB. */
+typedef struct {
+    BOOLEAN InSimulation;
+    BOOLEAN InSyscallCallback;
+    ULONG64 EmulatorStackBase;
+    ULONG64 EmulatorStackLimit;
+    void* ContextAmd64;
+    volatile ULONG* SuspendDoorbell;
+    ULONG64 LoadingModuleModflag;
+    void* EmulatorData[4];
+    ULONG64 EmulatorDataInline;
+} chpe_v2_cpu_area_info_t;
+#define TEB64_CHPE_V2_CPU_AREA_INFO 0x1788
+
+static chpe_v2_cpu_area_info_t** cpu_area_info(void)
+{
+    return (chpe_v2_cpu_area_info_t**)((char*)NtCurrentTeb() + TEB64_CHPE_V2_CPU_AREA_INFO);
+}
+
+static void enter_simulation(void)
+{
+    chpe_v2_cpu_area_info_t* area = *cpu_area_info();
+    if (area)
+        area->InSimulation = 1;
+}
+
+/* x86 code stops running: a suspend requested meanwhile is taken now, with the WoW64 context as it is */
+static void leave_simulation(void)
+{
+    chpe_v2_cpu_area_info_t* area = *cpu_area_info();
+    if (!area)
+        return;
+    area->InSimulation = 0;
+    if (*area->SuspendDoorbell) {
+        CONTEXT resume;
+        volatile int once = 0;  // on the stack: NtContinue() restores the registers, not the memory
+        RtlCaptureContext(&resume);
+        // ntdll clears the doorbell, waits while suspended, resumes here (once: a doorbell no suspend goes with
+        // would make NtContinue() return here for ever)
+        if (*area->SuspendDoorbell && !once++)
+            NtContinue(&resume, FALSE);
+    }
+}
