+#ifdef _WIN32
+// Wine's cooperative suspend under WoW64 (wine/wow64/wowbox64.c): a SuspendThread() of a thread running x86 code
+// sets emu->suspend_doorbell, and the thread must stop where its x86 state is exact. Checked at each block entry,
+// secondary entry and loop head (every cycle through translated code passes one): a load and a branch not taken,
+// the rest out of line after the block's code. When set, the x86 state goes to x64emu_t (the registers, the
+// cached x87/MMX/SSE values; the x86 address and the flags still in NZCV as arguments) and wow64_suspend_point()
+// takes the suspend. The out-of-line path changes none of the state the compiler tracks: unless the context was
+// changed while suspended, it goes back with all as before; a changed context (SetThreadContext) is in x64emu_t
+// then, and the block is left for its new address.
+#define DOORBELL_SITES 64
+typedef struct doorbell_site_s {
+    int         ninst;
+    uintptr_t   ip;
+    flagcache_t f;
+    uint16_t    ymm_zero;
+    neoncache_t n;
+} doorbell_site_t;
+// the checks of the block being built (blocks are built one at a time); more than DOORBELL_SITES: inline
+static doorbell_site_t doorbell_sites[DOORBELL_SITES];
+static int doorbell_nsites;
+
+// the check's slow path for the state of ninst's start (dyn->n, dyn->f, dyn->ymm_zero), going on at back
+static void doorbell_slowpath(dynarec_arm_t* dyn, int ninst, uintptr_t ip, uintptr_t back)
+{
+    _Static_assert(NF_EQ == SUSPEND_NZCV_ZF && NF_SF == SUSPEND_NZCV_SF && NF_VF == SUSPEND_NZCV_OF
+        && NF_CF == SUSPEND_NZCV_CF && NF_PF_V == SUSPEND_NZCV_PF, "native flags as wow64_suspend_point reads them");
+    neoncache_t cache;
+    flagcache_t f = dyn->f;
+    uint8_t nat_flags_op = dyn->insts[ninst].nat_flags_op;
+    uint32_t natflags = dyn->insts[ninst].nat_flags_in | (dyn->insts[ninst].normal_carry_in ? SUSPEND_NZCV_CF_NORMAL : 0);
+    MESSAGE(LOG_DUMP, "\tSuspend doorbell (%d) ----\n", ninst);
+    fpu_save_and_unwind(dyn, ninst, &cache);
+    MRS_nzcv(x5);
+    fpu_reflectcache(dyn, ninst, x1, x2, x3);
+    MOV64x(x1, ip);
+    MOVx_REG(x2, x5);
+    MOV32w(x3, natflags);
+    call_c(dyn, ninst, const_wow64_suspend_point, x87pc, x4, 1, x5); // x5 (NZCV) kept on the stack
+    MSR_nzcv(x5);
+    CBNZw(x4, dyn->insts[ninst].doorbell_exit - dyn->native_size);
+    fpu_unreflectcache(dyn, ninst, x1, x2, x3);
+    B(back - dyn->native_size);
+    // the context was changed while suspended: it is all in x64emu_t, leave for its address
+    dyn->insts[ninst].doorbell_exit = dyn->native_size;
+    LDRx_U12(xRIP, xEmu, offsetof(x64emu_t, ip));
+    TABLE64C(x2, const_epilog);
+    if(dyn->have_purge)
+        doLeaveBlock(dyn, ninst, x4, x5, x6);
+    BR(x2);
+    // call_c marks the instruction as clobbering the native flags and sets a pending "df none": not on this path
+    dyn->f = f;
+    dyn->insts[ninst].nat_flags_op = nat_flags_op;
+    fpu_unwind_restore(dyn, ninst, &cache);
+    MESSAGE(LOG_DUMP, "\t---- Suspend doorbell\n");
+}
+
+void doorbell_begin(dynarec_arm_t* dyn)
+{
+    doorbell_nsites = 0;
+}
+
+void doorbell_check(dynarec_arm_t* dyn, int ninst, uintptr_t ip)
+{
+    _Static_assert(offsetof(x64emu_t, suspend_doorbell) < 4096 * 4, "suspend_doorbell out of LDRw_U12 range");
+    int site = 0;
+    while(site<doorbell_nsites && doorbell_sites[site].ninst!=ninst)
+        ++site;
+    if(site==doorbell_nsites && site<DOORBELL_SITES)
+        ++doorbell_nsites;
+    MESSAGE(LOG_DUMP, "\tSuspend doorbell check\n");
+    LDRw_U12(x1, xEmu, offsetof(x64emu_t, suspend_doorbell));
+    if(site<DOORBELL_SITES) {
+        CBNZw(x1, dyn->insts[ninst].doorbell_stub - dyn->native_size);
+        dyn->insts[ninst].doorbell_back = dyn->native_size;
+        doorbell_sites[site].ninst = ninst;
+        doorbell_sites[site].ip = ip;
+        doorbell_sites[site].f = dyn->f;
+        doorbell_sites[site].ymm_zero = dyn->ymm_zero;
+        doorbell_sites[site].n = dyn->n;
+    } else {
+        CBZw(x1, dyn->insts[ninst].doorbell_back - dyn->native_size);
+        doorbell_slowpath(dyn, ninst, ip, dyn->insts[ninst].doorbell_back);
+        dyn->insts[ninst].doorbell_back = dyn->native_size;
+    }
+}
+
+// after the block's code (accounted as its end, ninst): the slow paths of the checks
+void doorbell_end(dynarec_arm_t* dyn, int ninst)
+{
+    for(int i=0; i<doorbell_nsites; ++i) {
+        doorbell_site_t* site = &doorbell_sites[i];
+        instruction_native_t* inst = &dyn->insts[site->ninst];
+        neoncache_t n = dyn->n;
+        flagcache_t f = dyn->f;
+        uint16_t ymm_zero = dyn->ymm_zero;
+        int size = inst->size, size2 = inst->size2;
+        dyn->n = site->n;
+        dyn->f = site->f;
+        dyn->ymm_zero = site->ymm_zero;
+        inst->doorbell_stub = dyn->native_size;
+        doorbell_slowpath(dyn, site->ninst, site->ip, inst->doorbell_back);
+        dyn->insts[ninst].size += inst->size - size;
+        dyn->insts[ninst].size2 += inst->size2 - size2;
+        inst->size = size;
+        inst->size2 = size2;
+        dyn->n = n;
+        dyn->f = f;
+        dyn->ymm_zero = ymm_zero;
+    }
+}
