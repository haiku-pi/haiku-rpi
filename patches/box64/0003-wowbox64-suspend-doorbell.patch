+/* the x86 flags the translated code keeps in the host's NZCV at a suspend point (natflags: SUSPEND_NZCV_*) */
+static void nzcv_to_flags(x64emu_t* emu, uint64_t nzcv, uint32_t natflags)
+{
+    int c = !!(nzcv & (1u << 29));
+
+    if (natflags & SUSPEND_NZCV_ZF) CONDITIONAL_SET_FLAG(nzcv & (1u << 30), F_ZF);
+    if (natflags & SUSPEND_NZCV_SF) CONDITIONAL_SET_FLAG(nzcv & (1u << 31), F_SF);
+    if (natflags & SUSPEND_NZCV_OF) CONDITIONAL_SET_FLAG(nzcv & (1u << 28), F_OF);
+    if (natflags & SUSPEND_NZCV_PF) CONDITIONAL_SET_FLAG(nzcv & (1u << 28), F_PF);
+    if (natflags & SUSPEND_NZCV_CF) CONDITIONAL_SET_FLAG((natflags & SUSPEND_NZCV_CF_NORMAL) ? c : !c, F_CF);
+}
+
+int wow64_suspend_point(x64emu_t* emu, uintptr_t ip, uint64_t nzcv, uint32_t natflags)
+{
+    WOW64_CPURESERVED* cpu = NtCurrentTeb()->TlsSlots[WOW64_TLS_CPURESERVED];
+    WOW64_CONTEXT* ctx = (WOW64_CONTEXT*)(cpu + 1);
+    WOW64_CONTEXT written;
+    // translated code goes on with emu as it is (deferred flags included): the flags are worked out on a copy
+    x64emu_t state = *emu;
+
+    state.ip.q[0] = ip;
+    CHECK_FLAGS((&state));
+    nzcv_to_flags(&state, nzcv, natflags);
+    emu_to_context(&state, ctx);
+    written = *ctx;
+
+    leave_simulation();
+    enter_simulation();
+
+    // the suspender may have changed the context (SetThreadContext): then go on from there
+    if (!memcmp(&written.Dr0, &ctx->Dr0, sizeof(written) - offsetof(WOW64_CONTEXT, Dr0)))
+        return 0;
+    printf_log(LOG_DEBUG, "context changed while suspended at %p, going on at %p\n", (void*)ip, ULongToPtr(ctx->Eip));
+    RESET_FLAGS(emu);   // the flags are the context's now (emu is not copied back from state: not its doorbell)
+    context_to_emu(ctx, emu);
+    return 1;
+}
