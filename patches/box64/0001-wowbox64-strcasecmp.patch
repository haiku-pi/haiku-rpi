+/* POSIX, not in the Windows C runtime (src/tools/env.c uses it) */
+int strcasecmp(const char* a, const char* b)
+{
+    for (;; a++, b++) {
+        int ca = (unsigned char)*a, cb = (unsigned char)*b;
+        if (ca >= 'A' && ca <= 'Z') ca += 'a' - 'A';
+        if (cb >= 'A' && cb <= 'Z') cb += 'a' - 'A';
+        if (ca != cb || !ca) return ca - cb;
+    }
+}
