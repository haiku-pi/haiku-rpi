+// A video picture shown on a hardware overlay plane of the window's view
+// instead of being composited in software. WebRender's SwCompositor offers the
+// largest planar YUV compositor surface of each frame (RenderCompositorSWGL::
+// PresentOnPlane); if accepted, the planes are copied into a B_YUV420 overlay
+// bitmap shown with BView::SetViewOverlay(), and SwCompositor fills the
+// surface's rectangle with the overlay's colour key, through which app_server
+// shows the plane. Anything drawn over the video covers the plane. Otherwise
+// (moving, partly visible, no free plane, a mode change, ...) the frame is
+// composited in software, and the plane is left once that frame is drawn.
+//
+// Render thread: Present(), Decline(), EndFrame(); main thread: Destroy().
+// MOZ_HAIKU_VIDEO_OVERLAY=0 turns it off; MOZ_HAIKU_VIDEO_OVERLAY_LOG=1 prints
+// the plane's state changes and counters (stderr, every 2 s).
+class HaikuVideoOverlay final {
+ public:
+  struct Plane {
+    const uint8_t* mData;
+    int32_t mStride;
+    int32_t mWidth;
+    int32_t mHeight;
+  };
+
+  // Why a frame's video was not shown on the plane (counted for the log).
+  enum class Reason : uint8_t {
+    Disabled,     // MOZ_HAIKU_VIDEO_OVERLAY=0
+    NotWhole,     // partly visible, flipped, or a rounded clip
+    Cropped,      // only part of the picture shown
+    Format,       // not 8-bit planar 4:2:0 YUV
+    ColorSpace,   // an encoding the plane does not show right (BT.2020, full-
+                  // range BT.709)
+    Unstable,     // the rectangle changed in the last frame (scrolling)
+    NoPlane,      // no overlay bitmaps (no free plane or memory)
+    Suspended,    // overlays suspended (mode change)
+    Window,       // the window could not be locked, or SetViewOverlay failed
+    NotOffered,   // a composite without a planar YUV surface (or not offered)
+    Count
+  };
+
+  // The YCbCr encoding of a picture, as the plane can show it (limited range
+  // unless named).
+  enum class Encoding : uint8_t { BT601, BT601Full, BT709 };
+
+  explicit HaikuVideoOverlay(nsWindow* aWindow);
+  ~HaikuVideoOverlay();
+
+  // A picture of WIDTHxHEIGHT (aPlanes: Y, Cb, Cr) in aEncoding to show at
+  // aDst (view coordinates); aImageId identifies the picture (an unchanged
+  // picture is not copied again). True: shown, *aKey is the BGRA8 key to fill
+  // aDst with.
+  bool Present(uint64_t aImageId, const Plane aPlanes[3], Encoding aEncoding,
+               const LayoutDeviceIntRect& aDst, uint32_t* aKey);
+  void Decline(Reason aReason);
+  // After the window drew a frame (aDrawn: the bounds of what it drew, empty
+  // if nothing): with aComposited (a composite ran) and no picture presented
+  // in it, the plane is left once aDrawn covered its rectangle.
+  void EndFrame(bool aComposited, const LayoutDeviceIntRect& aDrawn);
+
+  void Destroy();
+
+ private:
+  bool EnsureBitmaps(int32_t aWidth, int32_t aHeight);
+  void Release(bool aClearView);
+  void Log(const char* aWhat);
+
+  nsWindow* mWindow;
+  Mutex mLock MOZ_UNANNOTATED;
+  bool mEnabled;
+  bool mLog;
+  bool mDestroyed = false;
+
+  static constexpr int kBitmaps = 3;
+  BBitmap* mBitmaps[kBitmaps] = {};
+  int32_t mWidth = 0;
+  int32_t mHeight = 0;
+  int mNext = 0;          // the bitmap filled next
+  bool mShown = false;    // SetViewOverlay done
+  Encoding mEncoding = Encoding::BT601;  // of the picture shown
+  bool mPresented = false;  // a picture presented this frame
+  bool mOffered = false;    // Present() or Decline() this frame
+  int mIdleFrames = 0;      // composites without a picture while shown
+  uint64_t mShownImage = 0;
+  LayoutDeviceIntRect mShownRect;
+  LayoutDeviceIntRect mLastOffered;
+  int mStableFrames = 0;
+  uint32_t mKey = 0xff005000;  // {0, 80, 0}, app_server's key; updated
+  int64_t mRetryAt = 0;  // after a failed allocation or LockBits()
+  int64_t mLeftAt = 0;   // when the plane was last left
+
+  // counters for the log
+  uint32_t mPlaneFrames = 0;
+  uint32_t mSameFrames = 0;
+  uint32_t mDeclined[size_t(Reason::Count)] = {};
+  uint32_t mWindowFrames = 0;  // composites that drew into the window
+  uint32_t mCleanFrames = 0;   // composites that drew nothing
+  uint32_t mShows = 0;
+  uint32_t mHides = 0;
+  int64_t mLastLog = 0;
+};
+
+}  // namespace mozilla::widget
