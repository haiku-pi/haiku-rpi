+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuVideoOverlay.h"
+
+#include <Bitmap.h>
+#include <OS.h>
+#include <View.h>
+#include <Window.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nsWindow.h"
+
+namespace mozilla::widget {
+
+static const char* const kReasonNames[] = {
+    "disabled", "not-whole", "cropped", "format", "colour-space",
+    "unstable", "no-plane", "suspended", "window", "not-offered"};
+static_assert(sizeof(kReasonNames) / sizeof(kReasonNames[0]) ==
+              size_t(HaikuVideoOverlay::Reason::Count));
+
+// SetViewOverlay() options naming the picture's YCbCr encoding: InterfaceDefs.h's
+// B_OVERLAY_YCbCr_BT601, _BT709 and _FULL_RANGE (haiku-pi rpi4 since
+// 552c42233d; the build's headers may predate them). An older app_server
+// ignores them and the display guesses (BT.709 from 720 lines on, BT.601
+// below, limited range).
+static const uint32 kOverlayYCbCrBT601 = 0x00100000;
+static const uint32 kOverlayYCbCrBT709 = 0x00200000;
+static const uint32 kOverlayYCbCrFullRange = 0x00400000;
+
+static uint32 EncodingOptions(HaikuVideoOverlay::Encoding aEncoding) {
+  using Encoding = HaikuVideoOverlay::Encoding;
+  switch (aEncoding) {
+    case Encoding::BT601:
+      return kOverlayYCbCrBT601;
+    case Encoding::BT601Full:
+      return kOverlayYCbCrBT601 | kOverlayYCbCrFullRange;
+    case Encoding::BT709:
+      return kOverlayYCbCrBT709;
+  }
+  return 0;
+}
+
+static const char* const kEncodingNames[] = {"bt601", "bt601-full", "bt709"};
+
+// a window lock taken from the render thread: never wait long for it
+static const bigtime_t kLockTimeout = 100000;
+// after a failed allocation or LockBits(): software for this long
+static const bigtime_t kRetryDelay = 1000000;
+// the rectangle unchanged for this many frames before the plane is used; for
+// more within a second after the plane was left for a move (a scroll in small
+// steps would otherwise show and hide it every few frames)
+static const int kStableFrames = 2;
+static const int kSettleFrames = 15;
+static const bigtime_t kSettleDelay = 1000000;
+
+HaikuVideoOverlay::HaikuVideoOverlay(nsWindow* aWindow)
+    : mWindow(aWindow), mLock("HaikuVideoOverlay::mLock") {
+  const char* enabled = getenv("MOZ_HAIKU_VIDEO_OVERLAY");
+  mEnabled = !enabled || strcmp(enabled, "0") != 0;
+  const char* log = getenv("MOZ_HAIKU_VIDEO_OVERLAY_LOG");
+  mLog = log && strcmp(log, "0") != 0;
+}
+
+HaikuVideoOverlay::~HaikuVideoOverlay() { Destroy(); }
+
+void HaikuVideoOverlay::Log(const char* aWhat) {
+  if (!mLog) {
+    return;
+  }
+  char declined[256];
+  size_t used = 0;
+  declined[0] = '\0';
+  for (size_t i = 0; i < size_t(Reason::Count); i++) {
+    if (mDeclined[i] && used < sizeof(declined)) {
+      used += snprintf(declined + used, sizeof(declined) - used, " %s %u",
+                       kReasonNames[i], mDeclined[i]);
+    }
+  }
+  fprintf(stderr,
+          "HVO %s: plane %u same %u shows %u hides %u; window frames %u clean %u;"
+          " %dx%d %s at %d,%d %dx%d; software:%s\n",
+          aWhat, mPlaneFrames, mSameFrames, mShows, mHides, mWindowFrames,
+          mCleanFrames, mWidth, mHeight, kEncodingNames[size_t(mEncoding)],
+          mShownRect.x, mShownRect.y, mShownRect.width, mShownRect.height,
+          used ? declined : " 0");
+}
+
+bool HaikuVideoOverlay::EnsureBitmaps(int32_t aWidth, int32_t aHeight) {
+  if (mBitmaps[0] && mWidth == aWidth && mHeight == aHeight) {
+    return true;
+  }
+  Release(true);
+  const BRect bounds(0, 0, aWidth - 1, aHeight - 1);
+  for (int i = 0; i < kBitmaps; i++) {
+    // the first reserves the overlay channel; the others take it over when
+    // SetViewOverlay() transfers it to them
+    mBitmaps[i] = new BBitmap(
+        bounds,
+        B_BITMAP_WILL_OVERLAY | (i == 0 ? B_BITMAP_RESERVE_OVERLAY_CHANNEL : 0),
+        B_YUV420);
+    if (mBitmaps[i]->InitCheck() != B_OK) {
+      Release(false);
+      return false;
+    }
+  }
+  mWidth = aWidth;
+  mHeight = aHeight;
+  mNext = 0;
+  return true;
+}
+
+// Hides the plane (aClearView: the view's overlay is cleared first) and frees
+// the bitmaps, which gives the plane and its memory back.
+void HaikuVideoOverlay::Release(bool aClearView) {
+  if (mShown && aClearView) {
+    auto* window = static_cast<BWindow*>(mWindow->GetNativeData(NS_NATIVE_WINDOW));
+    auto* view = static_cast<BView*>(mWindow->GetNativeData(NS_NATIVE_WIDGET));
+    if (window && view && window->LockWithTimeout(kLockTimeout) == B_OK) {
+      view->ClearViewOverlay();
+      window->Unlock();
+    }
+  }
+  if (mShown) {
+    mHides++;
+    mLeftAt = system_time();
+  }
+  mShown = false;
+  mShownImage = 0;
+  for (auto& bitmap : mBitmaps) {
+    delete bitmap;
+    bitmap = nullptr;
+  }
+  mWidth = mHeight = 0;
+}
+
+void HaikuVideoOverlay::Decline(Reason aReason) {
+  MutexAutoLock lock(mLock);
+  mOffered = true;
+  mDeclined[size_t(aReason)]++;
+}
+
+bool HaikuVideoOverlay::Present(uint64_t aImageId, const Plane aPlanes[3],
+                                Encoding aEncoding,
+                                const LayoutDeviceIntRect& aDst,
+                                uint32_t* aKey) {
+  MutexAutoLock lock(mLock);
+  if (mDestroyed) {
+    return false;
+  }
+  mOffered = true;
+  auto decline = [&](Reason aReason) {
+    mDeclined[size_t(aReason)]++;
+    return false;
+  };
+  if (!mEnabled) {
+    return decline(Reason::Disabled);
+  }
+  // The key goes out with the window's drawing, the plane moves at the next
+  // vertical blank: while the rectangle moves, composite in software.
+  if (!aDst.IsEqualEdges(mLastOffered)) {
+    mLastOffered = aDst;
+    mStableFrames = 0;
+  }
+  mStableFrames++;
+  const bigtime_t now = system_time();
+  const int stableNeeded =
+      now - mLeftAt < kSettleDelay ? kSettleFrames : kStableFrames;
+  if (!(mShown && aDst.IsEqualEdges(mShownRect)) &&
+      mStableFrames < stableNeeded) {
+    return decline(Reason::Unstable);
+  }
+  if (now < mRetryAt) {
+    return decline(Reason::NoPlane);
+  }
+
+  // the same picture again (the frame was composited for something else)
+  if (mShown && aImageId == mShownImage && aEncoding == mEncoding &&
+      aDst.IsEqualEdges(mShownRect)) {
+    mSameFrames++;
+    mPresented = true;
+    *aKey = mKey;
+    return true;
+  }
+
+  const int32_t width = aPlanes[0].mWidth;
+  const int32_t height = aPlanes[0].mHeight;
+  if (!EnsureBitmaps(width, height)) {
+    mRetryAt = now + kRetryDelay;
+    return decline(Reason::NoPlane);
+  }
+  BBitmap* bitmap = mBitmaps[mNext];
+  // fails while app_server has the overlays suspended (a mode change)
+  if (bitmap->LockBits() != B_OK) {
+    mRetryAt = now + kRetryDelay;
+    return decline(Reason::Suspended);
+  }
+  // B_YUV420 (planar I420): BytesPerRow() is the whole picture's, the luma rows
+  // are 2/3 of it, Cb and Cr follow the luma with rows of 1/3
+  uint8_t* bits = static_cast<uint8_t*>(bitmap->Bits());
+  const int32_t luma = bitmap->BytesPerRow() / 3 * 2;
+  const int32_t chroma = luma / 2;
+  uint8_t* dst[3] = {bits, bits + luma * height,
+                     bits + luma * height + chroma * (height / 2)};
+  const int32_t pitch[3] = {luma, chroma, chroma};
+  for (int p = 0; p < 3; p++) {
+    const uint8_t* src = aPlanes[p].mData;
+    const int32_t rowBytes = p == 0 ? width : width / 2;
+    const int32_t rows = p == 0 ? height : height / 2;
+    for (int32_t y = 0; y < rows; y++) {
+      memcpy(dst[p] + y * pitch[p], src + y * aPlanes[p].mStride, rowBytes);
+    }
+  }
+  bitmap->UnlockBits();
+
+  auto* window = static_cast<BWindow*>(mWindow->GetNativeData(NS_NATIVE_WINDOW));
+  auto* view = static_cast<BView*>(mWindow->GetNativeData(NS_NATIVE_WIDGET));
+  if (!window || !view || window->LockWithTimeout(kLockTimeout) != B_OK) {
+    return decline(Reason::Window);
+  }
+  // The first call configures the plane, under the desktop until the key
+  // reaches the window (after this frame's composite); later ones flip it at
+  // the next vertical blank. Each one names the picture's encoding.
+  const BRect dstRect(aDst.x, aDst.y, aDst.XMost() - 1, aDst.YMost() - 1);
+  rgb_color key;
+  const status_t status = view->SetViewOverlay(
+      bitmap, bitmap->Bounds(), dstRect, &key, B_FOLLOW_LEFT_TOP,
+      B_OVERLAY_FILTER_HORIZONTAL | B_OVERLAY_FILTER_VERTICAL |
+          EncodingOptions(aEncoding) |
+          (mShown ? B_OVERLAY_TRANSFER_CHANNEL : 0));
+  window->Unlock();
+  if (status != B_OK) {
+    if (!mShown) {
+      // no plane to be had now: free the bitmaps, try again later
+      Release(false);
+      mRetryAt = now + kRetryDelay;
+    }
+    return decline(Reason::Window);
+  }
+  mKey = 0xff000000u | uint32_t(key.red) << 16 | uint32_t(key.green) << 8 |
+         key.blue;
+  const bool encodingChanged = mShown && aEncoding != mEncoding;
+  mEncoding = aEncoding;
+  if (!mShown) {
+    mShown = true;
+    mShows++;
+    mShownRect = aDst;
+    Log("show");
+  } else if (encodingChanged) {
+    Log("encoding");
+  }
+  mShownImage = aImageId;
+  mNext = (mNext + 1) % kBitmaps;
+  mPlaneFrames++;
+  mPresented = true;
+  *aKey = mKey;
+  return true;
+}
+
+void HaikuVideoOverlay::EndFrame(bool aComposited,
+                                 const LayoutDeviceIntRect& aDrawn) {
+  MutexAutoLock lock(mLock);
+  if (mDestroyed || !aComposited) {
+    return;
+  }
+  if (aDrawn.IsEmpty()) {
+    mCleanFrames++;
+  } else {
+    mWindowFrames++;
+  }
+  if (!mOffered) {
+    mDeclined[size_t(Reason::NotOffered)]++;
+  }
+  if (mPresented) {
+    mIdleFrames = 0;
+  } else if (mShown || mBitmaps[0]) {
+    // The frame went in software. Leave the plane once the window drew that
+    // frame over its rectangle (the key would show green otherwise); a plane
+    // unused for long goes in any case.
+    if (aDrawn.Contains(mShownRect) || !mShown || ++mIdleFrames > 60) {
+      const bool shown = mShown;
+      Release(true);
+      mIdleFrames = 0;
+      if (shown) {
+        Log("hide");
+      }
+    }
+  }
+  mPresented = false;
+  mOffered = false;
+  const bigtime_t now = system_time();
+  if (mLog && now - mLastLog >= 2000000) {
+    mLastLog = now;
+    Log("stats");
+  }
+}
+
+void HaikuVideoOverlay::Destroy() {
+  MutexAutoLock lock(mLock);
+  if (mDestroyed) {
+    return;
+  }
+  Release(true);
+  mDestroyed = true;
+}
+
