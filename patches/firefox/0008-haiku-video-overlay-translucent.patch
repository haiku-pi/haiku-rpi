+    /// Whether a surface composited above surface `id` (later in the frame) has translucent pixels
+    /// (alpha neither 0 nor 255) within `rect`, or is being updated there this frame. A tile's
+    /// answer is kept until the tile changes (invalidate_tile), so a still page is checked once.
+    fn translucent_over(&self, id: NativeSurfaceId, rect: &DeviceIntRect) -> bool {
+        let mut above = false;
+        for &(sid, ref transform, ref clip_rect, _) in &self.frame_surfaces {
+            if sid == id {
+                above = true;
+                continue;
+            }
+            if !above || !clip_rect.intersects(rect) {
+                continue;
+            }
+            let surface = match self.surfaces.get(&sid) {
+                Some(surface) if surface.external_image.is_none() => surface,
+                _ => continue,
+            };
+            for tile in &surface.tiles {
+                let (src, dst, _, _) = match tile.composite_rects(surface, transform, clip_rect) {
+                    Some(rects) => rects,
+                    None => continue,
+                };
+                let overlap = match dst.intersection(rect) {
+                    Some(overlap) => overlap,
+                    None => continue,
+                };
+                if tile.invalid.get() {
+                    return true;
+                }
+                if let Some((checked, translucent)) = tile.translucent.get() {
+                    if checked == overlap {
+                        if translucent {
+                            return true;
+                        }
+                        continue;
+                    }
+                }
+                // the overlap in the tile's texture: exact when unscaled, else the whole tile
+                let src_overlap = if dst.size() == src.size() {
+                    overlap.translate(src.min - dst.min)
+                } else {
+                    src
+                };
+                let translucent = match self.gl.lock_texture(tile.color_id) {
+                    Some(texture) => {
+                        let (buf, width, height, stride) = texture.get_buffer();
+                        if buf.is_null() {
+                            true
+                        } else {
+                            let mut found = false;
+                            'rows: for y in src_overlap.min.y.max(0)..src_overlap.max.y.min(height) {
+                                let row = unsafe { (buf as *const u8).offset(y as isize * stride as isize) };
+                                for x in src_overlap.min.x.max(0)..src_overlap.max.x.min(width) {
+                                    let alpha = unsafe { *row.offset(x as isize * 4 + 3) };
+                                    if alpha != 0 && alpha != 255 {
+                                        found = true;
+                                        break 'rows;
+                                    }
+                                }
+                            }
+                            found
+                        }
+                    }
+                    None => true,
+                };
+                tile.translucent.set(Some((overlap, translucent)));
+                if translucent {
+                    return true;
+                }
+            }
+        }
+        false
+    }
