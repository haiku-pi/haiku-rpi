+already_AddRefed<GLContext> GLContextProviderBGL::CreateHeadless(
+    const GLContextCreateDesc& aDesc, nsACString* const aOutFailureId) {
+  BAutolock lock(sBGLGlobalLock);
+
+  EnsureBGLDisplayKeeper();
+
+  if (!sGLLibrary) {
+    sGLLibrary = LoadGLLibrary();
+    if (!sGLLibrary) {
+      NS_WARNING("Failed to load libGL.so on Haiku!");
+      *aOutFailureId = "FEATURE_FAILURE_LIBGL_LOAD"_ns;
+      return nullptr;
+    }
+  }
+
+  ulong options = BGL_RGB | BGL_ALPHA | BGL_DEPTH | BGL_DOUBLE;
+  RefPtr<GLContextBGL> gl = CreateOffscreenBGL(aDesc, options, aOutFailureId);
+  if (!gl) {
+    return nullptr;
+  }
+
+#ifdef BGL_CONTEXT_ES
+  // WebGL needs GLSL 1.50 from a desktop context, or OpenGL ES 3: GPUs whose
+  // desktop OpenGL stops short of 3.2 (the Raspberry Pi 4's V3D: 2.1 here,
+  // 3.1 at most) have ES 3
+  if (!gl->IsGLES() && gl->ShadingLanguageVersion() < 150) {
+    nsAutoCString esFailureId;
+    RefPtr<GLContextBGL> es =
+        CreateOffscreenBGL(aDesc, options | BGL_CONTEXT_ES, &esFailureId);
+    if (es && es->IsGLES()) {
+      gl = es;
+    }
+  }
+#endif
 
