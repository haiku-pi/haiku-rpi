+/*
+ * phaiku.cpp
+ * Haiku BTimeZone wrapper
+ */
+
+/* In-tree builds compile everything with hidden visibility (config/gcc_hidden.h):
+ * libbe's classes must keep the default. */
+#pragma GCC visibility push(default)
+#include <TimeZone.h>
+#pragma GCC visibility pop
+#include "prtypes.h"
+#include "prtime.h"
+
+extern "C" {
+
+PRStatus _PR_Haiku_GetLocalTimeOffset(PRInt32* aGmtOffset, PRInt32* aDstOffset) {
+  if (!aGmtOffset || !aDstOffset) {
+    return PR_FAILURE;
+  }
+
+  BTimeZone tz;
+  if (tz.InitCheck() != B_OK) {
+    return PR_FAILURE;
+  }
+
+  *aGmtOffset = static_cast<PRInt32>(tz.OffsetFromGMT());
+  *aDstOffset = 0;
+
+  return PR_SUCCESS;
+}
+
+} // extern "C"
