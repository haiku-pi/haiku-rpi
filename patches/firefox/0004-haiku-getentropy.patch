Haiku: GenerateRandomBytesFromOS() with getentropy()

On Haiku it opened, read and closed /dev/urandom for every request; getentropy() is one system
call (and the kernel random device behind both is fast since haiku-pi 67b972b5e1). 140-200 ms of
CPU per Firefox launch on a Raspberry Pi 4 were spent there.

--- a/mfbt/RandomNum.cpp	2026-10-24 15:16:32.700998552 +0200
+++ b/mfbt/RandomNum.cpp	2026-10-24 15:16:32.702337212 +0200
@@ -103,6 +103,28 @@
 
 #  endif  // defined(__linux__)
 
+#  if defined(XP_HAIKU)
+
+  // getentropy() is a system call; opening /dev/urandom for each request
+  // costs more than the read. It returns at most 256 bytes per call.
+  uint8_t* bytes = static_cast<uint8_t*>(aBuffer);
+  size_t left = aLength;
+  while (left > 0) {
+    size_t chunk = left < 256 ? left : 256;
+    if (getentropy(bytes, chunk) != 0) {
+      break;
+    }
+    bytes += chunk;
+    left -= chunk;
+  }
+  if (left == 0) {
+    return true;
+  }
+
+  // Fall-through to UNIX behavior if failed
+
+#  endif  // defined(XP_HAIKU)
+
   int fd = open("/dev/urandom", O_RDONLY);
   if (fd < 0) {
     return false;
