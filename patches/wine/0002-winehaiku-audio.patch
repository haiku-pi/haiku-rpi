+static const REFERENCE_TIME def_period = 100000;
+static const REFERENCE_TIME min_period = 50000;
+
+static const char default_device[] = "default";
+
+static ULONG_PTR zero_bits = 0;
+
+static NTSTATUS haiku_not_implemented(void *args)
+{
+    return STATUS_SUCCESS;
+}
+
+/* copied from kernelbase */
+static int muldiv( int a, int b, int c )
+{
+    LONGLONG ret;
+
+    if (!c) return -1;
+
+    /* We want to deal with a positive divisor to simplify the logic. */
+    if (c < 0)
+    {
+        a = -a;
+        c = -c;
+    }
+
+    /* If the result is positive, we "add" to round. else, we subtract to round. */
+    if ((a < 0 && b < 0) || (a >= 0 && b >= 0))
+        ret = (((LONGLONG)a * b) + (c / 2)) / c;
+    else
+        ret = (((LONGLONG)a * b) - (c / 2)) / c;
+
+    if (ret > 2147483647 || ret < -2147483647) return -1;
+    return ret;
+}
+
+static void haiku_lock(struct haiku_stream *stream)
+{
+    pthread_mutex_lock(&stream->lock);
+}
+
+static void haiku_unlock(struct haiku_stream *stream)
+{
+    pthread_mutex_unlock(&stream->lock);
+}
+
+static NTSTATUS haiku_unlock_result(struct haiku_stream *stream,
+                                    HRESULT *result, HRESULT value)
+{
+    *result = value;
+    haiku_unlock(stream);
+    return STATUS_SUCCESS;
+}
+
+static struct haiku_stream *handle_get_stream(stream_handle h)
+{
+    return (struct haiku_stream *)(UINT_PTR)h;
+}
