--- wine-ref/dlls/winehaiku.drv/haiku_player.h	1970-01-01 01:00:00.000000000 +0100
+++ wine-haiku/dlls/winehaiku.drv/haiku_player.h	2026-10-21 16:38:07.725407621 +0200
@@ -0,0 +1,72 @@
+/*
+ * Haiku Media Kit sound player, a C interface to BSoundPlayer
+ *
+ * Copyright 2026 Witold Bołt
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* The Media Kit is C++ and makedep compiles no C++, so haiku_player.cpp is built
+ * on its own (with the Haiku C++ compiler, into a static library that configure
+ * is given in HAIKU_AUDIO_LIBS) and haiku.c talks to it through this header.
+ * Neither Windows nor Be types appear here: the two cannot share a source file. */
+
+#ifndef __WINE_HAIKU_PLAYER_H
+#define __WINE_HAIKU_PLAYER_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum haiku_sample_format
+{
+    HAIKU_SAMPLE_U8,
+    HAIKU_SAMPLE_S16,
+    HAIKU_SAMPLE_S32,
+    HAIKU_SAMPLE_FLOAT
+};
+
+struct haiku_player;
+
+/* Called on a Media Kit thread (no Wine TEB) to fill a buffer of the player's format. */
+typedef void (*haiku_player_fill)(void *user, void *buffer, size_t size);
+
+/* Nonzero when the media server runs. */
+int haiku_audio_available(void);
+
+/* The name of the system's audio output node; 0 when there is none. */
+int haiku_audio_output_name(char *name, size_t size);
+
+/* A player connected to the system mixer, stopped; NULL on failure. buffer_size is in bytes. */
+struct haiku_player *haiku_player_create(const char *name, unsigned int rate, unsigned int channels,
+                                         enum haiku_sample_format format, size_t buffer_size,
+                                         haiku_player_fill fill, void *user);
+
+/* 0 on success. */
+int haiku_player_start(struct haiku_player *player);
+
+/* Stops the player and waits until it calls its fill function no more. */
+void haiku_player_destroy(struct haiku_player *player);
+
+/* The latency from the player to the audio output, in microseconds. */
+long long haiku_player_latency(struct haiku_player *player);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __WINE_HAIKU_PLAYER_H */
