+static NTSTATUS haiku_set_event_handle(void *args)
+{
+    struct set_event_handle_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+
+    haiku_lock(stream);
+
+    if(!(stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK))
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_EVENTHANDLE_NOT_EXPECTED);
+
+    if (stream->event){
+        FIXME("called twice\n");
+        return haiku_unlock_result(stream, &params->result, HRESULT_FROM_WIN32(ERROR_INVALID_NAME));
+    }
+
+    stream->event = params->event;
+
+    return haiku_unlock_result(stream, &params->result, S_OK);
+}
