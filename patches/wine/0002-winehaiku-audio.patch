+static UINT no_device_message(UINT msg)
+{
+    switch (msg)
+    {
+    case DRVM_INIT:
+    case DRVM_EXIT:
+    case DRVM_ENABLE:
+    case DRVM_DISABLE:
+    case MODM_GETNUMDEVS:
+    case MIDM_GETNUMDEVS:
+    case AUXDM_GETNUMDEVS:
+        return 0;
+    }
+    return MMSYSERR_BADDEVICEID;
+}
