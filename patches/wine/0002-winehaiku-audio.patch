+static NTSTATUS haiku_test_connect(void *args)
+{
+    struct test_connect_params *params = args;
+
+    if(haiku_audio_available()){
+        TRACE("Priority_Preferred: the media server runs\n");
+        params->priority = Priority_Preferred;
+    }else{
+        TRACE("Priority_Unavailable: the media server does not run\n");
+        params->priority = Priority_Unavailable;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_process_attach(void *args)
+{
+#ifdef _WIN64
+    if (NtCurrentTeb()->WowTebOffset)
+    {
+        SYSTEM_BASIC_INFORMATION info;
+
+        NtQuerySystemInformation(SystemEmulationBasicInformation, &info, sizeof(info), NULL);
+        zero_bits = (ULONG_PTR)info.HighestUserAddress | 0x7fffffff;
+    }
+#endif
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_main_loop(void *args)
+{
+    struct main_loop_params *params = args;
+    NtSetEvent(params->event, NULL);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_get_endpoint_ids(void *args)
+{
+    struct get_endpoint_ids_params *params = args;
+    char output_name[64]; /* B_MEDIA_NAME_LENGTH */
+    WCHAR name[ARRAY_SIZE(output_name)];
+    unsigned int name_len, device_len, needed, offset;
+
+    params->num = 0;
+    params->default_idx = 0;
+
+    /* TODO: capture (BMediaRecorder) */
+    if(params->flow != eRender){
+        params->result = S_OK;
+        return STATUS_SUCCESS;
+    }
+
+    if(!haiku_audio_available()){
+        ERR("The media server does not run\n");
+        params->result = AUDCLNT_E_SERVICE_NOT_RUNNING;
+        return STATUS_SUCCESS;
+    }
+
+    /* the player always plays through the system mixer: one endpoint, named after its output */
+    if(!haiku_audio_output_name(output_name, sizeof(output_name)))
+        strcpy(output_name, "Haiku Media Kit");
+    ntdll_umbstowcs(output_name, strlen(output_name) + 1, name, ARRAY_SIZE(name));
+    name[ARRAY_SIZE(name) - 1] = 0;
+
+    name_len = wcslen(name) + 1;
+    device_len = sizeof(default_device);
+    offset = needed = sizeof(*params->endpoints);
+    needed += name_len * sizeof(WCHAR) + ((device_len + 1) & ~1);
+
+    if(needed > params->size){
+        params->size = needed;
+        params->num = 1;
+        params->result = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+        return STATUS_SUCCESS;
+    }
+
+    params->endpoints[0].name = offset;
+    memcpy((char *)params->endpoints + offset, name, name_len * sizeof(WCHAR));
+    offset += name_len * sizeof(WCHAR);
+    params->endpoints[0].device = offset;
+    memcpy((char *)params->endpoints + offset, default_device, device_len);
+
+    params->num = 1;
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static UINT get_channel_mask(unsigned int channels)
+{
+    switch(channels){
+    case 0:
+        return 0;
+    case 1:
+        return KSAUDIO_SPEAKER_MONO;
+    case 2:
+        return KSAUDIO_SPEAKER_STEREO;
+    case 3:
+        return KSAUDIO_SPEAKER_STEREO | SPEAKER_LOW_FREQUENCY;
+    case 4:
+        return KSAUDIO_SPEAKER_QUAD;    /* not _SURROUND */
+    case 5:
+        return KSAUDIO_SPEAKER_QUAD | SPEAKER_LOW_FREQUENCY;
+    case 6:
+        return KSAUDIO_SPEAKER_5POINT1; /* not 5POINT1_SURROUND */
+    case 7:
+        return KSAUDIO_SPEAKER_5POINT1 | SPEAKER_BACK_CENTER;
+    case 8:
+        return KSAUDIO_SPEAKER_7POINT1_SURROUND; /* Vista deprecates 7POINT1 */
+    }
+    FIXME("Unknown speaker configuration: %u\n", channels);
+    return 0;
+}
+
+/* the sample formats the system mixer takes */
+static int get_sample_format(const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_PCM ||
+            (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+             IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM))){
+        switch(fmt->wBitsPerSample){
+        case 8:
+            return HAIKU_SAMPLE_U8;
+        case 16:
+            return HAIKU_SAMPLE_S16;
+        case 32:
+            return HAIKU_SAMPLE_S32;
+        }
+        return -1;
+    }
+
+    if(fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ||
+            (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+             IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT))){
+        if(fmt->wBitsPerSample != 32)
+            return -1;
+
+        return HAIKU_SAMPLE_FLOAT;
+    }
+
+    return -1;
+}
+
+static WAVEFORMATEXTENSIBLE *clone_format(const WAVEFORMATEX *fmt)
+{
+    WAVEFORMATEXTENSIBLE *ret;
+    size_t size;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+        size = sizeof(WAVEFORMATEXTENSIBLE);
+    else
+        size = sizeof(WAVEFORMATEX);
+
+    ret = malloc(size);
+    if(!ret)
+        return NULL;
+
+    memcpy(ret, fmt, size);
+
+    ret->Format.cbSize = size - sizeof(WAVEFORMATEX);
+
+    return ret;
+}
+
+static HRESULT check_format(AUDCLNT_SHAREMODE share, const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+    HRESULT ret = S_OK;
+
+    if(get_sample_format(fmt) < 0)
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+            (fmtex->Format.nAvgBytesPerSec == 0 ||
+             fmtex->Format.nBlockAlign == 0 ||
+             fmtex->Samples.wValidBitsPerSample > fmtex->Format.wBitsPerSample))
+        return E_INVALIDARG;
+
+    if(fmt->nChannels == 0)
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+
+    /* the mixer resamples, so any sensible rate plays as it is */
+    if(fmt->nChannels > MAX_CHANNELS ||
+            fmt->nSamplesPerSec < 8000 || fmt->nSamplesPerSec > 192000)
+        ret = S_FALSE;
+
+    if(fmt->nBlockAlign != fmt->nChannels * fmt->wBitsPerSample / 8 ||
+            fmt->nAvgBytesPerSec != fmt->nBlockAlign * fmt->nSamplesPerSec)
+        ret = S_FALSE;
+
+    if(share == AUDCLNT_SHAREMODE_EXCLUSIVE &&
+            fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE){
+        if(fmtex->dwChannelMask == 0 || fmtex->dwChannelMask & SPEAKER_RESERVED)
+            ret = S_FALSE;
+    }
+
+    TRACE("returning: %08x\n", (unsigned)ret);
+    return ret;
+}
+
+static void silence_buffer(const WAVEFORMATEX *fmt, BYTE *buffer, UINT32 frames)
+{
+    if(get_sample_format(fmt) == HAIKU_SAMPLE_U8)
+        memset(buffer, 128, frames * fmt->nBlockAlign);
+    else
+        memset(buffer, 0, frames * fmt->nBlockAlign);
+}
+
+static void apply_volume(struct haiku_stream *stream, BYTE *buffer, UINT32 frames)
+{
+    UINT32 channels = stream->fmt->nChannels, i, c;
+
+    if(stream->unity_volume)
+        return;
+
+    switch(get_sample_format(stream->fmt)){
+    case HAIKU_SAMPLE_U8:
+        for(i = 0; i < frames; i++)
+            for(c = 0; c < channels; c++, buffer++)
+                *buffer = 128 + (int)((*buffer - 128) * stream->vol[c]);
+        break;
+    case HAIKU_SAMPLE_S16:
+    {
+        INT16 *samples = (INT16 *)buffer;
+        for(i = 0; i < frames; i++)
+            for(c = 0; c < channels; c++, samples++)
+                *samples = *samples * stream->vol[c];
+        break;
+    }
+    case HAIKU_SAMPLE_S32:
+    {
+        INT32 *samples = (INT32 *)buffer;
+        for(i = 0; i < frames; i++)
+            for(c = 0; c < channels; c++, samples++)
+                *samples = *samples * (double)stream->vol[c];
+        break;
+    }
+    case HAIKU_SAMPLE_FLOAT:
+    {
+        float *samples = (float *)buffer;
+        for(i = 0; i < frames; i++)
+            for(c = 0; c < channels; c++, samples++)
+                *samples *= stream->vol[c];
+        break;
+    }
+    }
+}
+
+/* The player is pulling data from us, on a Media Kit thread: no Nt calls here. */
+static void haiku_fill(void *user, void *data, size_t size)
+{
+    struct haiku_stream *stream = user;
+    UINT32 block = stream->fmt->nBlockAlign, frames = size / block, to_copy = 0, chunk;
+    BYTE *buffer = data;
+
+    haiku_lock(stream);
+
+    if(stream->playing){
+        to_copy = min(frames, stream->held_frames);
+        chunk = min(to_copy, stream->bufsize_frames - stream->lcl_offs_frames);
+
+        memcpy(buffer, stream->local_buffer + stream->lcl_offs_frames * block, chunk * block);
+        memcpy(buffer + chunk * block, stream->local_buffer, (to_copy - chunk) * block);
+        apply_volume(stream, buffer, to_copy);
+
+        stream->lcl_offs_frames += to_copy;
+        stream->lcl_offs_frames %= stream->bufsize_frames;
+        stream->held_frames -= to_copy;
+    }
+
+    if(frames > to_copy)
+        silence_buffer(stream->fmt, buffer + to_copy * block, frames - to_copy);
+    memset(buffer + frames * block, 0, size - frames * block);
+
+    haiku_unlock(stream);
+}
+
+static NTSTATUS haiku_create_stream(void *args)
+{
+    struct create_stream_params *params = args;
+    WAVEFORMATEXTENSIBLE *fmtex;
+    struct haiku_stream *stream;
+    char name[64];
+    unsigned int i;
+    SIZE_T size;
+
+    /* TODO: capture */
+    if(params->flow != eRender){
+        FIXME("Capture is not implemented\n");
+        params->result = E_NOTIMPL;
+        return STATUS_SUCCESS;
+    }
+
+    params->result = check_format(params->share, params->fmt);
+    if(params->result == S_FALSE)
+        params->result = AUDCLNT_E_UNSUPPORTED_FORMAT;
+    if(FAILED(params->result))
+        return STATUS_SUCCESS;
+
+    stream = calloc(1, sizeof(*stream));
+    if(!stream){
+        params->result = E_OUTOFMEMORY;
+        return STATUS_SUCCESS;
+    }
+
+    stream->flow = params->flow;
+    pthread_mutex_init(&stream->lock, NULL);
+
+    fmtex = clone_format(params->fmt);
+    if(!fmtex){
+        params->result = E_OUTOFMEMORY;
+        goto exit;
+    }
+    stream->fmt = &fmtex->Format;
+
+    stream->period = params->period;
+    stream->period_frames = muldiv(params->fmt->nSamplesPerSec, params->period, 10000000);
+
+    stream->bufsize_frames = muldiv(params->duration, params->fmt->nSamplesPerSec, 10000000);
+    if(params->share == AUDCLNT_SHAREMODE_EXCLUSIVE)
+        stream->bufsize_frames -= stream->bufsize_frames % stream->period_frames;
+    size = stream->bufsize_frames * params->fmt->nBlockAlign;
+    if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, zero_bits,
+                               &size, MEM_COMMIT, PAGE_READWRITE)){
+        params->result = E_OUTOFMEMORY;
+        goto exit;
+    }
+
+    stream->share = params->share;
+    stream->flags = params->flags;
+    stream->unity_volume = TRUE;
+    for(i = 0; i < MAX_CHANNELS; i++)
+        stream->vol[i] = 1.0f;
+
+    /* the name the system mixer shows for this input */
+    if(!params->name || ntdll_wcstoumbs(params->name, wcslen(params->name) + 1, name, sizeof(name), FALSE) <= 0)
+        strcpy(name, "Wine");
+    name[sizeof(name) - 1] = 0;
+
+    /* one period per buffer: the player asks for the next one as the mixer consumes it */
+    stream->player = haiku_player_create(name, params->fmt->nSamplesPerSec, params->fmt->nChannels,
+                                         get_sample_format(params->fmt),
+                                         stream->period_frames * params->fmt->nBlockAlign,
+                                         haiku_fill, stream);
+    if(!stream->player){
+        WARN("Unable to connect a sound player to the system mixer\n");
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        goto exit;
+    }
+    stream->latency = haiku_player_latency(stream->player) * 10;
+    TRACE("player latency %s\n", wine_dbgstr_longlong(stream->latency));
+
+exit:
+    if(FAILED(params->result)){
+        if(stream->local_buffer){
+            size = 0;
+            NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, &size, MEM_RELEASE);
+        }
+        pthread_mutex_destroy(&stream->lock);
+        free(stream->fmt);
+        free(stream);
+    }else{
+        *params->channel_count = params->fmt->nChannels;
+        *params->stream = (stream_handle)(UINT_PTR)stream;
+    }
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_release_stream(void *args)
+{
+    struct release_stream_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+    SIZE_T size;
+
+    if(params->timer_thread){
+        stream->please_quit = TRUE;
+        NtWaitForSingleObject(params->timer_thread, FALSE, NULL);
+        NtClose(params->timer_thread);
+    }
+
+    /* waits until the player stopped pulling data */
+    haiku_player_destroy(stream->player);
+
+    if(stream->local_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, &size, MEM_RELEASE);
+    }
+    if(stream->tmp_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+    }
+    free(stream->fmt);
+    pthread_mutex_destroy(&stream->lock);
+    free(stream);
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_start(void *args)
+{
+    struct start_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+    BOOL start_player;
+
+    haiku_lock(stream);
+
+    if((stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK) && !stream->event)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_EVENTHANDLE_NOT_SET);
+
+    if(stream->playing)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_NOT_STOPPED);
+
+    stream->playing = TRUE;
+    start_player = !stream->player_started;
+    stream->player_started = TRUE;
+
+    haiku_unlock(stream);
+
+    /* Once started, the player runs until the stream is released, and plays
+     * silence while the stream is stopped. Starting it calls the media server,
+     * and the player's thread takes our lock: not under the lock. */
+    if(start_player && haiku_player_start(stream->player)){
+        WARN("Unable to start the sound player\n");
+        haiku_lock(stream);
+        stream->playing = FALSE;
+        stream->player_started = FALSE;
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_DEVICE_INVALIDATED);
+    }
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_stop(void *args)
+{
+    struct stop_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+
+    haiku_lock(stream);
+
+    if(!stream->playing)
+        return haiku_unlock_result(stream, &params->result, S_FALSE);
+
+    stream->playing = FALSE;
+
+    return haiku_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS haiku_reset(void *args)
+{
+    struct reset_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+
+    haiku_lock(stream);
+
+    if(stream->playing)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_NOT_STOPPED);
+
+    if(stream->getbuf_last)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_BUFFER_OPERATION_PENDING);
+
+    stream->written_frames = 0;
+    stream->last_pos_frames = 0;
+    stream->held_frames = 0;
+    stream->lcl_offs_frames = 0;
+
+    return haiku_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS haiku_timer_loop(void *args)
+{
+    struct timer_loop_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+    LARGE_INTEGER delay, now, next;
+    int adjust;
+
+    haiku_lock(stream);
+
+    delay.QuadPart = -stream->period;
+    NtQueryPerformanceCounter(&now, NULL);
+    next.QuadPart = now.QuadPart + stream->period;
+
+    while(!stream->please_quit){
+        if(stream->event)
+            NtSetEvent(stream->event, NULL);
+        haiku_unlock(stream);
+
+        NtDelayExecution(FALSE, &delay);
+
+        haiku_lock(stream);
+        NtQueryPerformanceCounter(&now, NULL);
+        adjust = next.QuadPart - now.QuadPart;
+        if(adjust > stream->period / 2)
+            adjust = stream->period / 2;
+        else if(adjust < -stream->period / 2)
+            adjust = -stream->period / 2;
+        delay.QuadPart = -(stream->period + adjust);
+        next.QuadPart += stream->period;
+    }
+
+    haiku_unlock(stream);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haiku_get_render_buffer(void *args)
+{
+    struct get_render_buffer_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+    UINT32 write_pos, frames = params->frames;
+    BYTE **data = params->data;
+    SIZE_T size;
+
+    haiku_lock(stream);
+
+    if(stream->getbuf_last)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(!frames)
+        return haiku_unlock_result(stream, &params->result, S_OK);
+
+    if(stream->held_frames + frames > stream->bufsize_frames)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_BUFFER_TOO_LARGE);
+
+    write_pos =
+        (stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames;
+    if(write_pos + frames > stream->bufsize_frames){
+        if(stream->tmp_buffer_frames < frames){
+            if(stream->tmp_buffer){
+                size = 0;
+                NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+                stream->tmp_buffer = NULL;
+            }
+            size = frames * stream->fmt->nBlockAlign;
+            if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, zero_bits,
+                                       &size, MEM_COMMIT, PAGE_READWRITE)){
+                stream->tmp_buffer_frames = 0;
+                return haiku_unlock_result(stream, &params->result, E_OUTOFMEMORY);
+            }
+            stream->tmp_buffer_frames = frames;
+        }
+        *data = stream->tmp_buffer;
+        stream->getbuf_last = -frames;
+    }else{
+        *data = stream->local_buffer + write_pos * stream->fmt->nBlockAlign;
+        stream->getbuf_last = frames;
+    }
+
+    silence_buffer(stream->fmt, *data, frames);
+
+    return haiku_unlock_result(stream, &params->result, S_OK);
+}
+
+static void haiku_wrap_buffer(struct haiku_stream *stream, BYTE *buffer, UINT32 written_frames)
+{
+    UINT32 write_offs_frames =
+        (stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames;
+    UINT32 write_offs_bytes = write_offs_frames * stream->fmt->nBlockAlign;
+    UINT32 chunk_frames = stream->bufsize_frames - write_offs_frames;
+    UINT32 chunk_bytes = chunk_frames * stream->fmt->nBlockAlign;
+    UINT32 written_bytes = written_frames * stream->fmt->nBlockAlign;
+
+    if(written_bytes <= chunk_bytes){
+        memcpy(stream->local_buffer + write_offs_bytes, buffer, written_bytes);
+    }else{
+        memcpy(stream->local_buffer + write_offs_bytes, buffer, chunk_bytes);
+        memcpy(stream->local_buffer, buffer + chunk_bytes,
+                written_bytes - chunk_bytes);
+    }
+}
+
+static NTSTATUS haiku_release_render_buffer(void *args)
+{
+    struct release_render_buffer_params *params = args;
+    struct haiku_stream *stream = handle_get_stream(params->stream);
+    UINT32 written_frames = params->written_frames;
+    UINT flags = params->flags;
+    BYTE *buffer;
+
+    haiku_lock(stream);
+
+    if(!written_frames){
+        stream->getbuf_last = 0;
+        return haiku_unlock_result(stream, &params->result, S_OK);
+    }
+
+    if(!stream->getbuf_last)
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(written_frames > (stream->getbuf_last >= 0 ? stream->getbuf_last : -stream->getbuf_last))
+        return haiku_unlock_result(stream, &params->result, AUDCLNT_E_INVALID_SIZE);
+
+    if(stream->getbuf_last >= 0)
+        buffer = stream->local_buffer + stream->fmt->nBlockAlign *
+          ((stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames);
+    else
+        buffer = stream->tmp_buffer;
+
+    if(flags & AUDCLNT_BUFFERFLAGS_SILENT)
+        silence_buffer(stream->fmt, buffer, written_frames);
+
+    if(stream->getbuf_last < 0)
+        haiku_wrap_buffer(stream, buffer, written_frames);
+
+    stream->held_frames += written_frames;
+    stream->written_frames += written_frames;
+    stream->getbuf_last = 0;
+
+    return haiku_unlock_result(stream, &params->result, S_OK);
+}
