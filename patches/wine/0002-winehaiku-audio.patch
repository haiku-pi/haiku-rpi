+++ wine-haiku/dlls/winehaiku.drv/haiku_player.cpp	2026-10-21 16:38:39.891817296 +0200
@@ -0,0 +1,164 @@
+/*
+ * Haiku Media Kit sound player, a C interface to BSoundPlayer
+ *
+ * Copyright 2026 Witold Bołt
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Built with the Haiku C++ compiler outside makedep, see haiku_player.h. No
+ * exception may leave these functions: their callers are C. */
+
+#include <MediaRoster.h>
+#include <SoundPlayer.h>
+
+#include <new>
+#include <string.h>
+
+#include "haiku_player.h"
+
+struct haiku_player
+{
+    BSoundPlayer *player;
+    haiku_player_fill fill;
+    void *user;
+};
+
+static void play_buffer(void *cookie, void *buffer, size_t size,
+                        const media_raw_audio_format &)
+{
+    struct haiku_player *player = (struct haiku_player *)cookie;
+
+    player->fill(player->user, buffer, size);
+}
+
+extern "C" int haiku_audio_available(void)
+{
+    try
+    {
+        return BMediaRoster::IsRunning();
+    }
+    catch (...)
+    {
+        return 0;
+    }
+}
+
+extern "C" int haiku_audio_output_name(char *name, size_t size)
+{
+    try
+    {
+        BMediaRoster *roster = BMediaRoster::Roster();
+        media_node output;
+        live_node_info info;
+        int ret = 0;
+
+        if (!roster || roster->GetAudioOutput(&output) != B_OK) return 0;
+        if (roster->GetLiveNodeInfo(output, &info) == B_OK)
+        {
+            strlcpy(name, info.name, size);
+            ret = 1;
+        }
+        roster->ReleaseNode(output);
+        return ret;
+    }
+    catch (...)
+    {
+        return 0;
+    }
+}
+
+extern "C" struct haiku_player *haiku_player_create(const char *name, unsigned int rate,
+                                                    unsigned int channels,
+                                                    enum haiku_sample_format format,
+                                                    size_t buffer_size, haiku_player_fill fill,
+                                                    void *user)
+{
+    struct haiku_player *player = NULL;
+
+    try
+    {
+        media_raw_audio_format raw = media_raw_audio_format::wildcard;
+
+        switch (format)
+        {
+        case HAIKU_SAMPLE_U8:    raw.format = media_raw_audio_format::B_AUDIO_UCHAR; break;
+        case HAIKU_SAMPLE_S16:   raw.format = media_raw_audio_format::B_AUDIO_SHORT; break;
+        case HAIKU_SAMPLE_S32:   raw.format = media_raw_audio_format::B_AUDIO_INT; break;
+        case HAIKU_SAMPLE_FLOAT: raw.format = media_raw_audio_format::B_AUDIO_FLOAT; break;
+        default: return NULL;
+        }
+        raw.frame_rate = rate;
+        raw.channel_count = channels;
+        raw.byte_order = B_MEDIA_HOST_ENDIAN;
+        raw.buffer_size = buffer_size;
+
+        player = new (std::nothrow) haiku_player;
+        if (!player) return NULL;
+        player->fill = fill;
+        player->user = user;
+        /* the system mixer takes any raw format and converts it to its own */
+        player->player = new (std::nothrow) BSoundPlayer(&raw, name, play_buffer, NULL, player);
+        if (!player->player || player->player->InitCheck() != B_OK)
+        {
+            delete player->player;
+            delete player;
+            return NULL;
+        }
+        return player;
+    }
+    catch (...)
+    {
+        delete player;
+        return NULL;
+    }
+}
+
+extern "C" int haiku_player_start(struct haiku_player *player)
+{
+    try
+    {
+        return player->player->Start() == B_OK ? 0 : -1;
+    }
+    catch (...)
+    {
+        return -1;
+    }
+}
+
+extern "C" void haiku_player_destroy(struct haiku_player *player)
+{
+    try
+    {
+        /* stops the player node (blocking) before it disconnects it from the mixer */
+        delete player->player;
+    }
+    catch (...)
+    {
+    }
+    delete player;
+}
+
+extern "C" long long haiku_player_latency(struct haiku_player *player)
+{
+    try
+    {
+        return player->player->Latency();
+    }
+    catch (...)
+    {
+        return 0;
+    }
+}
