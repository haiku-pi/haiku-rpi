+/* Without a window system surface (the surfaceless EGL platform), a frame reaches the window through GDI: the
+ * finished buffer, read back, drawn into the window's DC as a DIB (bottom-up, as GL's rows are). */
+static void framebuffer_surface_present( struct opengl_drawable *drawable, GLenum buffer )
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+    BITMAPINFO info = {.bmiHeader = {.biSize = sizeof(BITMAPINFOHEADER), .biPlanes = 1, .biBitCount = 32,
+                                     .biCompression = BI_RGB}};
+    struct framebuffer_bindings saved;
+    HWND hwnd = drawable->client->hwnd;
+    GLint read_buffer;
+    UINT width, height;
+    void *bits;
+    RECT rect;
+    HDC hdc;
+
+    if (!drawable->read_fbo) return;
+    NtUserGetClientRect( hwnd, &rect, NtUserGetDpiForWindow( hwnd ) );
+    if (!(width = rect.right) || !(height = rect.bottom)) return;
+    if (!(bits = malloc( width * height * 4 ))) return;
+
+    bind_framebuffer( drawable->read_fbo, &saved );
+    funcs->p_glGetIntegerv( GL_READ_BUFFER, &read_buffer );
+    funcs->p_glReadBuffer( buffer );
+    funcs->p_glReadPixels( 0, 0, width, height, GL_BGRA, GL_UNSIGNED_BYTE, bits );
+    funcs->p_glReadBuffer( read_buffer );
+    restore_framebuffer( &saved );
+
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = height;
+    if ((hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_CLIPSIBLINGS )))
+    {
+        NtGdiSetDIBitsToDeviceInternal( hdc, 0, 0, width, height, 0, 0, 0, height, bits, &info, DIB_RGB_COLORS,
+                                        width * height * 4, sizeof(info), FALSE, NULL );
+        NtUserReleaseDC( hwnd, hdc );
+    }
+    free( bits );
+}
