+/* The emulated framebuffer is made with the framebuffer-object calls of OpenGL 3.0 / ARB_framebuffer_object, not
+ * with direct state access (OpenGL 4.5), which OpenGL 2.1 drivers such as Mesa's V3D (Raspberry Pi 4) do not have;
+ * the caller's framebuffer and renderbuffer bindings are kept. */
+struct framebuffer_bindings
+{
+    GLint draw, read, renderbuffer;
+};
+
+static void bind_framebuffer( GLuint fbo, struct framebuffer_bindings *saved )
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+
+    funcs->p_glGetIntegerv( GL_DRAW_FRAMEBUFFER_BINDING, &saved->draw );
+    funcs->p_glGetIntegerv( GL_READ_FRAMEBUFFER_BINDING, &saved->read );
+    funcs->p_glGetIntegerv( GL_RENDERBUFFER_BINDING, &saved->renderbuffer );
+    funcs->p_glBindFramebuffer( GL_FRAMEBUFFER, fbo );
+}
+
+static void restore_framebuffer( const struct framebuffer_bindings *saved )
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+
+    funcs->p_glBindRenderbuffer( GL_RENDERBUFFER, saved->renderbuffer );
+    funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, saved->draw );
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, saved->read );
+}
+
+static GLuint attachment_name( GLenum attachment )
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+    GLuint name = 0;
+
+    funcs->p_glGetFramebufferAttachmentParameteriv( GL_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,
+                                                    (GLint *)&name );
+    return name;
+}
