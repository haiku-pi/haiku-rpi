+/* xdg_toplevel.set_fullscreen: a surface that does not cover the output is
+ * centered on it, the rest is border fill. The window stays the size of the
+ * screen; the surface's view moves inside it. */
+void HaikuXdgToplevel::PlaceFullscreenSurface()
+{
+	BView *view = XdgSurface()->Surface()->View();
+	if (view == NULL)
+		return;
+	HaikuXdgSurface::GeometryInfo geometry = XdgSurface()->Geometry();
+	BSize size = XdgSurface()->Surface()->Size();
+	float width = size.width + 1, height = size.height + 1;
+	int32_t x = 0, y = 0;
+	if (geometry.valid) {
+		width = geometry.width;
+		height = geometry.height;
+		x = geometry.x;
+		y = geometry.y;
+	}
+	BRect screenFrame = BScreen(fWindow).Frame();
+	AppKitPtrs::LockedPtr(view)->MoveTo(
+		floorf((screenFrame.Width() + 1 - width) / 2) - x,
+		floorf((screenFrame.Height() + 1 - height) / 2) - y);
+}
+
 void HaikuXdgToplevel::HandleUnsetFullscreen()
 {
 	if (!fState.fullscreen) return;
 	fState.fullscreen = false;
 	fSizeChanged = true;
+	if (fFullscreenBorder != NULL) {
+		fFullscreenBorder->RemoveSelf();
+		delete fFullscreenBorder;
+		fFullscreenBorder = NULL;
+	}
+	if (BView *view = XdgSurface()->Surface()->View()) {
+		HaikuXdgSurface::GeometryInfo geometry = XdgSurface()->Geometry();
+		AppKitPtrs::LockedPtr(view)->MoveTo(geometry.valid ? -geometry.x : 0, geometry.valid ? -geometry.y : 0);
+	}
 	fWindow->MoveTo(fSavedPos.LeftTop());
 	fWindow->ResizeTo(fSavedPos.Width(), fSavedPos.Height());
 	fWidth = (int32_t)fSavedPos.Width() + 1;
