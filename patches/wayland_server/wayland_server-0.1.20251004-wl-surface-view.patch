+/* Not part of the in-process protocol: the BView of a wl_surface (the id of the client's object), for a
+ * client that presents into it itself — Vulkan through Mesa's Haiku WSI (VK_EXT_headless_surface with a
+ * VkHaikuSurfaceCreateInfoMESA on the view), as wgpu does for a Wayland window on Haiku. From then on the
+ * surface has no buffers: its size is its xdg window geometry, its window is shown at the first commit
+ * with one, and the client commits after each frame (frame callbacks, geometry). NULL: no such surface,
+ * or it has no view yet (no xdg_toplevel or xdg_popup, or a subsurface not yet placed). */
+extern "C" _EXPORT void *wl_ips_haiku_surface_view(uint32 surfaceId)
+{
+	if (gWaylandLooper == NULL || find_thread(NULL) == gWaylandLooper->Thread())
+		return NULL;
+
+	BMessage msg(ServerHandler::surfaceViewMsg), reply;
+	msg.AddInt32("surface", (int32)surfaceId);
+	if (gServerMessenger.SendMessage(&msg, &reply) != B_OK)
+		return NULL;
+	void *view = NULL;
+	reply.FindPointer("view", &view);
+	return view;
+}
