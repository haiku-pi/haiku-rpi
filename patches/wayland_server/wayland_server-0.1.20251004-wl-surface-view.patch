 //#pragma mark - HaikuXdgSurface
+
+/* A surface presented into by the client: the view and (client-side decorations) the window take the
+ * size of the window geometry. */
+void HaikuXdgSurface::FitPresentedView(BSize size)
+{
+	BView *view = fSurface->View();
+	if (view != NULL)
+		AppKitPtrs::LockedPtr(view)->ResizeTo(size.width, size.height);
+	if (!HasServerDecoration() && (fToplevel == NULL || !fToplevel->fState.fullscreen)
+		&& Window()->Size() != size) {
+		Window()->ResizeTo(size.width, size.height);
+	}
+	if (HaikuTracePresent()) {
+		static int32 sFits;
+		int32 n = sFits++;
+		if (n < 60 || n % 100 == 0) {
+			AppKitPtrs::LockedPtr<BWindow> window(Window());
+			BRect bounds = view != NULL ? view->Bounds() : BRect();
+			BRect frame = window->Frame();
+			fprintf(stderr, "haiway: presented surface commit #%" B_PRId32 ": geometry %gx%g, view %gx%g, "
+				"window %gx%g at %g,%g, %s\n", n, size.width + 1, size.height + 1, bounds.Width() + 1,
+				bounds.Height() + 1, frame.Width() + 1, frame.Height() + 1, frame.left, frame.top,
+				window->IsHidden() ? "hidden" : "shown");
+		}
+	}
+}
+
+/* HAIWAY_SHOW_AT_VIEW=1 (a diagnostic variant): wl_ips_haiku_surface_view shows a toplevel's window at
+ * once, at the client's pending window geometry, instead of at the next commit, so that no frame is
+ * drawn into a hidden window. */
+void HaikuXdgSurface::ShowPresentedNow()
+{
+	if (fSurfaceInitalized || fToplevel == NULL || !fPendingGeometry.valid)
+		return;
+	FitPresentedView(BSize(fPendingGeometry.width - 1, fPendingGeometry.height - 1));
+	Window()->CenterOnScreen();
+	Window()->Show();
+	fSurfaceInitalized = true;
+	if (HaikuTracePresent())
+		fprintf(stderr, "haiway: presented surface: window shown with its view (HAIWAY_SHOW_AT_VIEW)\n");
+}
