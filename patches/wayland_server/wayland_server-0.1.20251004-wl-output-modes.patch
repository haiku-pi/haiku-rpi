+// every bound output (only touched on the server's thread): a display mode change
+// is sent to all of them
+static std::vector<HaikuOutput*> sOutputs;
+
+// the mode the screen had when the first client bound: the preferred one
+static int32 sPreferredWidth, sPreferredHeight;
+
+
+static int32 RefreshMilliHz(const display_mode &mode)
+{
+	int64 total = (int64)mode.timing.h_total * mode.timing.v_total;
+	if (total == 0)
+		return 60000;
+	return (int32)((int64)mode.timing.pixel_clock * 1000 * 1000 / total);
+}
+
+
+HaikuOutput::~HaikuOutput()
+{
+	sOutputs.erase(std::remove(sOutputs.begin(), sOutputs.end(), this), sOutputs.end());
+}
+
+struct OutputMode {
+	int32 width, height, refresh;
 };
 
+/* The sizes the screen can take: each mode of the screen's list once, at the
+ * refresh rate closest to 60 Hz (the display hardware scales a mode to the
+ * monitor, whose own timing does not change), and the small sizes old games ask
+ * for (the screen takes any size up to its mode list's largest). */
+static std::vector<OutputMode> ScreenModes(const display_mode &current, display_mode **_list = NULL,
+	uint32 *_count = NULL)
+{
+	static const OutputMode kGameModes[] = {
+		{320, 200, 0}, {320, 240, 0}, {400, 300, 0}, {512, 384, 0}, {640, 400, 0},
+		{640, 480, 0}, {800, 600, 0}, {1024, 768, 0}
+	};
+	std::vector<OutputMode> sizes;
+	display_mode *list = NULL;
+	uint32 count = 0;
+	int32 maxWidth = current.virtual_width, maxHeight = current.virtual_height;
+	if (BScreen().GetModeList(&list, &count) != B_OK)
+		count = 0;
+	for (uint32 i = 0; i < count; i++) {
+		if (list[i].space != current.space)
+			continue;
+		OutputMode mode = {list[i].timing.h_display, list[i].timing.v_display,
+			RefreshMilliHz(list[i])};
+		maxWidth = std::max(maxWidth, mode.width);
+		maxHeight = std::max(maxHeight, mode.height);
+		auto same = std::find_if(sizes.begin(), sizes.end(), [&](const OutputMode &other) {
+			return other.width == mode.width && other.height == mode.height;
+		});
+		if (same == sizes.end())
+			sizes.push_back(mode);
+		else if (abs(mode.refresh - 60000) < abs(same->refresh - 60000))
+			same->refresh = mode.refresh;
+	}
+	for (const OutputMode &game : kGameModes) {
+		if (game.width > maxWidth || game.height > maxHeight)
+			continue;
+		if (std::find_if(sizes.begin(), sizes.end(), [&](const OutputMode &other) {
+				return other.width == game.width && other.height == game.height;
+			}) == sizes.end())
+			sizes.push_back({game.width, game.height, 60000});
+	}
+	if (_list != NULL) {
+		*_list = list;
+		*_count = count;
+	} else
+		free(list);
+	return sizes;
+}
+
+
+/* The screen's display modes, the current one flagged: a client (Wine) can then
+ * set a mode instead of scaling its windows to emulate it. */
+void HaikuOutput::SendModes()
+{
+	BScreen screen;
+	display_mode current;
+	if (screen.GetMode(&current) != B_OK) {
+		SendMode(WlOutput::modeCurrent | WlOutput::modePreferred,
+			(int32_t)screen.Frame().Width() + 1, (int32_t)screen.Frame().Height() + 1, 60000);
+		return;
+	}
+	for (const OutputMode &mode : ScreenModes(current)) {
+		uint32 flags = 0;
+		if (mode.width == current.virtual_width && mode.height == current.virtual_height)
+			flags |= WlOutput::modeCurrent;
+		if (mode.width == sPreferredWidth && mode.height == sPreferredHeight)
+			flags |= WlOutput::modePreferred;
+		SendMode(flags, mode.width, mode.height, mode.refresh);
+	}
+}
+
+
+status_t HaikuOutputSetMode(int32 width, int32 height, int32 refreshMilliHz)
+{
+	BScreen screen;
+	display_mode current, *list;
+	uint32 count;
+	status_t status = screen.GetMode(&current);
+	if (status != B_OK)
+		return status;
+	std::vector<OutputMode> sizes = ScreenModes(current, &list, &count);
+	if (std::find_if(sizes.begin(), sizes.end(), [&](const OutputMode &mode) {
+			return mode.width == width && mode.height == height;
+		}) == sizes.end()) {
+		free(list);
+		return B_BAD_VALUE;
+	}
+
+	// a mode of the list, the refresh rate closest to the one asked for (60 Hz if
+	// none); else (a game size) the current mode's timing at that size
+	const display_mode *best = NULL;
+	int32 wanted = refreshMilliHz != 0 ? refreshMilliHz : 60000;
+	for (uint32 i = 0; i < count; i++) {
+		if (list[i].space != current.space || list[i].timing.h_display != width
+			|| list[i].timing.v_display != height)
+			continue;
+		if (best == NULL || abs(RefreshMilliHz(list[i]) - wanted) < abs(RefreshMilliHz(*best) - wanted))
+			best = &list[i];
+	}
+	display_mode mode = current;
+	if (best != NULL)
+		mode = *best;
+	else {
+		mode.virtual_width = mode.timing.h_display = width;
+		mode.virtual_height = mode.timing.v_display = height;
+		mode.h_display_start = mode.v_display_start = 0;
+	}
+	free(list);
+
+	if (current.virtual_width != mode.virtual_width || current.virtual_height != mode.virtual_height
+		|| RefreshMilliHz(current) != RefreshMilliHz(mode)) {
+		// not the default mode: app_server goes back to that one when this team quits
+		status = screen.SetMode(&mode);
+		if (status != B_OK)
+			return status;
+	}
+
+	HaikuXdgToplevel::ScreenChanged();
+	for (HaikuOutput *output : sOutputs) {
+		output->SendModes();
+		output->SendDone();
+	}
+	return B_OK;
+}
