+/* Not part of the in-process protocol: Wine's Wayland driver sets the screen's
+ * display mode with it (a game's display mode becomes the screen's, scaled to the
+ * monitor by the display hardware), then waits for the outputs' new mode. */
+extern "C" _EXPORT status_t wl_ips_haiku_set_mode(int32 width, int32 height, int32 refreshMilliHz)
+{
+	if (gWaylandLooper == NULL)
+		return B_NO_INIT;
+	if (find_thread(NULL) == gWaylandLooper->Thread())
+		return HaikuOutputSetMode(width, height, refreshMilliHz);
+
+	BMessage msg(ServerHandler::setModeMsg), reply;
+	msg.AddInt32("width", width);
+	msg.AddInt32("height", height);
+	msg.AddInt32("refresh", refreshMilliHz);
+	status_t status = gServerMessenger.SendMessage(&msg, &reply);
+	if (status != B_OK)
+		return status;
+	return reply.GetInt32("status", B_ERROR);
+}
