+// the toplevels' windows, and the threads of those that are quitting (HoldWindowsAtExit(); never freed:
+// the team is exiting then)
+static pthread_mutex_t sWindowsLock = PTHREAD_MUTEX_INITIALIZER;
+static std::vector<WaylandWindow*> *sWindows = new std::vector<WaylandWindow*>;
+static std::vector<thread_id> *sQuittingThreads = new std::vector<thread_id>;
+
 WaylandWindow::WaylandWindow(HaikuXdgToplevel *toplevel, BRect frame, const char* title, window_look look, window_feel feel, uint32 flags, uint32 workspace):
 	BWindow(frame, title, look, feel, flags, workspace),
 	fToplevel(toplevel)
 {
+	pthread_mutex_lock(&sWindowsLock);
+	sWindows->push_back(this);
+	pthread_mutex_unlock(&sWindowsLock);
+}
+
+WaylandWindow::~WaylandWindow()
+{
+	// (waits here, before BWindow's destructor, once the windows are held at exit)
+	pthread_mutex_lock(&sWindowsLock);
+	sWindows->erase(std::remove(sWindows->begin(), sWindows->end(), this), sWindows->end());
+	pthread_mutex_unlock(&sWindowsLock);
 }
 
 bool WaylandWindow::QuitRequested()
