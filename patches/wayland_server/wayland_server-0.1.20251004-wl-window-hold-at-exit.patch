+/* The team exits (see HoldLoopersAtExit()): the windows of destroyed toplevels finish quitting (their
+ * threads end, at most 1 s), then every remaining window is locked and stays locked, its thread waits. */
+void HaikuXdgToplevel::HoldWindowsAtExit()
+{
+	bigtime_t until = system_time() + 1000000;
+	pthread_mutex_lock(&sWindowsLock);
+	std::vector<thread_id> quitting(*sQuittingThreads);
+	pthread_mutex_unlock(&sWindowsLock);
+	for (thread_id thread : quitting) {
+		status_t result;
+		wait_for_thread_etc(thread, B_ABSOLUTE_TIMEOUT, until, &result);
+	}
+
+	pthread_mutex_lock(&sWindowsLock);
+	for (WaylandWindow *window : *sWindows)
+		window->LockWithTimeout(200000);
+}
