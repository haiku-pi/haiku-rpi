+extern "C" int __cxa_atexit(void (*function)(void*), void *argument, void *dso);
+extern void *__dso_handle;
+
+/* The team exits (or the add-on is unloaded): libbe's static destructors (its token space, the looper
+ * list, the roster) run, while the server's loopers still run on their threads — the
+ * Wayland looper, the toplevels' windows, the application looper made here. A message handled then, such
+ * as a destroyed toplevel's window quitting and deleting itself, used that destroyed state: "bogus
+ * pointer (double free?)" in BTokenSpace::RemoveToken from ~BWindow, or "looper must be locked before
+ * proceeding" (a client that exits right after it destroyed its window: Photocraft's error exit, closing
+ * it). Let the windows of destroyed toplevels finish quitting, then lock the loopers and keep them
+ * locked: their threads wait, and the team's exit ends them. Registered when the server starts, after
+ * libbe's static objects were made, so exit() runs it before their destructors. */
+static void
+HoldLoopersAtExit(void *)
+{
+	if (gWaylandLooper == NULL)
+		return;
+	// the client's requests sent so far are handled first (a toplevel's destruction)
+	if (find_thread(NULL) != gWaylandLooper->Thread()) {
+		BMessage sync('wsyn'), reply;
+		gServerMessenger.SendMessage(&sync, &reply, 1000000, 1000000);
+	}
+	HaikuXdgToplevel::HoldWindowsAtExit();
+	gWaylandLooper->LockWithTimeout(1000000);
+	if (sOwnApplication && be_app != NULL)
+		be_app->LockWithTimeout(1000000);
+}
+
