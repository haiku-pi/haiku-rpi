+/* A looper held (locked) at exit still wakes up for each message sent to it later — the client's requests
+ * from its other threads, a window's pulse, app_server's and the registrar's messages — and its thread then
+ * calls Lock(), which looks the looper up in libbe's looper list: freed by libbe's static destructors that
+ * run after the hold. Photocraft on the Pi: "Segment violation" in BLooperList::FindLooperPred ←
+ * IsLooperValid ← BLooper::Lock ← task_looper on the "wayland" looper's thread after `hey … quit`, the
+ * team left in the debugger. So the held loopers' threads are also suspended while they wait (in read_port,
+ * or for the lock held here): a suspended thread runs no user code again, and the team's exit kills it.
+ * Suspending a thread that runs user code could stop it inside malloc() with the heap locked, so a running
+ * one (between two messages: rare, it holds no looper lock) gets up to 50 ms to wait again first. */
+void
+StopLooperAtExit(BLooper *looper)
+{
+	if (looper == NULL || !looper->IsLocked())
+		return;
+	thread_id thread = looper->Thread();
+	if (thread < 0 || thread == find_thread(NULL))
+		return;
+	for (int i = 0; i < 50; i++) {
+		thread_info info;
+		if (get_thread_info(thread, &info) != B_OK)
+			return;
+		if (info.state == B_THREAD_WAITING) {
+			suspend_thread(thread);
+			return;
+		}
+		snooze(1000);
+	}
+}
+
+
