+    /* Keep the window's tab on the screen (a fullscreen window has none yet:
+       SDL makes it fullscreen after this), and tell SDL where the window is
+       now, before SDL_CreateWindow() returns: the program may read it at once */
+    if (!(window->flags & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_BORDERLESS))) {
