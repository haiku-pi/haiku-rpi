+    /* SDL places a window by its content area; its tab and border lie
+       outside it, and Haiku moves no window by itself. Keep the tab of a
+       window with a border on the screen: a window as large as the screen,
+       or one placed at the top edge, would have it above the screen, out of
+       the user's reach. A window that cannot fit is shrunk if resizeToFit,
+       and moved onto the screen. Other windows that overhang an edge are left
+       where they were placed. */
+    void KeepTabOnScreen(bool resizeToFit)
+    {
+        if (_fullscreen || Look() == B_NO_BORDER_WINDOW_LOOK)
+            return;
+
+        BRect screenFrame = BScreen(this).Frame();
+        BRect frame = Frame();
+        BRect decorator = DecoratorFrame();
+        /* the decorator's extent on each side of the content area */
+        float left = frame.left - decorator.left;
+        float top = frame.top - decorator.top;
+        float right = decorator.right - frame.right;
+        float bottom = decorator.bottom - frame.bottom;
+
+        bool shrunk = false;
+        if (resizeToFit && !(Flags() & B_NOT_RESIZABLE)) {
+            float width = std::min(frame.Width(), screenFrame.Width() - left - right);
+            float height = std::min(frame.Height(), screenFrame.Height() - top - bottom);
+            if (width != frame.Width() || height != frame.Height()) {
+                ResizeTo(width, height);
+                frame = Frame();
+                shrunk = true;
+            }
+        }
+
+        BPoint origin = frame.LeftTop();
+        if (shrunk && frame.right + right > screenFrame.right)
+            origin.x = screenFrame.right - right - frame.Width();
+        if (origin.x - left < screenFrame.left)
+            origin.x = screenFrame.left + left;
+        if (shrunk && frame.bottom + bottom > screenFrame.bottom)
+            origin.y = screenFrame.bottom - bottom - frame.Height();
+        if (origin.y - top < screenFrame.top)
+            origin.y = screenFrame.top + top;
+        if (origin != frame.LeftTop())
+            MoveTo(origin);
+    }
+
