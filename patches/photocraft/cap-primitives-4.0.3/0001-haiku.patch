cap-primitives: build on Haiku

Haiku's dirent has no d_type (rustix has no DirEntry::file_type there: stat the entry, as on
illumos), no O_PATH and no O_RSYNC (as on FreeBSD/macOS: not set), and a signed ino_t/nlink_t.
Applies with -p1 to cap-primitives 4.0.3.

diff -ruN a/src/rustix/fs/dir_entry_inner.rs b/src/rustix/fs/dir_entry_inner.rs
--- a/src/rustix/fs/dir_entry_inner.rs	2026-10-25 00:58:05.787116145 +0200
+++ b/src/rustix/fs/dir_entry_inner.rs	2026-10-25 00:58:05.823557792 +0200
@@ -40,7 +40,7 @@
         self.read_dir.remove_dir(self.file_name_bytes())
     }
 
-    #[cfg(not(any(target_os = "illumos", target_os = "solaris")))]
+    #[cfg(not(any(target_os = "illumos", target_os = "solaris", target_os = "haiku")))]
     #[inline]
     #[allow(clippy::unnecessary_wraps)]
     pub(crate) fn file_type(&self) -> io::Result<FileType> {
@@ -60,7 +60,7 @@
         })
     }
 
-    #[cfg(any(target_os = "illumos", target_os = "solaris"))]
+    #[cfg(any(target_os = "illumos", target_os = "solaris", target_os = "haiku"))]
     #[inline]
     pub(crate) fn file_type(&self) -> io::Result<FileType> {
         // These platforms don't have the file type on the dirent, so we must lstat the file.
