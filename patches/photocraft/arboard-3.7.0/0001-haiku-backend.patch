+
+//! Haiku: the system clipboard (BClipboard), through a small C++ shim (`haiku/arboard_haiku.cpp`,
+//! built by `build.rs`).
+//!
+//! The clipboard is a message held by the registrar: what is copied stays there after the program
+//! exits. Text is a `text/plain` field, HTML `text/html`; an image is written as `image/bitmap` (an
+//! archived BBitmap, what Haiku's own applications paste) and `image/png`, and read from either
+//! (`image/bitmap` first, then any `image/*` data the `image` crate decodes); files are the
+//! Tracker's entry_refs (Copy in the Tracker), else `text/uri-list`.
+
+use std::borrow::Cow;
+use std::ffi::{c_char, c_int, c_void, CString, OsStr};
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+
+#[cfg(feature = "image-data")]
+use crate::common::ImageData;
+use crate::common::Error;
+
+#[repr(C)]
+struct Item {
+	name: *const c_char,
+	data: *const c_void,
+	length: usize,
+}
+
+extern "C" {
+	fn arboard_haiku_get_data(name: *const c_char, data: *mut *mut c_void, length: *mut usize) -> c_int;
+	fn arboard_haiku_get_types(names: *mut *mut c_void, length: *mut usize) -> c_int;
+	#[cfg(feature = "image-data")]
+	fn arboard_haiku_get_bitmap(
+		width: *mut u32,
+		height: *mut u32,
+		rgba: *mut *mut c_void,
+		length: *mut usize,
+	) -> c_int;
+	fn arboard_haiku_get_refs(paths: *mut *mut c_void, length: *mut usize) -> c_int;
+	fn arboard_haiku_set(
+		items: *const Item,
+		count: usize,
+		rgba: *const u8,
+		width: u32,
+		height: u32,
+		paths: *const c_char,
+		path_count: usize,
+	) -> c_int;
+	fn arboard_haiku_clear() -> c_int;
+	fn arboard_haiku_free(pointer: *mut c_void);
+}
+
+const TEXT: &str = "text/plain";
+const HTML: &str = "text/html";
+const URI_LIST: &str = "text/uri-list";
+#[cfg(feature = "image-data")]
+const PNG: &str = "image/png";
+
+/// The shim's status as a result: 0 ok, 1 no such content, 2 not convertible, else no clipboard.
+fn status(code: c_int) -> Result<(), Error> {
+	match code {
+		0 => Ok(()),
+		1 => Err(Error::ContentNotAvailable),
+		2 => Err(Error::ConversionFailure),
+		_ => Err(Error::Unknown { description: "the Haiku clipboard cannot be locked".into() }),
+	}
+}
+
+/// Calls a shim getter that returns malloc'd bytes, and copies them out.
+fn fetch(get: impl FnOnce(*mut *mut c_void, *mut usize) -> c_int) -> Result<Vec<u8>, Error> {
+	let mut data: *mut c_void = std::ptr::null_mut();
+	let mut length = 0usize;
+	let code = get(&mut data, &mut length);
+	let bytes = if data.is_null() {
+		Vec::new()
+	} else {
+		// SAFETY: the shim wrote `length` bytes at `data` (malloc'd), freed once here.
+		let bytes = unsafe { std::slice::from_raw_parts(data as *const u8, length) }.to_vec();
+		unsafe { arboard_haiku_free(data) };
+		bytes
+	};
+	status(code).map(|()| bytes)
+}
+
+fn c_name(name: &str) -> CString {
+	CString::new(name).expect("MIME type with a NUL")
+}
+
+fn get_data(name: &str) -> Result<Vec<u8>, Error> {
+	let name = c_name(name);
+	// SAFETY: a valid C string; out-pointers to locals.
+	fetch(|data, length| unsafe { arboard_haiku_get_data(name.as_ptr(), data, length) })
+}
+
+/// NUL-separated byte strings.
+fn split(list: &[u8]) -> impl Iterator<Item = &[u8]> {
+	list.split(|&b| b == 0).filter(|s| !s.is_empty())
+}
+
+/// Replaces the clipboard with `items`, an image and files.
+fn set(items: &[(&str, &[u8])], image: Option<(&[u8], u32, u32)>, paths: &[u8], path_count: usize) -> Result<(), Error> {
+	let names: Vec<CString> = items.iter().map(|(name, _)| c_name(name)).collect();
+	let items: Vec<Item> = items
+		.iter()
+		.zip(&names)
+		.map(|((_, data), name)| Item { name: name.as_ptr(), data: data.as_ptr() as *const c_void, length: data.len() })
+		.collect();
+	let (rgba, width, height) = image.unwrap_or((&[], 0, 0));
+	// SAFETY: the items' names and data outlive the call; `rgba` has width * height * 4 bytes (checked
+	// by the caller) or is unused (width 0); `paths` holds `path_count` NUL-terminated paths.
+	status(unsafe {
+		arboard_haiku_set(
+			items.as_ptr(),
+			items.len(),
+			if width == 0 { std::ptr::null() } else { rgba.as_ptr() },
+			width,
+			height,
+			if path_count == 0 { std::ptr::null() } else { paths.as_ptr() as *const c_char },
+			path_count,
+		)
+	})
+}
+
+#[cfg(feature = "image-data")]
+fn encode_as_png(image: &ImageData) -> Result<Vec<u8>, Error> {
+	use image::ImageEncoder as _;
+	let mut png = Vec::new();
+	image::codecs::png::PngEncoder::new(&mut png)
+		.write_image(&image.bytes, image.width as u32, image.height as u32, image::ExtendedColorType::Rgba8)
+		.map_err(|_| Error::ConversionFailure)?;
+	Ok(png)
+}
+
+pub(crate) struct Clipboard;
+
+impl Clipboard {
+	pub(crate) fn new() -> Result<Self, Error> {
+		Ok(Clipboard)
+	}
+}
+
+pub(crate) struct Get<'clipboard> {
+	_clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Get<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { _clipboard: clipboard }
+	}
+
+	pub(crate) fn text(self) -> Result<String, Error> {
+		// wayland_server's data offers keep the client's MIME type as it was
+		let bytes = match get_data(TEXT) {
+			Err(Error::ContentNotAvailable) => get_data("text/plain;charset=utf-8")?,
+			other => other?,
+		};
+		String::from_utf8(bytes).map_err(|_| Error::ConversionFailure)
+	}
+
+	pub(crate) fn html(self) -> Result<String, Error> {
+		String::from_utf8(get_data(HTML)?).map_err(|_| Error::ConversionFailure)
+	}
+
+	#[cfg(feature = "image-data")]
+	pub(crate) fn image(self) -> Result<ImageData<'static>, Error> {
+		let (mut width, mut height) = (0u32, 0u32);
+		// SAFETY: out-pointers to locals.
+		let bitmap = fetch(|data, length| unsafe { arboard_haiku_get_bitmap(&mut width, &mut height, data, length) });
+		match bitmap {
+			Ok(bytes) => {
+				return Ok(ImageData { width: width as usize, height: height as usize, bytes: bytes.into() })
+			}
+			Err(Error::ContentNotAvailable) => {}
+			Err(e) => return Err(e),
+		}
+		// SAFETY: out-pointers to locals.
+		let types = fetch(|names, length| unsafe { arboard_haiku_get_types(names, length) })?;
+		let mut images: Vec<&str> =
+			split(&types).filter_map(|t| std::str::from_utf8(t).ok()).filter(|t| t.starts_with("image/")).collect();
+		images.sort_by_key(|t| *t != PNG);
+		for name in images {
+			if let Ok(image) = image::load_from_memory(&get_data(name)?) {
+				let image = image.into_rgba8();
+				return Ok(ImageData {
+					width: image.width() as usize,
+					height: image.height() as usize,
+					bytes: image.into_raw().into(),
+				});
+			}
+		}
+		Err(Error::ContentNotAvailable)
+	}
+
+	pub(crate) fn file_list(self) -> Result<Vec<PathBuf>, Error> {
+		// SAFETY: out-pointers to locals.
+		match fetch(|paths, length| unsafe { arboard_haiku_get_refs(paths, length) }) {
+			Ok(list) => return Ok(split(&list).map(|p| PathBuf::from(OsStr::from_bytes(p))).collect()),
+			Err(Error::ContentNotAvailable) => {}
+			Err(e) => return Err(e),
+		}
+		let uris = get_data(URI_LIST)?;
+		let paths: Vec<PathBuf> = uris
+			.split(|&b| b == b'\n')
+			.map(|line| line.strip_suffix(b"\r").unwrap_or(line))
+			.filter_map(|line| line.strip_prefix(b"file://"))
+			.map(|path| PathBuf::from(OsStr::from_bytes(&percent_encoding::percent_decode(path).collect::<Vec<u8>>())))
+			.collect();
+		if paths.is_empty() {
+			Err(Error::ContentNotAvailable)
+		} else {
+			Ok(paths)
+		}
+	}
+}
+
+pub(crate) struct Set<'clipboard> {
+	_clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Set<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { _clipboard: clipboard }
+	}
+
+	pub(crate) fn text(self, data: Cow<'_, str>) -> Result<(), Error> {
+		set(&[(TEXT, data.as_bytes())], None, &[], 0)
+	}
+
+	pub(crate) fn html(self, html: Cow<'_, str>, alt: Option<Cow<'_, str>>) -> Result<(), Error> {
+		match &alt {
+			Some(alt) => set(&[(HTML, html.as_bytes()), (TEXT, alt.as_bytes())], None, &[], 0),
+			None => set(&[(HTML, html.as_bytes())], None, &[], 0),
+		}
+	}
+
+	#[cfg(feature = "image-data")]
+	pub(crate) fn image(self, data: ImageData) -> Result<(), Error> {
+		let (width, height) = (data.width as u32, data.height as u32);
+		if width == 0 || height == 0 || data.bytes.len() != data.width * data.height * 4 {
+			return Err(Error::ConversionFailure);
+		}
+		let png = encode_as_png(&data)?;
+		set(&[(PNG, &png)], Some((&data.bytes, width, height)), &[], 0)
+	}
+
+	pub(crate) fn file_list(self, file_list: &[impl AsRef<Path>]) -> Result<(), Error> {
+		let mut paths = Vec::new();
+		let mut uris = String::new();
+		for path in file_list {
+			let path = std::fs::canonicalize(path.as_ref()).map_err(|_| Error::ConversionFailure)?;
+			paths.extend_from_slice(path.as_os_str().as_bytes());
+			paths.push(0);
+			let encoded = percent_encoding::percent_encode(path.as_os_str().as_bytes(), percent_encoding::NON_ALPHANUMERIC)
+				.to_string()
+				.replace("%2F", "/");
+			uris.push_str(&format!("file://{encoded}\r\n"));
+		}
+		set(&[(URI_LIST, uris.as_bytes())], None, &paths, file_list.len())
+	}
+}
+
+pub(crate) struct Clear<'clipboard> {
+	_clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Clear<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { _clipboard: clipboard }
+	}
+
+	pub(crate) fn clear(self) -> Result<(), Error> {
+		// SAFETY: no arguments.
+		status(unsafe { arboard_haiku_clear() })
+	}
+}
