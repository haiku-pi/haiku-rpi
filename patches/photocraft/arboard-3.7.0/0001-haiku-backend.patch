+/*
+ * arboard on Haiku: the system clipboard (BClipboard "system", the one be_clipboard names), for
+ * src/platform/haiku.rs; built by build.rs. No BApplication is needed: a BClipboard talks to the
+ * registrar.
+ *
+ * Formats, as Haiku's own applications use them:
+ *   - text and other data: a B_MIME_TYPE field named by its MIME type ("text/plain", "text/html", ...);
+ *   - images: "image/bitmap", an archived BBitmap (BBitmap::Archive: "class", "_frame", "_cspace",
+ *     "_bmflags", "_rowbytes", "_data"), as ShowImage and Screenshot copy them; read from "image/x-be-bitmap"
+ *     too. Written here in B_RGBA32 (B, G, R, A in memory) without making a BBitmap (no app_server needed);
+ *   - files: the Tracker's form (FSClipboard): for each file an entry_ref named "r<device>_<node>" and an
+ *     int32 "m<device>_<node>", the Tracker's copy or move mode.
+ *
+ * Return values: 0 done (data returned in malloc'd memory: free with arboard_haiku_free), 1 no such
+ * content, 2 content in a form that cannot be converted, -1 the clipboard cannot be locked.
+ */
+#include <Clipboard.h>
+#include <Entry.h>
+#include <GraphicsDefs.h>
+#include <Message.h>
+#include <Path.h>
+#include <Rect.h>
+#include <String.h>
+#include <SupportDefs.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+namespace {
+
+// the Tracker's command for pasting copied (not cut) files: kCopySelectionTo in tracker/Commands.h
+const int32 kTrackerCopy = 'Tcsl';
+
+
+BClipboard*
+system_clipboard()
+{
+	static BClipboard* clipboard = new BClipboard(NULL);
+	return clipboard;
+}
+
+
+/* Locks the clipboard (its contents fetched from the registrar) for the scope. */
+class Locked {
+public:
+	Locked()
+		:
+		fClipboard(system_clipboard()),
+		fLocked(fClipboard->Lock())
+	{
+	}
+
+	~Locked()
+	{
+		if (fLocked)
+			fClipboard->Unlock();
+	}
+
+	BMessage* Data() const
+	{
+		return fLocked ? fClipboard->Data() : NULL;
+	}
+
+	BClipboard* Clipboard() const
+	{
+		return fClipboard;
+	}
+
+private:
+	BClipboard*	fClipboard;
+	bool		fLocked;
+};
+
+
+int
+copy_out(const void* data, size_t size, void** out, size_t* length)
+{
+	*out = malloc(size > 0 ? size : 1);
+	if (*out == NULL)
+		return 2;
+	memcpy(*out, data, size);
+	*length = size;
+	return 0;
+}
+
+}	// namespace
+
+
+/* The B_MIME_TYPE field `name`. */
+extern "C" int
+arboard_haiku_get_data(const char* name, void** data, size_t* length)
+{
+	*data = NULL;
+	*length = 0;
+	Locked locked;
+	BMessage* clip = locked.Data();
+	if (clip == NULL)
+		return -1;
+	const void* found;
+	ssize_t size;
+	if (clip->FindData(name, B_MIME_TYPE, &found, &size) != B_OK)
+		return 1;
+	return copy_out(found, size, data, length);
+}
+
+
+/* The names of the B_MIME_TYPE fields, each NUL-terminated, one after the other. */
+extern "C" int
+arboard_haiku_get_types(void** names, size_t* length)
+{
+	*names = NULL;
+	*length = 0;
+	Locked locked;
+	BMessage* clip = locked.Data();
+	if (clip == NULL)
+		return -1;
+	BString list;
+	char* name;
+	type_code type;
+	for (int32 i = 0; clip->GetInfo(B_MIME_TYPE, i, &name, &type) == B_OK; i++) {
+		list.Append(name);
+		list.Append('\0', 1);
+	}
+	if (list.Length() == 0)
+		return 1;
+	return copy_out(list.String(), list.Length(), names, length);
+}
+
+
+/* An archived BBitmap as straight RGBA, 4 bytes per pixel, rows without padding. */
+extern "C" int
+arboard_haiku_get_bitmap(uint32_t* width, uint32_t* height, void** rgba, size_t* length)
+{
+	*rgba = NULL;
+	*length = 0;
+	BMessage archive;
+	{
+		Locked locked;
+		BMessage* clip = locked.Data();
+		if (clip == NULL)
+			return -1;
+		if (clip->FindMessage("image/bitmap", &archive) != B_OK
+			&& clip->FindMessage("image/x-be-bitmap", &archive) != B_OK)
+			return 1;
+	}
+
+	BRect frame;
+	int32 space;
+	const void* data;
+	ssize_t size;
+	if (archive.FindRect("_frame", &frame) != B_OK || archive.FindInt32("_cspace", &space) != B_OK
+		|| archive.FindData("_data", B_RAW_TYPE, &data, &size) != B_OK || !frame.IsValid())
+		return 2;
+	uint32 w = frame.IntegerWidth() + 1;
+	uint32 h = frame.IntegerHeight() + 1;
+	uint32 pixelBytes;
+	switch (space) {
+		case B_RGBA32:
+		case B_RGB32:
+			pixelBytes = 4;
+			break;
+		case B_RGB24:
+			pixelBytes = 3;
+			break;
+		case B_GRAY8:
+			pixelBytes = 1;
+			break;
+		default:
+			return 2;
+	}
+	int32 rowBytes;
+	if (archive.FindInt32("_rowbytes", &rowBytes) != B_OK || rowBytes <= 0)
+		rowBytes = (w * pixelBytes + 3) & ~3;
+	if ((uint64)rowBytes < (uint64)w * pixelBytes || (uint64)size < (uint64)rowBytes * h)
+		return 2;
+
+	uint8* out = (uint8*)malloc((size_t)w * h * 4);
+	if (out == NULL)
+		return 2;
+	for (uint32 y = 0; y < h; y++) {
+		const uint8* in = (const uint8*)data + (size_t)y * rowBytes;
+		uint8* to = out + (size_t)y * w * 4;
+		for (uint32 x = 0; x < w; x++, to += 4) {
+			switch (space) {
+				case B_RGBA32:
+					to[0] = in[2]; to[1] = in[1]; to[2] = in[0]; to[3] = in[3];
+					in += 4;
+					break;
+				case B_RGB32:
+					to[0] = in[2]; to[1] = in[1]; to[2] = in[0]; to[3] = 255;
+					in += 4;
+					break;
+				case B_RGB24:
+					to[0] = in[2]; to[1] = in[1]; to[2] = in[0]; to[3] = 255;
+					in += 3;
+					break;
+				case B_GRAY8:
+					to[0] = to[1] = to[2] = in[0]; to[3] = 255;
+					in += 1;
+					break;
+			}
+		}
+	}
+	*width = w;
+	*height = h;
+	*rgba = out;
+	*length = (size_t)w * h * 4;
+	return 0;
+}
+
+
+/* The Tracker's copied files: their paths, each NUL-terminated, one after the other. */
+extern "C" int
+arboard_haiku_get_refs(void** paths, size_t* length)
+{
+	*paths = NULL;
+	*length = 0;
+	Locked locked;
+	BMessage* clip = locked.Data();
+	if (clip == NULL)
+		return -1;
+	BString list;
+	char* name;
+	type_code type;
+	int32 count;
+	for (int32 i = 0; clip->GetInfo(B_REF_TYPE, i, &name, &type, &count) == B_OK; i++) {
+		if (name[0] != 'r')
+			continue;
+		entry_ref ref;
+		if (clip->FindRef(name, &ref) != B_OK)
+			continue;
+		BPath path(&ref);
+		if (path.InitCheck() != B_OK)
+			continue;
+		list.Append(path.Path());
+		list.Append('\0', 1);
+	}
+	if (list.Length() == 0)
+		return 1;
+	return copy_out(list.String(), list.Length(), paths, length);
+}
+
+
+struct arboard_haiku_item {
+	const char*	name;
+	const void*	data;
+	size_t		length;
+};
+
+
+/* Replaces the clipboard's contents with `items` (B_MIME_TYPE fields), plus, when given, an image
+ * (`rgba`, straight RGBA, width * height * 4 bytes) as "image/bitmap" and files (`paths`, `pathCount`
+ * NUL-terminated paths one after the other) in the Tracker's form. */
+extern "C" int
+arboard_haiku_set(const struct arboard_haiku_item* items, size_t count, const uint8_t* rgba,
+	uint32_t width, uint32_t height, const char* paths, size_t pathCount)
+{
+	Locked locked;
+	BMessage* clip = locked.Data();
+	if (clip == NULL)
+		return -1;
+	locked.Clipboard()->Clear();
+	for (size_t i = 0; i < count; i++)
+		clip->AddData(items[i].name, B_MIME_TYPE, items[i].data, items[i].length);
+
+	if (rgba != NULL && width > 0 && height > 0) {
+		size_t size = (size_t)width * height * 4;
+		uint8* bgra = (uint8*)malloc(size);
+		if (bgra == NULL)
+			return 2;
+		for (size_t i = 0; i < size; i += 4) {
+			bgra[i] = rgba[i + 2];
+			bgra[i + 1] = rgba[i + 1];
+			bgra[i + 2] = rgba[i];
+			bgra[i + 3] = rgba[i + 3];
+		}
+		BMessage archive;
+		archive.AddString("class", "BBitmap");
+		archive.AddRect("_frame", BRect(0, 0, width - 1, height - 1));
+		archive.AddInt32("_cspace", B_RGBA32);
+		archive.AddInt32("_bmflags", 0);
+		archive.AddInt32("_rowbytes", width * 4);
+		archive.AddData("_data", B_RAW_TYPE, bgra, size);
+		free(bgra);
+		clip->AddMessage("image/bitmap", &archive);
+	}
+
+	const char* path = paths;
+	for (size_t i = 0; path != NULL && i < pathCount; i++, path += strlen(path) + 1) {
+		BEntry entry(path);
+		entry_ref ref;
+		node_ref node;
+		if (entry.GetRef(&ref) != B_OK || entry.GetNodeRef(&node) != B_OK)
+			continue;
+		char name[64];
+		snprintf(name, sizeof(name), "r%" B_PRIdDEV "_%" B_PRIdINO, node.device, node.node);
+		clip->AddRef(name, &ref);
+		name[0] = 'm';
+		clip->AddInt32(name, kTrackerCopy);
+	}
+
+	return locked.Clipboard()->Commit() == B_OK ? 0 : -1;
+}
+
+
+extern "C" int
+arboard_haiku_clear()
+{
+	Locked locked;
+	if (locked.Data() == NULL)
+		return -1;
+	locked.Clipboard()->Clear();
+	return locked.Clipboard()->Commit() == B_OK ? 0 : -1;
+}
+
+
+extern "C" void
+arboard_haiku_free(void* pointer)
+{
+	free(pointer);
+}
