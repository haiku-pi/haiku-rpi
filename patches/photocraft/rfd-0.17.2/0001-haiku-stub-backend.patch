rfd: a placeholder backend for Haiku

rfd has no Haiku backend (its xdg-portal and GTK3 ones are for Linux and the BSDs), so FileDialog
and MessageDialog implement none of its traits there and the crate does not build. Add a stub:
every file dialog returns None (as if cancelled), a message dialog the answer that changes nothing
(Cancel, No, or Ok when that is the only button), each noted on standard error. To be replaced by a
native backend (BFilePanel, BAlert) in Photocraft phase P4. Applies with -p1 to rfd 0.17.2.

--- a/src/backend/haiku.rs
+++ b/src/backend/haiku.rs
@@ -0,0 +1,111 @@
+//! Haiku: no dialogs yet.
+//!
+//! A placeholder until a native backend (BFilePanel, BAlert through the Interface Kit) exists:
+//! every file dialog returns `None`, as if the user had cancelled it, and a message dialog returns
+//! the answer that changes nothing (Cancel, No, or Ok when that is the only button). Each call
+//! notes on standard error what it skipped.
+
+use std::path::PathBuf;
+
+use crate::backend::{
+    AsyncFilePickerDialogImpl, AsyncFileSaveDialogImpl, AsyncFolderPickerDialogImpl,
+    AsyncMessageDialogImpl, DialogFutureType, FilePickerDialogImpl, FileSaveDialogImpl,
+    FolderPickerDialogImpl, MessageDialogImpl,
+};
+use crate::message_dialog::{MessageButtons, MessageDialog, MessageDialogResult};
+use crate::{FileDialog, FileHandle};
+
+fn skipped(what: &str, title: Option<&str>) {
+    eprintln!(
+        "rfd: no dialogs on Haiku yet, {what} \"{}\" skipped",
+        title.unwrap_or_default()
+    );
+}
+
+impl FilePickerDialogImpl for FileDialog {
+    fn pick_file(self) -> Option<PathBuf> {
+        skipped("open file", self.title.as_deref());
+        None
+    }
+
+    fn pick_files(self) -> Option<Vec<PathBuf>> {
+        skipped("open files", self.title.as_deref());
+        None
+    }
+}
+
+impl AsyncFilePickerDialogImpl for FileDialog {
+    fn pick_file_async(self) -> DialogFutureType<Option<FileHandle>> {
+        skipped("open file", self.title.as_deref());
+        Box::pin(std::future::ready(None))
+    }
+
+    fn pick_files_async(self) -> DialogFutureType<Option<Vec<FileHandle>>> {
+        skipped("open files", self.title.as_deref());
+        Box::pin(std::future::ready(None))
+    }
+}
+
+impl FolderPickerDialogImpl for FileDialog {
+    fn pick_folder(self) -> Option<PathBuf> {
+        skipped("pick folder", self.title.as_deref());
+        None
+    }
+
+    fn pick_folders(self) -> Option<Vec<PathBuf>> {
+        skipped("pick folders", self.title.as_deref());
+        None
+    }
+}
+
+impl AsyncFolderPickerDialogImpl for FileDialog {
+    fn pick_folder_async(self) -> DialogFutureType<Option<FileHandle>> {
+        skipped("pick folder", self.title.as_deref());
+        Box::pin(std::future::ready(None))
+    }
+
+    fn pick_folders_async(self) -> DialogFutureType<Option<Vec<FileHandle>>> {
+        skipped("pick folders", self.title.as_deref());
+        Box::pin(std::future::ready(None))
+    }
+}
+
+impl FileSaveDialogImpl for FileDialog {
+    fn save_file(self) -> Option<PathBuf> {
+        skipped("save file", self.title.as_deref());
+        None
+    }
+}
+
+impl AsyncFileSaveDialogImpl for FileDialog {
+    fn save_file_async(self) -> DialogFutureType<Option<FileHandle>> {
+        skipped("save file", self.title.as_deref());
+        Box::pin(std::future::ready(None))
+    }
+}
+
+fn no_change(dialog: &MessageDialog) -> MessageDialogResult {
+    skipped("message", Some(&dialog.title));
+    match &dialog.buttons {
+        MessageButtons::Ok => MessageDialogResult::Ok,
+        MessageButtons::OkCancel | MessageButtons::YesNoCancel => MessageDialogResult::Cancel,
+        MessageButtons::YesNo => MessageDialogResult::No,
+        MessageButtons::OkCustom(ok) => MessageDialogResult::Custom(ok.clone()),
+        MessageButtons::OkCancelCustom(_, cancel) => MessageDialogResult::Custom(cancel.clone()),
+        MessageButtons::YesNoCancelCustom(_, _, cancel) => {
+            MessageDialogResult::Custom(cancel.clone())
+        }
+    }
+}
+
+impl MessageDialogImpl for MessageDialog {
+    fn show(self) -> MessageDialogResult {
+        no_change(&self)
+    }
+}
+
+impl AsyncMessageDialogImpl for MessageDialog {
+    fn show_async(self) -> DialogFutureType<MessageDialogResult> {
+        Box::pin(std::future::ready(no_change(&self)))
+    }
+}
