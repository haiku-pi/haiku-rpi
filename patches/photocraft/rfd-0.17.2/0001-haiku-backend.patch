+++ b/src/backend/haiku.rs
@@ -0,0 +1,272 @@
+//! Haiku: the Tracker's file panel (BFilePanel) and BAlert, through a small C++ shim
+//! (`haiku/rfd_haiku.cpp`, built by `build.rs`).
+//!
+//! The panels and alerts are windows of the program's BApplication, which this backend never
+//! creates: a winit program on Haiku's in-process Wayland server gets one when it connects (the
+//! server creates it and relies on it being its own). Without one, a file dialog returns `None` and
+//! a message dialog the answer that changes nothing, each noted on standard error.
+//!
+//! The panel has no list of file types to choose from: all filters are merged into one (a file is
+//! shown when its extension, in any letter case, is in some filter; folders are always shown). With a
+//! parent window the panel is modal to the application's windows. A dialog blocks the calling thread
+//! (the panel runs in its own window thread); the async variants wait on a thread of their own.
+
+use std::ffi::{c_char, c_int, c_void, CString};
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+
+use crate::backend::{
+    AsyncFilePickerDialogImpl, AsyncFileSaveDialogImpl, AsyncFolderPickerDialogImpl,
+    AsyncMessageDialogImpl, DialogFutureType, FilePickerDialogImpl, FileSaveDialogImpl,
+    FolderPickerDialogImpl, MessageDialogImpl,
+};
+use crate::message_dialog::{MessageButtons, MessageDialog, MessageDialogResult, MessageLevel};
+use crate::{FileDialog, FileHandle};
+
+extern "C" {
+    fn rfd_haiku_file_panel(
+        kind: c_int,
+        multiple: c_int,
+        modal: c_int,
+        title: *const c_char,
+        directory: *const c_char,
+        file_name: *const c_char,
+        extensions: *const *const c_char,
+        extension_count: c_int,
+        paths: *mut *mut c_char,
+        length: *mut usize,
+    ) -> c_int;
+    fn rfd_haiku_alert(
+        title: *const c_char,
+        text: *const c_char,
+        level: c_int,
+        labels: *const *const c_char,
+        count: c_int,
+        escape: c_int,
+    ) -> c_int;
+    fn rfd_haiku_free(pointer: *mut c_void);
+}
+
+#[derive(Clone, Copy)]
+enum Panel {
+    Open = 0,
+    Folder = 1,
+    Save = 2,
+}
+
+/// `text` for C: an interior NUL (never in a real name) ends it.
+fn c_string(text: &[u8]) -> CString {
+    let end = text.iter().position(|&b| b == 0).unwrap_or(text.len());
+    CString::new(&text[..end]).unwrap_or_default()
+}
+
+fn no_application(what: &str) {
+    eprintln!("rfd: no BApplication in this program (no Wayland connection yet?), {what} skipped");
+}
+
+/// Shows the panel and waits for it: the chosen paths, `None` if cancelled.
+fn show_panel(dialog: &FileDialog, panel: Panel, multiple: bool) -> Option<Vec<PathBuf>> {
+    let default_title = match panel {
+        Panel::Open => "Open",
+        Panel::Folder => "Select a folder",
+        Panel::Save => "Save",
+    };
+    let title = c_string(dialog.title.as_deref().unwrap_or(default_title).as_bytes());
+    let directory = dialog
+        .starting_directory
+        .as_deref()
+        .map(|d| c_string(d.as_os_str().as_bytes()));
+    let file_name = dialog.file_name.as_deref().map(|n| c_string(n.as_bytes()));
+    let extensions: Vec<CString> = dialog
+        .filters
+        .iter()
+        .flat_map(|f| f.extensions.iter())
+        .map(|e| c_string(e.as_bytes()))
+        .collect();
+    let extension_ptrs: Vec<*const c_char> = extensions.iter().map(|e| e.as_ptr()).collect();
+    let mut paths: *mut c_char = std::ptr::null_mut();
+    let mut length = 0usize;
+    // SAFETY: every pointer is a valid NUL-terminated string (or null where allowed) that outlives
+    // the call; the shim returns a malloc'd buffer of `length` bytes, released below.
+    let count = unsafe {
+        rfd_haiku_file_panel(
+            panel as c_int,
+            multiple as c_int,
+            dialog.parent.is_some() as c_int,
+            title.as_ptr(),
+            directory.as_ref().map_or(std::ptr::null(), |d| d.as_ptr()),
+            file_name.as_ref().map_or(std::ptr::null(), |n| n.as_ptr()),
+            extension_ptrs.as_ptr(),
+            extension_ptrs.len() as c_int,
+            &mut paths,
+            &mut length,
+        )
+    };
+    if count < 0 {
+        no_application(default_title);
+        return None;
+    }
+    if count == 0 || paths.is_null() {
+        return None;
+    }
+    // SAFETY: the shim wrote `length` bytes at `paths`: NUL-terminated paths one after the other.
+    let bytes = unsafe { std::slice::from_raw_parts(paths as *const u8, length) };
+    let list = bytes
+        .split(|&b| b == 0)
+        .filter(|p| !p.is_empty())
+        .map(|p| Path::new(std::ffi::OsStr::from_bytes(p)).to_path_buf())
+        .collect::<Vec<_>>();
+    // SAFETY: allocated by the shim, freed once.
+    unsafe { rfd_haiku_free(paths as *mut c_void) };
+    (!list.is_empty()).then_some(list)
+}
+
+fn first(paths: Option<Vec<PathBuf>>) -> Option<PathBuf> {
+    paths.and_then(|p| p.into_iter().next())
+}
+
+/// Runs `show` on a thread of its own; the future resolves to its answer (the default if the
+/// thread could not be made).
+fn on_thread<T: Default + Send + 'static>(
+    show: impl FnOnce() -> T + Send + 'static,
+) -> DialogFutureType<T> {
+    let (tx, rx) = crate::oneshot::channel();
+    let spawned = std::thread::Builder::new()
+        .name("rfd dialog".into())
+        .spawn(move || {
+            let _ = tx.send(show());
+        });
+    if let Err(e) = spawned {
+        eprintln!("rfd: cannot start the dialog's thread: {e}");
+    }
+    Box::pin(async move { rx.await.unwrap_or_default() })
+}
+
+impl FilePickerDialogImpl for FileDialog {
+    fn pick_file(self) -> Option<PathBuf> {
+        first(show_panel(&self, Panel::Open, false))
+    }
+
+    fn pick_files(self) -> Option<Vec<PathBuf>> {
+        show_panel(&self, Panel::Open, true)
+    }
+}
+
+impl AsyncFilePickerDialogImpl for FileDialog {
+    fn pick_file_async(self) -> DialogFutureType<Option<FileHandle>> {
+        on_thread(move || self.pick_file().map(FileHandle::wrap))
+    }
+
