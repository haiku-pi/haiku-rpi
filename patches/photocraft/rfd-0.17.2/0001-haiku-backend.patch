+/*
+ * rfd's dialogs on Haiku: the Tracker's file panel (BFilePanel) for opening files, picking a folder and
+ * saving, and BAlert for message dialogs. Called from src/backend/haiku.rs; built by build.rs.
+ *
+ * Both need the application's BApplication (be_app), which is not made here: a winit/Wayland program gets
+ * it from the Wayland server add-on, which creates and runs one when the client connects
+ * (wl_ips_client_connected) and expects be_app to be its own. Without be_app the functions return -1.
+ *
+ * A program may exit while a panel or an alert is open (asked to quit, or another thread exits): their
+ * loopers (the panel's or alert's window, the panel's target) would keep running while exit() runs libbe's
+ * static destructors, and a message arriving then makes the thread look itself up in the freed looper list
+ * (a segment violation in BLooperList::FindLooperPred). An exit handler, registered with the first dialog
+ * (after libbe's static objects were made, so it runs before their destructors), locks those loopers and
+ * suspends their threads while they wait, as the Wayland server does with its own.
+ */
+#include <Alert.h>
+#include <Application.h>
+#include <Entry.h>
+#include <FilePanel.h>
+#include <Font.h>
+#include <Looper.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <OS.h>
+#include <Path.h>
+#include <String.h>
+#include <TextView.h>
+#include <Window.h>
+
+#include <compat/sys/stat.h>
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <algorithm>
+#include <vector>
+
+
+namespace {
+
+// the open dialogs' loopers, for the exit handler (never freed: used while the team exits)
+pthread_mutex_t sOpenLock = PTHREAD_MUTEX_INITIALIZER;
+std::vector<BLooper*>* sOpen = new std::vector<BLooper*>;
+bool sExiting = false;
+
+
+// the team exits, `thread` is a looper's whose lock the caller holds: suspend it while it waits (it holds
+// no lock then; a thread that runs user code could be stopped inside malloc(), so a running one gets up to
+// 50 ms to wait again)
+void
+suspend_when_waiting(thread_id thread)
+{
+	if (thread < 0 || thread == find_thread(NULL))
+		return;
+	for (int i = 0; i < 50; i++) {
+		thread_info info;
+		if (get_thread_info(thread, &info) != B_OK)
+			return;
+		if (info.state == B_THREAD_WAITING) {
+			suspend_thread(thread);
+			return;
+		}
+		snooze(1000);
+	}
+}
+
+
+void
+stop_open_dialogs()
+{
+	pthread_mutex_lock(&sOpenLock);
+	sExiting = true;
+	for (size_t i = 0; i < sOpen->size(); i++) {
+		BLooper* looper = (*sOpen)[i];
+		if (looper->LockWithTimeout(200000) == B_OK)
+			suspend_when_waiting(looper->Thread());
+	}
+	// a dialog closing from now on sees sExiting and leaves its loopers alone (an alert's thread that held
+	// its window just now stops the window's thread itself)
+	pthread_mutex_unlock(&sOpenLock);
+}
+
+
+// `looper` (a dialog's window or the panel's target) is running: stopped if the team exits meanwhile
+void
+add_open(BLooper* looper)
+{
+	static pthread_once_t once = PTHREAD_ONCE_INIT;
+	pthread_once(&once, [] { atexit(stop_open_dialogs); });
+	pthread_mutex_lock(&sOpenLock);
+	sOpen->push_back(looper);
+	pthread_mutex_unlock(&sOpenLock);
+}
+
+
+// a dialog closes: its loopers are quit with the list locked, so the exit handler never sees one half gone.
+// Returns with the list locked (unlock with closed()), or never when the team is exiting: the exit handler
+// holds the loopers then, and the calling thread waits for the team's end.
+void
+closing(BLooper* first, BLooper* second = NULL)
+{
+	pthread_mutex_lock(&sOpenLock);
+	if (sExiting) {
+		pthread_mutex_unlock(&sOpenLock);
+		while (true)
+			snooze(1000000);
+	}
+	sOpen->erase(std::remove(sOpen->begin(), sOpen->end(), first), sOpen->end());
+	sOpen->erase(std::remove(sOpen->begin(), sOpen->end(), second), sOpen->end());
+}
+
+
+void
+closed()
+{
+	pthread_mutex_unlock(&sOpenLock);
+}
+
+
+// BAlert::Go() quits the alert (from the calling thread, the window locked) when a button was pressed
+class Alert : public BAlert {
+public:
+	Alert(const char* title, const char* text, const char* button1, const char* button2,
+		const char* button3, alert_type type)
+		:
+		BAlert(title, text, button1, button2, button3, B_WIDTH_AS_USUAL, B_EVEN_SPACING, type)
+	{
+	}
+
+	virtual void Quit()
+	{
+		pthread_mutex_lock(&sOpenLock);
+		if (sExiting) {
+			// the exit handler could not lock this window (this thread holds it): stop its thread here
+			pthread_mutex_unlock(&sOpenLock);
+			suspend_when_waiting(Thread());
+			while (true)
+				snooze(1000000);
+		}
+		sOpen->erase(std::remove(sOpen->begin(), sOpen->end(), this), sOpen->end());
+		BAlert::Quit();
+		pthread_mutex_unlock(&sOpenLock);
+	}
+};
+
+/* Shows the folders and the files whose extension is one of the filters' (any letter case); no filter
+ * or a "*" shows every file. */
+class ExtensionFilter : public BRefFilter {
+public:
+	ExtensionFilter(const char* const* extensions, int count)
+		:
+		fAll(count == 0)
+	{
+		for (int i = 0; i < count; i++) {
+			const char* extension = extensions[i];
+			while (extension[0] == '*' || extension[0] == '.') {
+				if (strcmp(extension, "*") == 0 || strcmp(extension, "*.*") == 0)
+					fAll = true;
+				extension++;
+			}
+			if (extension[0] != '\0')
+				fExtensions.push_back(BString(extension));
+		}
+	}
+
+	virtual bool Filter(const entry_ref* ref, BNode* node, struct stat_beos* stat,
+		const char* mimeType)
+	{
+		if (fAll || S_ISDIR(stat->st_mode))
+			return true;
+		if (S_ISLNK(stat->st_mode)) {
+			BEntry target(ref, true);
+			if (target.IsDirectory())
+				return true;
+		}
+		const char* dot = strrchr(ref->name, '.');
+		if (dot == NULL)
+			return false;
+		for (size_t i = 0; i < fExtensions.size(); i++) {
+			if (strcasecmp(dot + 1, fExtensions[i].String()) == 0)
+				return true;
+		}
+		return false;
+	}
+
+private:
+	bool					fAll;
+	std::vector<BString>	fExtensions;
+};
+
+
+/* The panel's target: keeps its answer (B_REFS_RECEIVED or B_SAVE_REQUESTED). The panel sends B_CANCEL
+ * whenever it is hidden, after an answer too, so B_CANCEL ends the wait. */
+class PanelTarget : public BLooper {
+public:
+	PanelTarget()
+		:
+		BLooper("rfd file panel"),
+		fDone(create_sem(0, "rfd file panel")),
+		fFinished(false)
+	{
+	}
+
+	virtual ~PanelTarget()
+	{
+		delete_sem(fDone);
+	}
+
+	virtual void MessageReceived(BMessage* message)
+	{
+		switch (message->what) {
+			case B_REFS_RECEIVED:
+			case B_SAVE_REQUESTED:
+				if (!fFinished)
+					fAnswer = *message;
+				break;
+			case B_CANCEL:
+				if (!fFinished) {
+					fFinished = true;
+					release_sem(fDone);
+				}
+				break;
+			default:
+				BLooper::MessageReceived(message);
+		}
+	}
+
+	void Wait()
+	{
+		while (acquire_sem(fDone) == B_INTERRUPTED)
+			;
+	}
+
+	// valid after Wait()
+	const BMessage& Answer() const
+	{
+		return fAnswer;
+	}
+
+private:
+	sem_id		fDone;
+	bool		fFinished;
+	BMessage	fAnswer;
+};
+
+
+void
+append_path(BString& paths, const BPath& path)
+{
+	paths.Append(path.Path());
+	paths.Append('\0', 1);
+}
+
+}	// namespace
+
+
+/* kind: 0 open files, 1 pick a folder, 2 save. NULL title/directory/fileName: none. Returns how many paths
+ * it put into *paths (NUL-terminated, one after the other, *length bytes; free with rfd_haiku_free), 0 when
+ * the panel was cancelled, -1 without a BApplication. */
+extern "C" int
+rfd_haiku_file_panel(int kind, int multiple, int modal, const char* title, const char* directory,
+	const char* fileName, const char* const* extensions, int extensionCount, char** paths,
+	size_t* length)
+{
+	*paths = NULL;
+	*length = 0;
+	if (be_app == NULL)
+		return -1;
+
+	PanelTarget* target = new PanelTarget();
+	target->Run();
+	add_open(target);
+	BMessenger messenger(target);
+	ExtensionFilter filter(extensions, extensionCount);
+	BFilePanel* panel = new BFilePanel(kind == 2 ? B_SAVE_PANEL : B_OPEN_PANEL, &messenger, NULL,
+		kind == 1 ? B_DIRECTORY_NODE : B_FILE_NODE, kind == 0 && multiple != 0, NULL,
+		kind == 1 ? NULL : &filter, modal != 0, true);
+	// the name first: the panel enables its Save button for a name when it shows the folder (setting
+	// the name later would leave the button disabled until the first key press)
+	if (kind == 2 && fileName != NULL)
+		panel->SetSaveText(fileName);
+	if (directory != NULL)
+		panel->SetPanelDirectory(directory);
+	if (kind == 1)
+		panel->SetButtonLabel(B_DEFAULT_BUTTON, "Select");
+	if (title != NULL && panel->Window()->Lock()) {
+		panel->Window()->SetTitle(title);
+		panel->Window()->Unlock();
+	}
+	add_open(panel->Window());
+	panel->Show();
+	target->Wait();
+	BMessage answer(target->Answer());
+	closing(panel->Window(), target);
+	delete panel;
+	if (target->Lock())
+		target->Quit();
+	closed();
+
+	BString list;
+	int count = 0;
+	entry_ref ref;
+	if (answer.what == B_SAVE_REQUESTED) {
+		const char* name;
+		if (answer.FindRef("directory", &ref) == B_OK && answer.FindString("name", &name) == B_OK) {
+			BPath path(&ref);
+			if (path.InitCheck() == B_OK && path.Append(name) == B_OK) {
+				append_path(list, path);
+				count++;
+			}
+		}
+	} else if (answer.what == B_REFS_RECEIVED) {
+		for (int32 i = 0; answer.FindRef("refs", i, &ref) == B_OK; i++) {
+			BPath path(&ref);
+			if (path.InitCheck() == B_OK) {
+				append_path(list, path);
+				count++;
+			}
+		}
+	}
+	if (count == 0)
+		return 0;
+	*length = list.Length();
+	*paths = (char*)malloc(*length);
+	if (*paths == NULL)
+		return 0;
+	memcpy(*paths, list.String(), *length);
+	return count;
+}
+
+
+/* level: 0 information, 1 warning, 2 error. labels: 1 to 3 buttons, left to right (the last is the default);
+ * escape: the button Escape stands for, or -1. Returns the button's index, -1 without a BApplication. */
+extern "C" int
+rfd_haiku_alert(const char* title, const char* text, int level, const char* const* labels, int count,
+	int escape)
+{
+	if (be_app == NULL || count < 1 || count > 3)
+		return -1;
+
+	BString message(title);
+	int32 titleLength = message.Length();
+	if (titleLength > 0 && text[0] != '\0')
+		message << "\n\n";
+	message << text;
+
+	alert_type type = level == 2 ? B_STOP_ALERT : level == 1 ? B_WARNING_ALERT : B_INFO_ALERT;
+	BAlert* alert = new Alert(title, message.String(), labels[0], count > 1 ? labels[1] : NULL,
+		count > 2 ? labels[2] : NULL, type);
+	if (titleLength > 0) {
+		// the title in bold, as the first paragraph (an alert's window has no title bar)
+		BFont bold(be_bold_font);
+		alert->TextView()->SetStylable(true);
+		alert->TextView()->SetFontAndColor(0, titleLength, &bold);
+	}
+	if (escape >= 0 && escape < count)
+		alert->SetShortcut(escape, B_ESCAPE);
+	add_open(alert);
+	return alert->Go();
+}
+
+
+extern "C" void
+rfd_haiku_free(void* pointer)
+{
+	free(pointer);
+}
