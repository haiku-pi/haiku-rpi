+}
+
+/// The buttons left to right, as Haiku orders them (the affirmative one last, the default), with
+/// the answer of each, and the index of the one Escape stands for.
+fn buttons(buttons: &MessageButtons) -> (Vec<(String, MessageDialogResult)>, Option<usize>) {
+    use MessageDialogResult::{Cancel, Custom, No, Ok, Yes};
+    let custom = |label: &String| (label.clone(), Custom(label.clone()));
+    match buttons {
+        MessageButtons::Ok => (vec![("OK".into(), Ok)], Some(0)),
+        MessageButtons::OkCancel => (vec![("Cancel".into(), Cancel), ("OK".into(), Ok)], Some(0)),
+        MessageButtons::YesNo => (vec![("No".into(), No), ("Yes".into(), Yes)], Some(0)),
+        MessageButtons::YesNoCancel => (
+            vec![("Cancel".into(), Cancel), ("No".into(), No), ("Yes".into(), Yes)],
+            Some(0),
+        ),
+        MessageButtons::OkCustom(ok) => (vec![custom(ok)], Some(0)),
+        MessageButtons::OkCancelCustom(ok, cancel) => {
+            (vec![custom(cancel), custom(ok)], Some(0))
+        }
+        MessageButtons::YesNoCancelCustom(yes, no, cancel) => {
+            (vec![custom(cancel), custom(no), custom(yes)], Some(0))
+        }
+    }
+}
+
+/// The answer that changes nothing: Escape's button.
+fn no_change(dialog: &MessageDialog) -> MessageDialogResult {
+    let (list, escape) = buttons(&dialog.buttons);
+    escape
+        .and_then(|i| list.into_iter().nth(i))
+        .map_or(MessageDialogResult::Cancel, |(_, answer)| answer)
+}
+
+impl MessageDialogImpl for MessageDialog {
+    fn show(self) -> MessageDialogResult {
+        let (list, escape) = buttons(&self.buttons);
+        let labels: Vec<CString> = list.iter().map(|(l, _)| c_string(l.as_bytes())).collect();
+        let label_ptrs: Vec<*const c_char> = labels.iter().map(|l| l.as_ptr()).collect();
+        let title = c_string(self.title.as_bytes());
+        let text = c_string(self.description.as_bytes());
+        let level = match self.level {
+            MessageLevel::Info => 0,
+            MessageLevel::Warning => 1,
+            MessageLevel::Error => 2,
+        };
+        // SAFETY: valid NUL-terminated strings that outlive the call; 1 to 3 labels.
+        let pressed = unsafe {
+            rfd_haiku_alert(
+                title.as_ptr(),
+                text.as_ptr(),
+                level,
+                label_ptrs.as_ptr(),
+                label_ptrs.len() as c_int,
+                escape.map_or(-1, |i| i as c_int),
+            )
+        };
+        match usize::try_from(pressed).ok().and_then(|i| list.get(i)) {
+            Some((_, answer)) => answer.clone(),
+            None => {
+                no_application("message");
+                no_change(&self)
+            }
+        }
+    }
+}
+
+impl AsyncMessageDialogImpl for MessageDialog {
+    fn show_async(self) -> DialogFutureType<MessageDialogResult> {
+        on_thread(move || self.show())
+    }
+}
