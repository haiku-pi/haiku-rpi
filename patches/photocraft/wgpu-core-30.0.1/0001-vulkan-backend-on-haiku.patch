wgpu-core: the Vulkan backend on Haiku

As in wgpu: the vulkan alias and the platform dependency that turns on wgpu-hal's backends
(wgpu-core-deps-windows-linux-android) include Haiku; GL stays off there (windows_linux_android is
unchanged). Applies with -p1 to wgpu-core 30.0.1.

--- a/build.rs
+++ b/build.rs
@@ -18,6 +18,7 @@
         ) },
         vulkan: { any(
             all(windows_linux_android, feature = "vulkan"), // Regular Vulkan
+            all(target_os = "haiku", feature = "vulkan"), // Vulkan on Haiku (Mesa)
             all(target_vendor = "apple", feature = "vulkan-portability") // Vulkan Portability on Apple
         ) },
         drm: { all(
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -212,7 +212,7 @@
 version = "30.0.0"
 optional = true
 
-[target.'cfg(any(windows, target_os = "linux", target_os = "android", target_os = "freebsd"))'.dependencies.wgpu-core-deps-windows-linux-android]
+[target.'cfg(any(windows, target_os = "linux", target_os = "android", target_os = "freebsd", target_os = "haiku"))'.dependencies.wgpu-core-deps-windows-linux-android]
 version = "30.0.0"
 optional = true
 
