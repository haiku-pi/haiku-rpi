+    /// Connect to the default Wayland display through libwayland's `wl_display_connect(NULL)`
+    ///
+    /// On Haiku, libwayland-client talks to an in-process server (`wayland-server-inproc.so`,
+    /// windows on the native app_server) set up by `wl_display_connect()`: there is no socket to
+    /// pass to [`Backend::connect()`]. Only the `sys` backend can do this; the `rust` one fails.
+    #[cfg(target_os = "haiku")]
+    pub fn connect_default() -> Result<Self, NoWaylandLib> {
+        client_impl::InnerBackend::connect_default().map(|backend| Self { backend })
+    }
+
     /// Get a [`WeakBackend`] from this backend
     pub fn downgrade(&self) -> WeakBackend {
         WeakBackend { inner: self.backend.downgrade() }
