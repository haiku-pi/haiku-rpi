@@ -0,0 +1,261 @@
+//! Vulkan surfaces for the Wayland windows of Haiku's in-process Wayland server.
+//!
+//! Haiku has no Wayland Vulkan WSI. Its Wayland server (X547's `wayland_server`, an add-on that
+//! libwayland-client loads into the client's process) shows each toplevel as a native window and each
+//! `wl_surface` as a `BView` in it, and Mesa's Haiku WSI presents into a `BView`:
+//! `VK_EXT_headless_surface` with a `VkHaikuSurfaceCreateInfoMESA` chained (Mesa's
+//! `<vulkan/vk_haiku_surface.h>`). The server hands out a surface's view with
+//! `wl_ips_haiku_surface_view(id)`, which also marks the surface as presented that way: it has no
+//! buffers, its window geometry is its size.
+//!
+//! As a Wayland WSI does, each present commits the `wl_surface`: the commit applies the window geometry
+//! (the size of the view and of its window, and the window's first showing) and the frame callbacks
+//! that winit waits for before it redraws.
+//!
+//! `WGPU_HAIKU_TRACE=1` logs (target `wgpu_hal::vulkan::haiku`, level info) each swapchain made (its
+//! extent, the surface's current extent = the view's size as Mesa last saw it, and how long asking took),
+//! and the first 60 acquires and presents, then every 100th (time since the surface was made, image,
+//! suboptimal, duration of the acquire).
+//!
+//! Limitations: the frames are drawn by Mesa's presenter thread, not in step with the commit, so a resize
+//! shows a frame or two scaled to the new size; when another window uncovers the view, its content stays
+//! as it was until the next present (the server has no copy of the frame to redraw it with).
+
+use alloc::{boxed::Box, string::String, sync::Arc};
+use core::{
+    ffi::{c_void, CStr},
+    mem, ptr,
+    sync::atomic::{AtomicU32, Ordering},
+    time::Duration,
+};
+use std::time::Instant;
+
+use ash::{ext, vk};
+
+/// Mesa's `VK_STRUCTURE_TYPE_HAIKU_SURFACE_CREATE_INFO_MESA`.
+const STRUCTURE_TYPE_HAIKU_SURFACE_CREATE_INFO_MESA: i32 = 1000256900;
+
+/// Mesa's `VkHaikuSurfaceCreateInfoMESA`.
+#[repr(C)]
+struct HaikuSurfaceCreateInfoMesa {
+    s_type: vk::StructureType,
+    p_next: *const c_void,
+    flags: vk::Flags,
+    /// The `BView` to present into.
+    view: *mut c_void,
+}
+
+// The Vulkan loader copies the create info with this size (its Haiku patch).
+const _: () = assert!(size_of::<HaikuSurfaceCreateInfoMesa>() == 32);
+
+/// `wl_surface.commit`'s opcode.
+const WL_SURFACE_COMMIT: u32 = 6;
+
+type ProxyGetId = unsafe extern "C" fn(proxy: *mut c_void) -> u32;
+type ProxyGetVersion = unsafe extern "C" fn(proxy: *mut c_void) -> u32;
+type ProxyMarshalFlags = unsafe extern "C" fn(
+    proxy: *mut c_void,
+    opcode: u32,
+    interface: *const c_void,
+    version: u32,
+    flags: u32,
+    ...
+) -> *mut c_void;
+type SurfaceView = unsafe extern "C" fn(surface_id: u32) -> *mut c_void;
+
+/// The `wl_surface` of a Vulkan surface: committed after each present.
+pub(super) struct WaylandSurface {
+    id: u32,
+    surface: *mut c_void,
+    version: u32,
+    marshal_flags: ProxyMarshalFlags,
+    trace: Option<Trace>,
+}
+
+/// `WGPU_HAIKU_TRACE`: the surface's swapchain events, with the time since the surface was made.
+struct Trace {
+    start: Instant,
+    acquires: AtomicU32,
+    presents: AtomicU32,
+}
+
+impl Trace {
+    /// The event's number, if it is one to log: the first 60, then every 100th.
+    fn due(counter: &AtomicU32) -> Option<u32> {
+        let n = counter.fetch_add(1, Ordering::Relaxed);
+        (n < 60 || n % 100 == 0).then_some(n)
+    }
+
+    fn ms(&self) -> u128 {
+        self.start.elapsed().as_millis()
+    }
+}
+
+// libwayland-client's requests may be sent from any thread.
+unsafe impl Send for WaylandSurface {}
+unsafe impl Sync for WaylandSurface {}
+
+impl WaylandSurface {
+    /// `WGPU_HAIKU_TRACE`: a swapchain was made.
+    pub(super) fn trace_configure(
+        &self,
+        extent: vk::Extent2D,
+        replaces: bool,
+        current: Result<vk::Extent2D, vk::Result>,
+        query: Duration,
+    ) {
+        if let Some(t) = &self.trace {
+            log::info!(
+                "trace +{} ms wl_surface@{}: swapchain {}x{}{}, surface current extent {:?} (asked in {} us)",
+                t.ms(),
+                self.id,
+                extent.width,
+                extent.height,
+                if replaces { " (replaces one)" } else { "" },
+                current.map(|e| (e.width, e.height)),
+                query.as_micros()
+            );
+        }
+    }
+
+    /// `WGPU_HAIKU_TRACE`: an image was acquired (or not).
+    pub(super) fn trace_acquire(&self, result: Result<(u32, bool), vk::Result>, took: Duration) {
+        if let Some(t) = &self.trace {
+            if let Some(n) = Trace::due(&t.acquires) {
+                log::info!(
+                    "trace +{} ms wl_surface@{}: acquire #{n}: {result:?} (index, suboptimal) in {} us",
+                    t.ms(),
+                    self.id,
+                    took.as_micros()
+                );
+            }
+        }
+    }
+
+    /// `WGPU_HAIKU_TRACE`: an image was presented (or not).
+    pub(super) fn trace_present(&self, index: u32, result: Result<bool, vk::Result>, took: Duration) {
+        if let Some(t) = &self.trace {
+            if let Some(n) = Trace::due(&t.presents) {
+                log::info!(
+                    "trace +{} ms wl_surface@{}: present #{n} image {index}: {result:?} (suboptimal) in {} us",
+                    t.ms(),
+                    self.id,
+                    took.as_micros()
+                );
+            }
+        }
+    }
+
+    /// `wl_surface.commit`.
+    pub(super) fn commit(&self) {
+        unsafe {
+            (self.marshal_flags)(
+                self.surface,
+                WL_SURFACE_COMMIT,
+                ptr::null(),
+                self.version,
+                0,
+            )
+        };
+    }
+}
+
+/// `dlsym(dlopen(library), name)`. The libraries are loaded already (libwayland-client by the
+/// application, the server by libwayland-client); the handles are not closed.
+fn symbol(library: &CStr, name: &CStr) -> Result<*mut c_void, crate::InstanceError> {
+    let handle = unsafe { libc::dlopen(library.as_ptr(), libc::RTLD_NOW) };
+    let symbol = if handle.is_null() {
+        ptr::null_mut()
+    } else {
+        unsafe { libc::dlsym(handle, name.as_ptr()) }
+    };
+    if symbol.is_null() {
+        return Err(crate::InstanceError::new(format!(
+            "Haiku Wayland surface: no {} in {}",
+            name.to_string_lossy(),
+            library.to_string_lossy()
+        )));
+    }
+    Ok(symbol)
+}
+
+impl super::Instance {
+    /// A surface for a `wl_surface` of Haiku's in-process Wayland server: Mesa's Haiku WSI on the
+    /// surface's `BView`.
+    pub(super) fn create_surface_from_haiku_wayland(
+        &self,
+        surface: *mut c_void,
+    ) -> Result<super::Surface, crate::InstanceError> {
+        if !self
+            .shared
+            .extensions
+            .contains(&ext::headless_surface::NAME)
+        {
+            return Err(crate::InstanceError::new(String::from(
+                "Vulkan driver does not support VK_EXT_headless_surface (Haiku's window surfaces)",
+            )));
+        }
+
+        let client: &CStr = c"libwayland-client.so.0";
+        let server: &CStr = c"wayland-server-inproc.so";
+        let get_id: ProxyGetId =
+            unsafe { mem::transmute(symbol(client, c"wl_proxy_get_id")?) };
+        let get_version: ProxyGetVersion =
+            unsafe { mem::transmute(symbol(client, c"wl_proxy_get_version")?) };
+        let marshal_flags: ProxyMarshalFlags =
+            unsafe { mem::transmute(symbol(client, c"wl_proxy_marshal_flags")?) };
+        let surface_view: SurfaceView = unsafe {
+            mem::transmute(symbol(server, c"wl_ips_haiku_surface_view").map_err(|e| {
+                crate::InstanceError::new(format!(
+                    "{} (wayland_server 0.1.20251004-8 or later is needed)",
+                    e.message
+                ))
+            })?)
+        };
+
+        let id = unsafe { get_id(surface) };
+        let view = unsafe { surface_view(id) };
+        if view.is_null() {
+            return Err(crate::InstanceError::new(format!(
+                "Haiku Wayland surface: wl_surface@{id} has no view (no xdg_toplevel yet?)"
+            )));
+        }
+
+        let haiku_info = HaikuSurfaceCreateInfoMesa {
+            s_type: vk::StructureType::from_raw(STRUCTURE_TYPE_HAIKU_SURFACE_CREATE_INFO_MESA),
+            p_next: ptr::null(),
+            flags: 0,
+            view,
+        };
+        let mut info = vk::HeadlessSurfaceCreateInfoEXT::default();
+        info.p_next = (&raw const haiku_info).cast();
+        let loader = ext::headless_surface::Instance::new(&self.shared.entry, &self.shared.raw);
+        let raw = unsafe { loader.create_headless_surface(&info, None) }.map_err(|e| {
+            crate::InstanceError::with_source(
+                String::from("vkCreateHeadlessSurfaceEXT on a Haiku view failed"),
+                e,
+            )
+        })?;
+        log::info!("Haiku Wayland surface: wl_surface@{id}, view {view:?}, {raw:?}");
+
+        let mut native = super::swapchain::NativeSurface::from_vk_surface_khr(self, raw, None);
+        let trace = std::env::var_os("WGPU_HAIKU_TRACE")
+            .is_some_and(|v| v != "0")
+            .then(|| Trace {
+                start: Instant::now(),
+                acquires: AtomicU32::new(0),
+                presents: AtomicU32::new(0),
+            });
+        native.wayland = Some(Arc::new(WaylandSurface {
+            id,
+            surface,
+            version: unsafe { get_version(surface) },
+            marshal_flags,
+            trace,
+        }));
+        Ok(super::Surface {
+            swapchain: parking_lot::RwLock::new(None),
+            inner: Box::new(native),
+        })
+    }
+}
