FEX (Windows): commit a bounded range on an overcommit fault under Wine too; a failed commit is not handled

FEX reserves large ranges (its code buffers and allocator arenas, 512 MiB each here) and commits them on the
first fault. Under Wine it committed the whole reservation at once, which costs nothing on Linux (overcommit),
but takes real commit charge where the host accounts for it: on Haiku a few of them exhausted the Pi's 4 GiB
("low resource memory: critical"), VirtualAlloc failed, the handler said the fault was handled anyway, and
the threads faulted on the same access forever (OpenTTD's x86-64 build: three threads spinning, the rest
waiting on Wine's loader lock). Now the bounded commit (64 KiB around the fault) is used under Wine too, and
a commit that fails leaves the exception to the program.

--- a/Source/Windows/Common/OvercommitTracker.h
+++ b/Source/Windows/Common/OvercommitTracker.h
@@ -12,7 +12,7 @@
  */
 class OvercommitTracker {
 private:
-  bool IsWine;
+  [[maybe_unused]] bool IsWine;
   FEXCore::IntervalList<uint64_t> OvercommitIntervals;
   std::shared_mutex OvercommitIntervalsMutex;
 
@@ -35,17 +35,13 @@
     auto Query = OvercommitIntervals.Query(FaultAddress);
 
     if (Query.Enclosed) {
-      if (IsWine) {
-        MEMORY_BASIC_INFORMATION Info;
-        NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(FaultAddress), MemoryBasicInformation, &Info, sizeof(Info), nullptr);
-        const auto CommitSize = reinterpret_cast<SIZE_T>(Info.BaseAddress) + Info.RegionSize - reinterpret_cast<SIZE_T>(Info.AllocationBase);
-        VirtualAlloc(reinterpret_cast<void*>(Info.AllocationBase), CommitSize, MEM_COMMIT, PAGE_READWRITE);
-      } else {
-        static constexpr size_t MaxFaultCommitSize = 1024 * 64;
-        const auto AlignedFaultAddress = reinterpret_cast<void*>(FaultAddress & FEXCore::Utils::FEX_PAGE_MASK);
-        VirtualAlloc(AlignedFaultAddress, std::min(Query.Size, MaxFaultCommitSize), MEM_COMMIT, PAGE_READWRITE);
-      }
-      return true;
+      // Commit a bounded range around the fault, under Wine too: committing the whole reservation (as this did
+      // under Wine, where Linux overcommits) takes real commit charge on hosts that account for it (Haiku: a
+      // few of FEX's 512 MiB reservations exhaust a 4 GiB machine). A failed commit is not handled: retrying
+      // the access would fault forever.
+      static constexpr size_t MaxFaultCommitSize = 1024 * 64;
+      const auto AlignedFaultAddress = reinterpret_cast<void*>(FaultAddress & FEXCore::Utils::FEX_PAGE_MASK);
+      return VirtualAlloc(AlignedFaultAddress, std::min(Query.Size, MaxFaultCommitSize), MEM_COMMIT, PAGE_READWRITE) != nullptr;
     }
     return false;
   }
