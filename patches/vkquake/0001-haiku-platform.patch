Haiku: build and run vkQuake 1.35.0 on Haiku

- arch_def.h: Haiku is a POSIX platform (PLATFORM_UNIX + PLATFORM_HAIKU,
  platform string "Haiku"); net_sys.h: its struct sockaddr has sa_len.
- meson.build: sockets are in libnetwork; task affinity only when
  pthread_setaffinity_np links (Haiku's <sched.h> has CPU_ZERO but libroot no
  pthread_setaffinity_np); the executable is installed (an install drops the
  build tree's rpath).
- sys_sdl_unix.c: no d_type in Haiku's struct dirent (stat the entry instead);
  no backtrace() in libroot (no stack trace; the debug server reports crashes);
  the user directory is <B_USER_NONPACKAGED_DATA_DIRECTORY>/vkQuake and the
  base directory the binary's (Tracker starts programs in the home directory),
  as QuakeSpasm does on Haiku.

diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -16,7 +16,9 @@
 endif
 
 if host_machine.system() != 'windows'
-    if cc.has_header_symbol('sched.h', 'CPU_ZERO', prefix: '#define _GNU_SOURCE')
+    if cc.has_header_symbol('sched.h', 'CPU_ZERO', prefix: '#define _GNU_SOURCE') and \
+            cc.has_function('pthread_setaffinity_np', prefix: '#define _GNU_SOURCE\n#include <pthread.h>',
+                dependencies: dependency('threads'))
         message('Info: Task affinity support enabled.')
         add_project_arguments('-D_GNU_SOURCE', language: 'c')
     else
@@ -314,6 +316,11 @@
     sdl_dep,
 ]
 
+if host_machine.system() == 'haiku'
+    # BSD sockets are in libnetwork
+    deps += cc.find_library('network')
+endif
+
 if host_machine.system() == 'windows'
     foreach syslib : ['ws2_32', 'winmm', 'dbghelp']
         deps += cc.find_library(syslib)
@@ -442,4 +449,5 @@
     include_directories : incdirs,
     c_args : cflags,
     c_pch : 'Quake/quakedef.h',
-    win_subsystem : 'windows')
+    win_subsystem : 'windows',
+    install : true)
