+// #pragma mark - the overlay plane
+
+void MediaPlayerPrivate::releaseVideoBuffers()
+{
+    m_yuv = false;
+    free(m_yuvBuffer);
+    m_yuvBuffer = nullptr;
+}
+
+// Whether the video can be shown on the plane in this paint: into the page's
+// offscreen view, wholly inside it, not rotated or sheared. viewRect: its
+// pixels in the view.
+bool MediaPlayerPrivate::overlayTarget(BView* target, const FloatRect& r, BRect& viewRect)
+{
+    if (!target || strcmp(target->Name(), "WebKit offscreen view"))
+        return false;
+    BAffineTransform toView = target->TransformTo(B_VIEW_COORDINATES);
+    if (!toView.IsDilation() || toView.sx <= 0 || toView.sy <= 0)
+        return false;
+    const BPoint leftTop = toView.Apply(BPoint(r.x(), r.y()));
+    const BPoint rightBottom = toView.Apply(BPoint(r.maxX(), r.maxY()));
+    const int32 left = (int32)roundf(leftTop.x);
+    const int32 top = (int32)roundf(leftTop.y);
+    const int32 right = (int32)roundf(rightBottom.x);
+    const int32 bottom = (int32)roundf(rightBottom.y);
+    const BRect bounds = target->Bounds();
+    if (right - left < 16 || bottom - top < 16 || left < bounds.left || top < bounds.top
+        || right > bounds.right + 1 || bottom > bounds.bottom + 1)
+        return false;
+    viewRect.Set(left, top, right - 1, bottom - 1);
+    return true;
+}
+
+void MediaPlayerPrivate::drawSoftwareFrame(BView* target, const FloatRect& r)
+{
+    if (m_yuv && m_yuvBuffer) {
+        const int32 serial = atomic_get(&m_frameSerial);
+        if (serial != m_rgbSerial) {
+            m_rgbSerial = serial;
+            const bigtime_t start = system_time();
+            convertToRGB32(m_yuvBuffer, m_yuvBytesPerRow, m_width, m_height, m_yuvFlags,
+                (uint8_t*)m_frameBuffer->Bits(), m_frameBuffer->BytesPerRow());
+            m_statConvertTime += system_time() - start;
+            m_statConverted++;
+        }
+    }
+    target->SetDrawingMode(B_OP_COPY);
+    target->DrawBitmap(m_frameBuffer, r);
+}
+
+void MediaPlayerPrivate::requestRepaint(bool own)
+{
+    m_lastRepaintRequest = system_time();
+    callOnMainThread([player = WeakPtr(this), own] {
+        if (!player)
+            return;
+        if (own) {
+            BAutolock lock(player->m_overlayLock);
+            player->m_ownRepaint = true;
+        }
+        player->m_player.repaint();
+    });
+}
+
+// The video thread, after each loop: the new picture on the plane, the plane
+// moved to where the video was painted last, or the picture repainted in
+// software.
+void MediaPlayerPrivate::serviceOverlay()
+{
+    const bigtime_t now = system_time();
+    const int32 serial = atomic_get(&m_frameSerial);
+    BRect paintRect;
+    bigtime_t paintTime, softwareUntil;
+    int32 paintStable;
+    bool keyDrawn;
+    {
+        BAutolock lock(m_overlayLock);
+        paintRect = m_paintRect;
+        paintTime = m_paintTime;
+        paintStable = m_paintStable;
+        softwareUntil = m_softwareUntil;
+        keyDrawn = m_keyDrawn;
+    }
+    const bool samePlace = m_planeShown && paintRect == m_planeRect;
+    const bool software = serial == 0 || now < softwareUntil || now < m_retryAt;
+
+    if (!software && paintRect.IsValid() && (samePlace || (now - paintTime < kPaintFresh && paintStable >= 1))) {
+        if (samePlace && serial == m_planeSerial) {
+            // the plane has this picture; back from software, the key over it again
+            if (!keyDrawn && now - m_lastRepaintRequest > 100000)
+                requestRepaint(true);
+            return;
+        }
+        bool viewGone = false;
+        if (presentOnPlane(paintRect, viewGone)) {
+            m_softwareSince = 0;
+            m_planeSerial = serial;
+            m_statPlane++;
+            if (samePlace && !keyDrawn) {
+                // back from software: the key over the picture again (once
+                // per picture at most, until the paint drew it)
+                if (now - m_lastRepaintRequest > 100000)
+                    requestRepaint(true);
+            } else if (!samePlace) {
+                if (m_planeShown)
+                    m_statMoves++;
+                else
+                    m_statShows++;
+                OVERLAY_EVENT("%s at %d,%d %dx%d\n", m_planeShown ? "move" : "show", (int)paintRect.left,
+                    (int)paintRect.top, (int)paintRect.IntegerWidth() + 1, (int)paintRect.IntegerHeight() + 1);
+                {
+                    BAutolock lock(m_overlayLock);
+                    m_planeShown = true;
+                    m_planeRect = paintRect;
+                    m_keyDrawn = false;
+                }
+                // the key, now that the plane is there
+                requestRepaint(true);
+            }
+            return;
+        }
+        // this picture in software
+    }
+
+    if (!m_softwareSince)
+        m_softwareSince = now;
+    if (serial != m_repaintSerial) {
+        m_repaintSerial = serial;
+        m_statSoftware++;
+        requestRepaint(true);
+    } else if (!software && now - paintTime >= kPaintFresh && now - m_lastRepaintRequest > 100000) {
+        // where is the video now (paused, or after a software period)?
+        requestRepaint(true);
+    }
+    // (on the plane, nothing repaints the video: count from when it left)
+    const bigtime_t unpainted = now - std::max(paintTime, m_softwareSince);
+    if (m_overlayBitmaps[0] && unpainted > kReleaseDelay) {
+        OVERLAY_EVENT("release: no paint for %d ms\n", (int)(unpainted / 1000));
+        releasePlane();
+        // key pixels shown transparent stay so until drawn again
+        requestRepaint(true);
+    }
+}
+
+bool MediaPlayerPrivate::presentOnPlane(const BRect& viewRect, bool& viewGone)
+{
+    const bigtime_t now = system_time();
+    if (!m_planeClaimed) {
+        BMessenger messenger;
+        {
+            BAutolock lock(m_overlayLock);
+            messenger = m_webView;
+        }
+        BAutolock lock(planeLock());
+        for (auto* player : livePlayers()) {
+            if (player != this && player->m_planeClaimed && player->m_webView == messenger) {
+                // another video of the page has the view's plane
+                m_retryAt = now + kRetryDelay;
+                m_statOther++;
+                return false;
+            }
+        }
+        m_planeClaimed = true;
+    }
+    if (!m_overlayBitmaps[0]) {
+        const BRect bounds(0, 0, m_width - 1, m_height - 1);
+        for (int i = 0; i < 3; i++) {
+            // the first reserves the overlay channel; the others take it over
+            // when SetViewOverlay() transfers it to them
+            m_overlayBitmaps[i] = new BBitmap(bounds,
+                B_BITMAP_WILL_OVERLAY | (i == 0 ? B_BITMAP_RESERVE_OVERLAY_CHANNEL : 0), B_YUV420);
+            if (m_overlayBitmaps[i]->InitCheck() != B_OK) {
+                for (auto& bitmap : m_overlayBitmaps) {
+                    delete bitmap;
+                    bitmap = nullptr;
+                }
+                dropPlaneClaim();
+                m_retryAt = now + kRetryDelay;
+                m_statFailed++;
+                return false;
+            }
+        }
+        m_nextBitmap = 0;
+    }
+
+    BBitmap* bitmap = m_overlayBitmaps[m_nextBitmap];
+    // fails while app_server has the overlays suspended (a mode change)
+    if (bitmap->LockBits() != B_OK) {
+        m_retryAt = now + kRetryDelay;
+        m_statFailed++;
+        return false;
+    }
+    {
+        // the picture (a seek may replace it)
+        BAutolock lock(m_mediaLock);
+        uint8_t* bits = (uint8_t*)bitmap->Bits();
+        const int32 dstLuma = bitmap->BytesPerRow() / 3 * 2;
+        const int32 srcLuma = m_yuvBytesPerRow / 3 * 2;
+        const uint8_t* src[3] = { m_yuvBuffer, m_yuvBuffer + (size_t)srcLuma * m_height,
+            m_yuvBuffer + (size_t)srcLuma * m_height + (size_t)srcLuma / 2 * (m_height / 2) };
+        uint8_t* dst[3] = { bits, bits + (size_t)dstLuma * m_height,
+            bits + (size_t)dstLuma * m_height + (size_t)dstLuma / 2 * (m_height / 2) };
+        for (int p = 0; p < 3; p++) {
+            const int32 srcPitch = p ? srcLuma / 2 : srcLuma;
+            const int32 dstPitch = p ? dstLuma / 2 : dstLuma;
+            const int32 rowBytes = p ? m_width / 2 : m_width;
+            const int32 rows = p ? m_height / 2 : m_height;
+            for (int32 y = 0; y < rows; y++)
+                memcpy(dst[p] + (size_t)dstPitch * y, src[p] + (size_t)srcPitch * y, rowBytes);
+        }
+    }
+    bitmap->UnlockBits();
+
+    BMessenger messenger;
+    {
+        BAutolock lock(m_overlayLock);
+        messenger = m_webView;
+    }
+    if (messenger.LockTargetWithTimeout(kLockTimeout) != B_OK) {
+        viewGone = !messenger.IsValid();
+        m_statBusy++;
+        return false;
+    }
+    BLooper* looper = nullptr;
+    BView* view = static_cast<BView*>(messenger.Target(&looper));
+    if (view && !view->Window()) {
+        // taken out of its window (the window closes): its overlay goes with it
+        view = nullptr;
+    }
+    if (!view || view->IsHidden()) {
+        // a hidden tab: give the plane back
+        if (view && m_planeShown)
+            view->ClearViewOverlay();
+        if (looper)
+            looper->Unlock();
+        viewGone = !view;
+        if (m_planeShown)
+            m_statHides++;
+        {
+            BAutolock lock(m_overlayLock);
+            m_planeShown = false;
+            m_planeRect = BRect();
+            m_paintRect = BRect();
+        }
+        for (auto& overlay : m_overlayBitmaps) {
+            delete overlay;
+            overlay = nullptr;
+        }
+        dropPlaneClaim();
+        return false;
+    }
+
+    uint32 options = B_OVERLAY_FILTER_HORIZONTAL | B_OVERLAY_FILTER_VERTICAL;
+    switch (m_yuvFlags & kYCbCrMatrixMask) {
+    case kYCbCrBT601:
+        options |= kOverlayYCbCrBT601;
+        break;
+    case kYCbCrBT709:
+        options |= kOverlayYCbCrBT709;
+        break;
+    }
+    if (m_yuvFlags & kYCbCrFullRange)
+        options |= kOverlayYCbCrFullRange;
+    if (m_planeShown)
+        options |= B_OVERLAY_TRANSFER_CHANNEL;
+    rgb_color key;
+    // the first call configures the plane, a later one flips it at the next
+    // vertical blank (and moves it to viewRect)
+    const status_t status = view->SetViewOverlay(bitmap, bitmap->Bounds(), viewRect, &key,
+        B_FOLLOW_LEFT_TOP, options);
+    looper->Unlock();
+    if (status != B_OK) {
+        if (!m_planeShown) {
+            for (auto& overlay : m_overlayBitmaps) {
+                delete overlay;
+                overlay = nullptr;
+            }
+            dropPlaneClaim();
+        }
+        m_retryAt = now + kRetryDelay;
+        m_statFailed++;
+        return false;
+    }
+    {
+        BAutolock lock(m_overlayLock);
+        m_key = key;
+    }
+    m_nextBitmap = (m_nextBitmap + 1) % 3;
+    return true;
+}
+
+// The plane hidden and its bitmaps freed (the video thread, or after it ended).
+void MediaPlayerPrivate::releasePlane()
+{
+    BMessenger messenger;
+    {
+        BAutolock lock(m_overlayLock);
+        messenger = m_webView;
+    }
+    if (m_planeShown && messenger.LockTargetWithTimeout(kLockTimeout) == B_OK) {
+        BLooper* looper = nullptr;
+        BView* view = static_cast<BView*>(messenger.Target(&looper));
+        if (view && view->Window())
+            view->ClearViewOverlay();
+        if (looper)
+            looper->Unlock();
+    }
+    if (m_planeShown)
+        m_statHides++;
+    {
+        BAutolock lock(m_overlayLock);
+        m_planeShown = false;
+        m_planeRect = BRect();
+    }
+    for (auto& bitmap : m_overlayBitmaps) {
+        delete bitmap;
+        bitmap = nullptr;
+    }
+    dropPlaneClaim();
+}
+
+void MediaPlayerPrivate::dropPlaneClaim()
+{
+    BAutolock lock(planeLock());
+    m_planeClaimed = false;
+}
+
+void MediaPlayerPrivate::logStats(const char* what)
+{
+    if (!overlayLog())
+        return;
+    const bigtime_t now = system_time();
+    if (!strcmp(what, "stats") && now - m_lastLog < 2000000)
+        return;
+    m_lastLog = now;
+    BRect plane;
+    {
+        BAutolock lock(m_overlayLock);
+        plane = m_planeRect;
+    }
+    fprintf(stderr, "WVO %s: %s %dx%d flags 0x%x; decoded %u late %u; plane %u shows %u moves %u hides %u"
+        " failed %u busy %u other %u; software %u converted %u (%.1f ms each) foreign %u scrolled %u; plane at"
+        " %d,%d %dx%d\n", what, m_yuv ? "yuv420" : "rgb32", (int)m_width, (int)m_height,
+        (unsigned)m_yuvFlags, m_statDecoded, m_statLate, m_statPlane, m_statShows, m_statMoves,
+        m_statHides, m_statFailed, m_statBusy, m_statOther, m_statSoftware, m_statConverted,
+        m_statConverted ? m_statConvertTime / 1000.0 / m_statConverted : 0.0, m_statForeign,
+        m_statScrolled, (int)plane.left, (int)plane.top,
+        plane.IsValid() ? (int)plane.IntegerWidth() + 1 : 0, plane.IsValid() ? (int)plane.IntegerHeight() + 1 : 0);
+}
