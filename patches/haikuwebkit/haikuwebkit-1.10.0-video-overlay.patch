+
+// B_YUV420 (planar 4:2:0, the whole picture's bytes per row: luma rows of 2/3
+// of it, then the Cb and the Cr plane with rows of 1/3) into B_RGB32, with the
+// picture's YCbCr encoding (untagged: BT.709 from 720 lines on, as the display
+// and the decoder's own RGB conversion guess)
+static void convertToRGB32(const uint8_t* src, int32 srcBytesPerRow, int32 width, int32 height,
+    uint32 flags, uint8_t* dst, int32 dstBytesPerRow)
+{
+    uint32 matrix = flags & kYCbCrMatrixMask;
+    if (!matrix)
+        matrix = height >= 720 ? kYCbCrBT709 : kYCbCrBT601;
+    const bool full = (flags & kYCbCrFullRange) != 0;
+    // 16.16 fixed point
+    int32 ys = 76309, yOffset = 16, rv, gu, gv, bu;
+    if (full) {
+        ys = 65536;
+        yOffset = 0;
+        rv = 91881; gu = 22554; gv = 46802; bu = 116130;
+    } else if (matrix == kYCbCrBT709) {
+        rv = 117489; gu = 13954; gv = 34925; bu = 138438;
+    } else {
+        rv = 104597; gu = 25675; gv = 53279; bu = 132201;
+    }
+    const int32 lumaPitch = srcBytesPerRow / 3 * 2;
+    const int32 chromaPitch = lumaPitch / 2;
+    const uint8_t* cbPlane = src + (size_t)lumaPitch * height;
+    const uint8_t* crPlane = cbPlane + (size_t)chromaPitch * (height / 2);
+    auto clamp = [](int32 value) -> uint8_t {
+        value >>= 16;
+        return value < 0 ? 0 : value > 255 ? 255 : value;
+    };
+    for (int32 y = 0; y < height; y++) {
+        const uint8_t* luma = src + (size_t)lumaPitch * y;
+        const uint8_t* cb = cbPlane + (size_t)chromaPitch * (y / 2);
+        const uint8_t* cr = crPlane + (size_t)chromaPitch * (y / 2);
+        uint8_t* out = dst + (size_t)dstBytesPerRow * y;
+        for (int32 x = 0; x < width; x++) {
+            const int32 u = cb[x / 2] - 128;
+            const int32 v = cr[x / 2] - 128;
+            const int32 l = (luma[x] - yOffset) * ys + 32768;
+            out[0] = clamp(l + bu * u);
+            out[1] = clamp(l - gu * u - gv * v);
+            out[2] = clamp(l + rv * v);
+            out[3] = 255;
+            out += 4;
+        }
+    }
+}
