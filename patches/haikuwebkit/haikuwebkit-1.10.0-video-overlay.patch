+void MediaPlayerPrivate::paintCurrentFrameInContext(GraphicsContext& context, const FloatRect& r)
+{
+    // a canvas, a snapshot: always the picture
+    if (context.paintingDisabled() || !m_frameBuffer)
+        return;
+    drawSoftwareFrame(context.platformContext(), r);
