+void MediaPlayerPrivate::rootViewScrolled(BView* view)
+{
+    for (auto* player : livePlayers()) {
+        bool scrolled = false;
+        {
+            BAutolock lock(player->m_overlayLock);
+            if (player->m_planeShown && player->m_webView.Target(nullptr) == view) {
+                player->m_softwareUntil = std::max(player->m_softwareUntil,
+                    system_time() + kScrollDelay);
+                player->m_statScrolled++;
+                OVERLAY_EVENT("scroll\n");
+                player->m_ownRepaint = true;
+                // where the video is now is known after its next paint (none
+                // if it was scrolled out of the view)
+                player->m_paintRect = BRect();
+                player->m_keyDrawn = false;
+                scrolled = true;
+            }
+        }
+        // the picture at its new place, over the moved key
+        if (scrolled)
+            player->m_player.repaint();
     }
 }
 
+void MediaPlayerPrivate::stopAllForExit(bool applicationAlive)
+{
+    for (auto* player : livePlayers()) {
+        player->m_abort = true;
+        // the video thread, a seek and the sound player's callback read only
+        // with the lock held and a track set
+        player->m_mediaLock.Lock();
+        player->m_videoTrack = nullptr;
+        player->m_audioTrack = nullptr;
+        player->m_mediaLock.Unlock();
+        if (player->m_videoThread >= 0) {
+            status_t status;
+            wait_for_thread(player->m_videoThread, &status);
+            player->m_videoThread = -1;
+        }
+        if (!applicationAlive)
+            continue;
+        // the overlay bitmaps need app_server; closing the file closes the
+        // decoder, whose own threads (h264_mmal's) would otherwise still run
+        // when the add-on is unloaded
+        player->releasePlane();
+        player->m_mediaLock.Lock();
+        if (player->m_soundPlayer)
+            player->m_soundPlayer->Stop();
+        delete player->m_soundPlayer;
+        player->m_soundPlayer = nullptr;
+        delete player->m_mediaFile;
+        player->m_mediaFile = nullptr;
+        player->m_mediaLock.Unlock();
+    }
+}
