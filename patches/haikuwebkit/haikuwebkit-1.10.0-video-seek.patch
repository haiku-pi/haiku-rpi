+// The ffmpeg reader seeks all of a file's tracks by the first video track's
+// index: the audio track lands at the video's key frame before the time, up
+// to a key frame interval early. Decodes (and drops) the audio up to the
+// time, a few milliseconds of CPU; with m_mediaLock held.
+void MediaPlayerPrivate::skipAudioTo(bigtime_t time)
+{
+    if (!m_audioBufferSize || m_audioTrack->CurrentTime() >= time)
+        return;
+    void* scratch = malloc(m_audioBufferSize);
+    if (!scratch)
+        return;
+    // at most a minute of audio
+    for (int i = 0; i < 6000 && m_audioTrack->CurrentTime() < time; i++) {
+        int64 frames;
+        if (m_audioTrack->ReadFrames(scratch, &frames) != B_OK) {
+            m_audioEnded = true;
+            break;
+        }
+    }
+    free(scratch);
+}
+
+// The video thread, after a seek: the video track is at the key frame at or
+// before the time asked for; decodes on to the picture that shows that time,
+// without showing the ones before it. The lock is taken per picture, so that a
+// seek that comes meanwhile (dragging the slider) is not held up; it sets the
+// new target, and the decoding goes on to that. Returns whether there was a
+// seek.
+bool MediaPlayerPrivate::decodeToSeekTarget()
+{
+    bool seek = false;
+    int32 pictures = 0;
+    bigtime_t shown = -1;
+    const bigtime_t start = system_time();
+    while (!m_abort && m_mediaLock.Lock()) {
+        void* buffer = m_yuv ? m_yuvBuffer : (m_frameBuffer ? m_frameBuffer->Bits() : nullptr);
+        if (m_abort || m_seekTarget < 0 || !m_videoTrack || !buffer) {
+            m_seekTarget = -1;
+            m_mediaLock.Unlock();
+            break;
+        }
+        seek = true;
+        int64 count;
+        media_header header;
+        if (m_videoTrack->ReadFrames(buffer, &count, &header) == B_OK) {
+            pictures++;
+            m_statDecoded++;
+            shown = header.start_time;
+            // CurrentTime(): the end of this picture
+            if (m_videoTrack->CurrentTime() > m_seekTarget)
+                m_seekTarget = -1;
+        } else {
+            // a seek to the end
+            m_videoEnded = true;
+            m_seekTarget = -1;
+        }
+        const bool done = m_seekTarget < 0;
+        m_mediaLock.Unlock();
+        if (done)
+            break;
+    }
+    if (pictures)
+        atomic_add(&m_frameSerial, 1);
+    if (seek && overlayLog()) {
+        fprintf(stderr, "WVO seek: showing %.3f s, %d pictures decoded in %.0f ms\n", shown / 1000000.0,
+            (int)pictures, (system_time() - start) / 1000.0);
+    }
+    return seek;
+}
+
+// The video of a file without an audio track has ended: the media element
+// loops (a seek to 0) or stops.
+void MediaPlayerPrivate::notifyVideoEnded()
+{
+    callOnMainThread([p = WeakPtr(this)] {
+        if (p)
+            p->m_player.timeChanged();
+    });
+}
