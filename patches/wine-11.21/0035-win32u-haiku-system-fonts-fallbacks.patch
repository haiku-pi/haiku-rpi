+#if 0
+#pragma makedep unix
+#endif
+
+#ifdef __HAIKU__
+
+#include <stddef.h>
+#include <FindDirectory.h>
+
+int haiku_font_directory( unsigned int index, char *path, size_t size );
+
+/* the index-th font directory, the user's first: 0 and the path (empty if it has none),
+ * -1 past the last */
+int haiku_font_directory( unsigned int index, char *path, size_t size )
+{
+    static const directory_which dirs[] =
+    {
+        B_USER_NONPACKAGED_FONTS_DIRECTORY,
+        B_USER_FONTS_DIRECTORY,
+        B_SYSTEM_NONPACKAGED_FONTS_DIRECTORY,
+        B_SYSTEM_FONTS_DIRECTORY,
+    };
+
+    if (index >= sizeof(dirs) / sizeof(dirs[0])) return -1;
+    if (find_directory( dirs[index], -1, false, path, size ) != B_OK) path[0] = 0;
+    return 0;
+}
+
+#endif /* __HAIKU__ */
