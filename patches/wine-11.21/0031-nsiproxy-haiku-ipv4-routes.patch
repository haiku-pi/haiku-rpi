nsiproxy: list the IPv4 routing table on Haiku

GetIpForwardTable() returned STATUS_NOT_IMPLEMENTED on Haiku (no
/proc/net/route, no routing socket). ws2_32's gethostbyname() of the
local host name builds its answer from the routes and the adapters, so
it fell back to the host's resolver, which knows the name only as a
loopback address, or not at all: a program asking for its own address
got 127.x or nothing. Need for Speed: Porsche Unleashed takes its local
address that way and offers UDP play only when it is not 127.x or 0.x;
without UDP (or IPX) it never creates its race session object, and
every race start crashed reading through that NULL object
(Porsche.exe+0x8ced6).

Haiku hands out the routing table of a socket's domain through SIOCGRTSIZE and
SIOCGRTTABLE (as its route command reads it): one ifreq per route, the
interface name and a route_entry, followed by the route's addresses.
--- a/dlls/nsiproxy.sys/ip.c
+++ b/dlls/nsiproxy.sys/ip.c
@@ -63,6 +63,12 @@
 # include <net/if.h>
 #endif
 
+#ifdef __HAIKU__
+# include <sys/ioctl.h>
+# include <sys/sockio.h>
+# include <unistd.h>
+#endif
+
 #ifdef __APPLE__
 /* For reasons unknown, Mac OS doesn't export <netinet6/ip6_var.h> to user-
  * space. We'll have to define the needed struct ourselves.
@@ -1687,6 +1693,85 @@
 
             if (num < *count)
             {
+                ipv4_forward_fill_entry( &entry, key_data, rw_data, dynamic_data, static_data );
+                key_data = (BYTE *)key_data + key_size;
+                rw_data = (BYTE *)rw_data + rw_size;
+                dynamic_data = (BYTE *)dynamic_data + dynamic_size;
+                static_data = (BYTE *)static_data + static_size;
+            }
+            num++;
+        }
+        free( buf );
+    }
+#elif defined(__HAIKU__)
+    {
+        /* Haiku has no routing socket: the stack hands out the table of the socket's domain, one ifreq
+         * per route (the interface name, then a route_entry), each followed by its addresses, which the
+         * route_entry points to. */
+        struct ifconf config;
+        char *buf, *ptr, *end;
+        int fd = socket( AF_INET, SOCK_DGRAM, 0 );
+
+        if (fd < 0) return STATUS_NOT_SUPPORTED;
+        config.ifc_len = sizeof(config.ifc_value);
+        if (ioctl( fd, SIOCGRTSIZE, &config, sizeof(config) ) < 0)
+        {
+            close( fd );
+            return STATUS_NOT_SUPPORTED;
+        }
+        if (!(buf = malloc( config.ifc_value + 1 )))
+        {
+            close( fd );
+            return STATUS_NO_MEMORY;
+        }
+        config.ifc_len = config.ifc_value;
+        config.ifc_buf = buf;
+        if (config.ifc_len && ioctl( fd, SIOCGRTTABLE, &config, sizeof(config) ) < 0)
+        {
+            free( buf );
+            close( fd );
+            return STATUS_NOT_SUPPORTED;
+        }
+        close( fd );
+
+        end = buf + config.ifc_len;
+        for (ptr = buf; ptr + IF_NAMESIZE + sizeof(struct route_entry) <= end;)
+        {
+            struct ifreq *req = (struct ifreq *)ptr;
+            struct route_entry *route = &req->ifr_route;
+            UINT size = 0;
+
+            if (route->destination) size += route->destination->sa_len;
+            if (route->mask) size += route->mask->sa_len;
+            if (route->gateway) size += route->gateway->sa_len;
+            ptr += IF_NAMESIZE + sizeof(struct route_entry) + size;
+
+            /* the socket's domain gives only its own routes; a default route may have no destination */
+            if (route->destination ? route->destination->sa_family != AF_INET : !(route->flags & RTF_DEFAULT))
+                continue;
+            if (!convert_unix_name_to_luid( req->ifr_name, &entry.luid )) continue;
+            if (!convert_luid_to_index( &entry.luid, &entry.if_index )) continue;
+
+            if (route->destination) entry.prefix = ((struct sockaddr_in *)route->destination)->sin_addr;
+            if (route->flags & RTF_DEFAULT)
+            {
+                entry.prefix.s_addr = 0;
+                entry.prefix_len = 0;
+            }
+            else if (route->mask && route->mask->sa_family == AF_INET)
+                entry.prefix_len = mask_v4_to_prefix( &((struct sockaddr_in *)route->mask)->sin_addr );
+            else
+                entry.prefix_len = 32;
+            entry.next_hop.s_addr = 0;
+            if ((route->flags & RTF_GATEWAY) && route->gateway && route->gateway->sa_family == AF_INET)
+                entry.next_hop = ((struct sockaddr_in *)route->gateway)->sin_addr;
+            entry.metric = 0;
+            entry.protocol = (route->flags & RTF_GATEWAY) ? MIB_IPPROTO_NETMGMT : MIB_IPPROTO_LOCAL;
+            entry.loopback = (route->flags & RTF_LOCAL)
+                || (entry.protocol == MIB_IPPROTO_LOCAL && entry.prefix_len == 32);
+
+            if (num < *count)
+            {
                 ipv4_forward_fill_entry( &entry, key_data, rw_data, dynamic_data, static_data );
                 key_data = (BYTE *)key_data + key_size;
                 rw_data = (BYTE *)rw_data + rw_size;
