+/* The HEVC decoder with the Raspberry Pi 4's rpivid block: listed before
+ * "hevc", so avcodec_find_decoder(AV_CODEC_ID_HEVC) returns it. Streams and
+ * pictures the block does not take decode on the CPU. No frame threads: the
+ * block decodes one picture at a time, and the hwaccel's state would move
+ * between thread contexts for every picture. */
+const FFCodec ff_hevc_rpivid_decoder = {
+    .p.name                = "hevc_rpivid",
+    CODEC_LONG_NAME("HEVC (High Efficiency Video Coding), Raspberry Pi 4 rpivid hardware"),
+    .p.type                = AVMEDIA_TYPE_VIDEO,
+    .p.id                  = AV_CODEC_ID_HEVC,
+    .priv_data_size        = sizeof(HEVCContext),
