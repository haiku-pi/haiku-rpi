+#if CONFIG_HEVC_RPIVID_DECODER
+/* Continue on the CPU decoder. The block's pictures have their pixels, but
+ * not the motion fields the CPU decoder keeps for temporal MV prediction: with
+ * drop, the current picture and every one up to the next IRAP are dropped
+ * (the caller keeps showing the last picture it got); the RASL pictures of a
+ * CRA decoded on the CPU are dropped too. Pictures the block failed after
+ * their submit (AV_FRAME_FLAG_CORRUPT, set by rpivid_hevc.c only) go too. */
+static void rpivid_leave(HEVCContext *s, const char *why, int drop)
+{
+    av_log(s->avctx, AV_LOG_WARNING, "rpivid: continuing on the CPU decoder (%s)%s\n",
+           why, drop ? ", pictures dropped up to the next random access point" : "");
+    ff_hwaccel_uninit(s->avctx);
+    s->rpivid_failed = 1;
+    if (s->output_frame->buf[0] && (s->output_frame->flags & AV_FRAME_FLAG_CORRUPT))
+        av_frame_unref(s->output_frame);
+    for (int i = 0; i < FF_ARRAY_ELEMS(s->DPB); i++) {
+        HEVCFrame *frame = &s->DPB[i];
+        if (frame != s->ref && frame->frame->buf[0] &&
+            (frame->frame->flags & AV_FRAME_FLAG_CORRUPT))
+            ff_hevc_unref_frame(frame, ~0);
+    }
+    if (drop) {
+        if (s->ref) {
+            /* without reordering, the picture went to the output at its start */
+            if (s->output_frame->buf[0] && s->ref->frame->buf[0] &&
+                s->output_frame->buf[0]->buffer == s->ref->frame->buf[0]->buffer)
+                av_frame_unref(s->output_frame);
+            ff_hevc_unref_frame(s->ref, ~0);
+        }
+        s->ref = s->collocated_ref = NULL;
+        s->is_decoded  = 0;
+        s->rpivid_skip = 1;
+        s->max_ra      = INT_MAX;
+    } else if (s->nal_unit_type == HEVC_NAL_CRA_NUT) {
+        s->max_ra = s->poc;
+    }
+}
+
+/* At an IRAP picture after leaving the block: take it again, three times per
+ * stream at most */
+static void rpivid_retry(HEVCContext *s)
+{
+    if (s->avctx->hwaccel || s->rpivid_retries >= 3)
+        return;
+    s->rpivid_retries++;
+    if (ff_rpivid_hevc_attach(s->avctx, s->rpivid) < 0)
+        return;
+    s->rpivid_failed = 0;
+    /* the RASL pictures of a CRA reference pictures the CPU decoded */
+    s->max_ra = INT_MAX;
+    av_log(s->avctx, AV_LOG_INFO, "rpivid: back on the block at POC %d\n", s->poc);
+}
+#endif
