+#ifndef GLMARK2_NATIVE_STATE_HAIKU_H_
+#define GLMARK2_NATIVE_STATE_HAIKU_H_
+
+#include "native-state.h"
+
+class BApplication;
+class HaikuWindow;
+
+/*
+ * Haiku: a BWindow with one view that shows the frames. Mesa's EGL "haiku"
+ * platform takes as the native window not a BWindow or BView but a BitmapHook
+ * (see native-state-haiku.cpp): it hands each presented frame to the hook as a
+ * BBitmap, and the view draws it.
+ */
+class NativeStateHaiku : public NativeState
+{
+public:
+    NativeStateHaiku();
+    ~NativeStateHaiku();
+
+    bool init_display();
+    void* display();
+    bool create_window(WindowProperties const& properties);
+    void* window(WindowProperties& properties);
+    void visible(bool v);
+    bool should_quit();
+    void flip();
+
+private:
+    void destroy_window();
+
+    BApplication* app_;
+    HaikuWindow* window_;
+    WindowProperties properties_;
+};
+
+#endif /* GLMARK2_NATIVE_STATE_HAIKU_H_ */
