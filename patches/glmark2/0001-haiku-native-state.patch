+ * glmark2.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include "native-state-haiku.h"
+#include "log.h"
+
+#include <Application.h>
+#include <Bitmap.h>
+#include <Messenger.h>
+#include <Region.h>
+#include <Screen.h>
+#include <View.h>
+#include <Window.h>
+
+#include <atomic>
+#include <csignal>
+#include <mutex>
+#include <stdint.h>
+
+/*
+ * The native window of Mesa's EGL "haiku" platform, as Mesa declares it
+ * (src/gallium/winsys/sw/hgl/hgl_sw_winsys.h; libglvnd's BGLView implements
+ * the same, src/HGL/BitmapHook.h). It is not in Haiku's public headers: the
+ * order of the virtual functions is the interface.
+ */
+class BitmapHook {
+public:
+    virtual ~BitmapHook() {};
+    virtual void GetSize(uint32_t &width, uint32_t &height) = 0;
+    virtual BBitmap *SetBitmap(BBitmap *bmp) = 0;
+};
+
+static std::atomic<bool> quit_requested(false);
+
+static void
+quit_handler(int /*signum*/)
+{
+    quit_requested = true;
+}
+
+/*
+ * Shows the frames: Mesa renders into a BBitmap and hands it over with
+ * SetBitmap() (from its presenter thread), the view draws it.
+ */
+class HaikuView : public BView, public BitmapHook
+{
+public:
+    HaikuView(BRect frame)
+        : BView(frame, "glmark2", B_FOLLOW_ALL_SIDES,
+                B_WILL_DRAW | B_FRAME_EVENTS),
+          bitmap_(nullptr),
+          width_(frame.IntegerWidth() + 1),
+          height_(frame.IntegerHeight() + 1)
+    {
+        // the frames cover the view: no erasing to the view colour first
+        SetViewColor(B_TRANSPARENT_COLOR);
+        SetLowColor(0, 0, 0);
+    }
+
+    ~HaikuView()
+    {
+        delete bitmap_;
+    }
+
+    void GetSize(uint32_t &width, uint32_t &height) override
+    {
+        std::lock_guard<std::mutex> lock(lock_);
+        width = width_;
+        height = height_;
+    }
+
+    BBitmap *SetBitmap(BBitmap *bitmap) override
+    {
+        BBitmap *old;
+        {
+            std::lock_guard<std::mutex> lock(lock_);
+            old = bitmap_;
+            bitmap_ = bitmap;
+        }
+        // Without waiting (timeout 0), as BGLView: a full port already holds
+        // an update for the view, and blocking here would stall the GPU's
+        // presenter while the window's thread is busy.
+        BMessage invalidate(B_INVALIDATE);
+        BMessenger(this).SendMessage(&invalidate, (BHandler *)nullptr, 0);
+        return old;
+    }
+
+    void Draw(BRect update) override
+    {
+        BRegion region(update);
+        std::lock_guard<std::mutex> lock(lock_);
+        if (bitmap_ != nullptr) {
+            DrawBitmap(bitmap_, B_ORIGIN);
+            region.Exclude(bitmap_->Bounds());
+        }
+        FillRegion(&region, B_SOLID_LOW);
+    }
+
+    void FrameResized(float width, float height) override
+    {
+        BView::FrameResized(width, height);
+        std::lock_guard<std::mutex> lock(lock_);
+        width_ = (uint32_t)width + 1;
+        height_ = (uint32_t)height + 1;
+    }
+
+    void KeyDown(const char *bytes, int32 numBytes) override
+    {
+        if (numBytes == 1 && (bytes[0] == B_ESCAPE || bytes[0] == 'q'))
+            quit_requested = true;
+        else
+            BView::KeyDown(bytes, numBytes);
+    }
+
+private:
+    std::mutex lock_;
+    BBitmap *bitmap_;
+    uint32_t width_;
+    uint32_t height_;
+};
+
+class HaikuWindow : public BWindow
+{
+public:
+    HaikuWindow(BRect frame, bool fullscreen)
+        : BWindow(frame, "glmark2 " GLMARK_VERSION,
+                  fullscreen ? B_NO_BORDER_WINDOW_LOOK : B_TITLED_WINDOW_LOOK,
+                  B_NORMAL_WINDOW_FEEL,
+                  B_NOT_RESIZABLE | B_NOT_ZOOMABLE | B_ASYNCHRONOUS_CONTROLS
+                  | (fullscreen ? B_NOT_MOVABLE : 0)),
+          shown(false)
+    {
+        // (a new window is locked by the thread that created it until Show())
+        view = new HaikuView(Bounds());
+        AddChild(view);
+        view->MakeFocus();
+    }
+
+    bool QuitRequested() override
+    {
+        // glmark2 ends the run and destroys the window itself
+        quit_requested = true;
+        return false;
+    }
+
+    HaikuView *view;
+    bool shown;
+};
+
+/******************
+ * Public methods *
+ ******************/
+
+NativeStateHaiku::NativeStateHaiku()
+    : app_(nullptr), window_(nullptr)
+{
+}
+
+NativeStateHaiku::~NativeStateHaiku()
+{
+    destroy_window();
+    delete app_;
+}
+
+bool
+NativeStateHaiku::init_display()
+{
+    // a connection to the app_server; its looper need not run (the window's does)
+    if (be_app == nullptr) {
+        app_ = new BApplication("application/x-vnd.glmark2");
+        if (app_->InitCheck() != B_OK) {
+            Log::error("Haiku: no connection to the app_server\n");
+            return false;
+        }
+    }
+
+    struct sigaction sa = {};
+    sa.sa_handler = quit_handler;
+    sigaction(SIGINT, &sa, nullptr);
+    sigaction(SIGTERM, &sa, nullptr);
+
+    return true;
+}
+
+void*
+NativeStateHaiku::display()
+{
+    // EGL_DEFAULT_DISPLAY: Mesa's only display on Haiku
+    return nullptr;
+}
+
+bool
+NativeStateHaiku::create_window(WindowProperties const& properties)
+{
+    BRect screen = BScreen(B_MAIN_SCREEN_ID).Frame();
+    const bool was_fullscreen = properties_.fullscreen;
+    properties_ = properties;
+    if (properties.fullscreen) {
+        properties_.width = screen.IntegerWidth() + 1;
+        properties_.height = screen.IntegerHeight() + 1;
+    }
+
+    if (window_ != nullptr) {
+        // keep the window (EGL's surface holds its view): resize it
+        if (was_fullscreen != properties.fullscreen)
+            Log::info("Haiku: cannot switch a window to or from full screen\n");
+        if (window_->Lock()) {
+            window_->ResizeTo(properties_.width - 1, properties_.height - 1);
+            window_->Unlock();
+        }
+        return true;
+    }
+
+    BRect frame(0, 0, properties_.width - 1, properties_.height - 1);
+    if (properties.fullscreen) {
+        frame.OffsetTo(screen.LeftTop());
+    } else {
+        // centred, the title tab on the screen
+        float left = screen.left + (screen.Width() - frame.Width()) / 2;
+        float top = screen.top + (screen.Height() - frame.Height()) / 2;
+        frame.OffsetTo(left > 5 ? left : 5, top > 30 ? top : 30);
+    }
+    window_ = new HaikuWindow(frame, properties.fullscreen);
+    return true;
+}
+
+void*
+NativeStateHaiku::window(WindowProperties& properties)
+{
+    properties = properties_;
+    if (window_ == nullptr)
+        return nullptr;
+    return static_cast<BitmapHook *>(window_->view);
+}
+
+void
+NativeStateHaiku::visible(bool v)
+{
+    if (window_ == nullptr)
+        return;
+
+    if (!window_->shown) {
+        // the first Show() starts the window's thread and gives up the lock
+        // the window was created with
+        if (v) {
+            window_->shown = true;
+            window_->Show();
+        }
+        return;
+    }
+
+    if (window_->Lock()) {
+        if (v && window_->IsHidden())
+            window_->Show();
+        else if (!v && !window_->IsHidden())
+            window_->Hide();
+        window_->Unlock();
+    }
+}
+
+bool
+NativeStateHaiku::should_quit()
+{
+    return quit_requested;
+}
+
+void
+NativeStateHaiku::flip()
+{
+}
+
+/*******************
+ * Private methods *
+ *******************/
+
+void
+NativeStateHaiku::destroy_window()
+{
+    if (window_ == nullptr)
+        return;
+
+    // Quit() deletes the window, also one that never ran
+    if (window_->Lock())
+        window_->Quit();
+    window_ = nullptr;
+}
