GHOST_SDL: share every GL context with the first one

GHOST_ContextSDL asks SDL to share a new context with the one current on the calling thread
(SDL_GL_SHARE_WITH_CURRENT_CONTEXT); SDL 2 has no way to name another. When none is current,
the new context gets textures and buffers of its own, and a texture name made in it means some
other texture in the window's context. Cycles' viewport makes its GPU context
(RE_engine_gpu_context_create) right after the draw manager released its own, with nothing
current, so Rendered shading drew Blender's icon sheet instead of the render (Haiku arm64, found
with the denoiser work). Make the first context current for the creation when none is: GHOST's
other backends name it as the share context explicitly.

--- a/intern/ghost/intern/GHOST_ContextSDL.cc
+++ b/intern/ghost/intern/GHOST_ContextSDL.cc
@@ -16,6 +16,7 @@
 #include <cstring>
 
 SDL_GLContext GHOST_ContextSDL::s_sharedContext = nullptr;
+SDL_Window *GHOST_ContextSDL::s_sharedWindow = nullptr;
 int GHOST_ContextSDL::s_sharedCount = 0;
 
 GHOST_ContextSDL::GHOST_ContextSDL(bool stereoVisual,
@@ -54,6 +55,7 @@
 
     if (s_sharedCount == 0) {
       s_sharedContext = nullptr;
+      s_sharedWindow = nullptr;
     }
     SDL_GL_DeleteContext(m_context);
   }
@@ -126,6 +128,16 @@
     m_window = m_hidden_window;
   }
 
+  /* SDL shares the new context's objects (textures, buffers) with the context that is current on
+   * the calling thread (SDL_GL_SHARE_WITH_CURRENT_CONTEXT); with none current, the new context gets
+   * objects of its own, and a texture name made in it means another texture in every other context
+   * (Cycles' viewport, whose GPU context is made while the draw manager has released its own, drew
+   * Blender's icon sheet instead of the render). Make the first context current for the creation:
+   * GHOST's other backends name it as the share context explicitly. */
+  if (s_sharedContext != nullptr && SDL_GL_GetCurrentContext() == nullptr) {
+    SDL_GL_MakeCurrent(s_sharedWindow, s_sharedContext);
+  }
+
   m_context = SDL_GL_CreateContext(m_window);
 
   GHOST_TSuccess success;
@@ -133,6 +145,7 @@
   if (m_context != nullptr) {
     if (!s_sharedContext) {
       s_sharedContext = m_context;
+      s_sharedWindow = m_window;
     }
     s_sharedCount++;
 
--- a/intern/ghost/intern/GHOST_ContextSDL.hh
+++ b/intern/ghost/intern/GHOST_ContextSDL.hh
@@ -102,5 +102,7 @@
 
   /** The first created OpenGL context (for sharing display lists) */
   static SDL_GLContext s_sharedContext;
+  /** The window of #s_sharedContext (SDL makes a context current with its window). */
+  static SDL_Window *s_sharedWindow;
   static int s_sharedCount;
 };
