FFmpeg output: a bit rate from the quality setting for encoders without CRF

In constant-rate-factor mode (Blender's default for H.264: "Medium quality") the writer sets the
bit rate to 0 and passes "crf". Encoders without a crf option — hardware encoders such as
h264_mmal, the only H.264 encoder of the Raspberry Pi's FFmpeg on Haiku — ignore it and encode at
their own default bit rate, so every quality preset gave the same file. For such an encoder the
writer now derives a bit rate from the rate factor: 0.1 bit per pixel at CRF 23, doubling every 6
steps down (1280x720 at 24 fps: about 2.2 Mbit/s at Medium), clamped to 0.25-50 Mbit/s.

diff --git a/source/blender/blenkernel/intern/writeffmpeg.c b/source/blender/blenkernel/intern/writeffmpeg.c
index f287839..57b1182 100644
--- a/source/blender/blenkernel/intern/writeffmpeg.c
+++ b/source/blender/blenkernel/intern/writeffmpeg.c
@@ -665,6 +665,26 @@ static const AVCodec *get_av1_encoder(
   return codec;
 }
 
+/** Whether \a codec takes a "crf" option (x264, x265, libvpx, ...; hardware encoders do not). */
+static bool codec_has_crf_option(const AVCodec *codec)
+{
+  return codec->priv_class != NULL &&
+         av_opt_find((void *)&codec->priv_class, "crf", NULL, 0, AV_OPT_SEARCH_FAKE_OBJ) != NULL;
+}
+
+/**
+ * A bit rate for a constant rate factor, for encoders that only take a bit rate: 0.1 bit per pixel
+ * at CRF 23 (Blender's "Medium quality"; about what x264 needs for typical footage), doubling every
+ * 6 steps down as x264's quality does (e.g. 1280x720 at 24 fps: about 2.2 Mbit/s at 23, 4.4 at 17).
+ */
+static int64_t bit_rate_from_crf(int crf, int width, int height, AVRational time_base)
+{
+  const double fps = (time_base.num > 0) ? (double)time_base.den / time_base.num : 25.0;
+  const double bits_per_pixel = 0.1 * pow(2.0, (23 - crf) / 6.0);
+  const double rate = bits_per_pixel * width * height * fps;
+  return (int64_t)max_dd(250000.0, min_dd(rate, 50000000.0));
+}
+
 /* prepare a video stream for the output file */
 
 static AVStream *alloc_video_stream(FFMpegContext *context,
@@ -748,6 +768,12 @@ static AVStream *alloc_video_stream(FFMpegContext *context,
   if (context->ffmpeg_type == FFMPEG_WEBM && context->ffmpeg_crf == 0) {
     ffmpeg_dict_set_int(&opts, "lossless", 1);
   }
+  else if (context->ffmpeg_crf >= 0 && !codec_has_crf_option(codec)) {
+    /* An encoder without constant rate factor (hardware encoders such as the Raspberry Pi's
+     * h264_mmal) would ignore "crf" and encode at its own default bit rate whatever the quality
+     * setting: give it a bit rate from the constant rate factor instead. */
+    c->bit_rate = bit_rate_from_crf(context->ffmpeg_crf, rectx, recty, c->time_base);
+  }
   else if (context->ffmpeg_crf >= 0) {
