-  SET_FLAG_FROM_TEST(effects->enabled_effects, effects->sss_surface_count > 0, EFFECT_SSS);
+  /* Subsurface Scattering writes 6 color attachments; with fewer (V3D 4.2: 4) the materials use a
+   * shader without the SSS outputs (eevee_shaders.cc) and their subsurface light is diffuse. */
+  const bool sss_supported = GPU_max_color_attachments() >= 6;
+  if (effects->sss_surface_count > 0 && !sss_supported) {
+    static bool warned = false;
+    if (!warned) {
+      fprintf(stderr,
+              "EEVEE: Subsurface Scattering is not available on this GPU (%d color attachments, 6 "
+              "needed); subsurface materials render as diffuse\n",
+              GPU_max_color_attachments());
+      warned = true;
+    }
+  }
+  SET_FLAG_FROM_TEST(
+      effects->enabled_effects, effects->sss_surface_count > 0 && sss_supported, EFFECT_SSS);
 }
 
