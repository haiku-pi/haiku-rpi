diff --git a/source/blender/draw/intern/draw_manager.c b/source/blender/draw/intern/draw_manager.c
index c425e02..3e8e132 100644
--- a/source/blender/draw/intern/draw_manager.c
+++ b/source/blender/draw/intern/draw_manager.c
@@ -2963,6 +2963,20 @@ bool DRW_state_is_navigating(void)
   return (rv3d) && (rv3d->rflag & (RV3D_NAVIGATING | RV3D_PAINTING));
 }
 
+bool DRW_state_skip_navigation_antialiasing(void)
+{
+  /* Mesa's v3d (Raspberry Pi 4): a full-screen pass costs 3-5 ms of a ~190 ms frame at 1322x762, and the
+   * viewport's SMAA and the overlays' smooth-wire resolve are about 35 ms each. The frames drawn while
+   * navigating go without them, as with Anti-Aliasing "None" and Smooth Wires off; the frame after the
+   * navigation is anti-aliased as before. */
+  static int is_v3d = -1;
+  if (is_v3d < 0) {
+    is_v3d = GPU_type_matches(GPU_DEVICE_UNKNOWN, GPU_OS_ANY, GPU_DRIVER_OPENSOURCE) &&
+             strstr(GPU_platform_renderer(), "V3D") != NULL;
+  }
+  return is_v3d && DRW_state_is_navigating();
+}
