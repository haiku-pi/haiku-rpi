CMake: import the build-time generators from a host build when cross compiling

Blender builds makesdna, makesrna, datatoc, datatoc_icon, smaa_areatex and msgfmt and runs them during
its own build. In a cross build they are target executables the build machine cannot run, and Blender
3.6 has no CMAKE_CROSSCOMPILING path. New: -DBLENDER_HOST_TOOLS=DIR imports each of them from DIR
(an IMPORTED GLOBAL executable) instead of building it. DIR holds the same generators built for the
build machine from the same source and WITH_* options (scripts/build-blender.sh builds them and
checks that the two configurations agree). The struct layouts makesdna computes on the host are
checked against the target compiler by dna_verify.c. docs/design/blender.md §4.2 (risk R12).

diff --git a/build_files/cmake/macros.cmake b/build_files/cmake/macros.cmake
index f7793bb..f5171c6 100644
--- a/build_files/cmake/macros.cmake
+++ b/build_files/cmake/macros.cmake
@@ -944,6 +944,20 @@ function(delayed_do_install
 endfunction()
 
 
+# Cross compiling: the build-time generators (makesdna, makesrna, datatoc, datatoc_icon,
+# smaa_areatex, msgfmt) are programs the build runs, so built for the target they cannot run on the
+# build machine. With BLENDER_HOST_TOOLS set to a directory that holds the same generators built for
+# the build machine (from the same sources and WITH_* options), each one is imported from there
+# instead of built. The DNA layout check (dna_verify.c, compiled for the target) still catches a
+# struct layout that differs between the two.
+function(blender_import_host_tool name)
+  if(NOT EXISTS ${BLENDER_HOST_TOOLS}/${name})
+    message(FATAL_ERROR "BLENDER_HOST_TOOLS: ${BLENDER_HOST_TOOLS}/${name} not found")
+  endif()
+  add_executable(${name} IMPORTED GLOBAL)
+  set_target_properties(${name} PROPERTIES IMPORTED_LOCATION ${BLENDER_HOST_TOOLS}/${name})
+endfunction()
+
 function(data_to_c
   file_from file_to
   list_to_add
diff --git a/extern/smaa_areatex/CMakeLists.txt b/extern/smaa_areatex/CMakeLists.txt
index f919228..1ab48ae 100644
--- a/extern/smaa_areatex/CMakeLists.txt
+++ b/extern/smaa_areatex/CMakeLists.txt
@@ -3,4 +3,8 @@
 # The Original Code is: all of this file.
 # Contributor(s): IRIE Shinsuke.
 
-add_executable(smaa_areatex smaa_areatex.cpp)
+if(BLENDER_HOST_TOOLS)
+  blender_import_host_tool(smaa_areatex)
+else()
+  add_executable(smaa_areatex smaa_areatex.cpp)
+endif()
