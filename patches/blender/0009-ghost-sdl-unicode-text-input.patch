+/** The length of the UTF-8 sequence at \a text (1 for an invalid lead byte). */
+static int utf8_sequence_length(const char *text)
+{
+  const unsigned char c = (unsigned char)text[0];
+  const int len = c < 0xc0 ? 1 : c < 0xe0 ? 2 : c < 0xf0 ? 3 : 4;
+  return std::min(len, (int)strlen(text)); /* A truncated sequence: what there is. */
+}
+
+/**
+ * The text of the #SDL_TEXTINPUT event that SDL queues right after the #SDL_KEYDOWN of a key that
+ * types (the UTF-8 the keyboard map gives, e.g. "ż" on a Polish layout): taken off the queue into
+ * \a utf8_buf (the key's first character). False when there is none (a key that types nothing).
+ */
+static bool take_key_text(char utf8_buf[6])
+{
+  SDL_Event next;
+  if (SDL_PeepEvents(&next, 1, SDL_PEEKEVENT, SDL_TEXTINPUT, SDL_TEXTINPUT) != 1) {
+    return false;
+  }
+  SDL_PeepEvents(&next, 1, SDL_GETEVENT, SDL_TEXTINPUT, SDL_TEXTINPUT);
+  const int len = utf8_sequence_length(next.text.text);
+  memcpy(utf8_buf, next.text.text, len);
+  utf8_buf[len] = '\0';
+  return true;
+}
