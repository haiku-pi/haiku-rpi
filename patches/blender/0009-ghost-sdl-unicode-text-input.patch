+    case SDL_TEXTINPUT: {
+      /* Text without a key event of its own (an input method, or more than one character for
+       * a key): one key press per character, with no key-code. */
+      SDL_TextInputEvent &sdl_sub_evt = sdl_event->text;
+      GHOST_WindowSDL *window = findGhostWindow(
+          SDL_GetWindowFromID_fallback(sdl_sub_evt.windowID));
+      if (window == nullptr) {
+        break;
+      }
+      const char *text = sdl_sub_evt.text;
+      while (*text != '\0') {
+        char utf8_buf[sizeof(GHOST_TEventKeyData::utf8_buf)] = {'\0'};
+        const int len = utf8_sequence_length(text);
+        memcpy(utf8_buf, text, len);
+        pushEvent(new GHOST_EventKey(
+            getMilliSeconds(), GHOST_kEventKeyDown, window, GHOST_kKeyUnknown, false, utf8_buf));
+        text += len;
+      }
+      break;
+    }
